<!-- Property Card Component -->
<article class="vp-property-card bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-lg transition-shadow group" x-data="{}">
  <!-- Image Carousel -->
  <div class="vp-property-card__gallery relative">
    <div class="vp-property-card__carousel swiper property-card-swiper-{{ property.sku }}" data-swiper-id="{{ property.sku }}">
      <div class="swiper-wrapper">
        {% if property.images and property.images.size > 0 %}
          {% assign remaining_photos = property.images.size | minus: 4 %}
          {% for image in property.images limit: 5 %}
          <div class="swiper-slide">
            {% if forloop.index == 5 and property.images.size > 5 %}
            <a href="{{ routes.property }}/{{ property.sku }}/{{ property.slug }}" class="vp-img-wrap block aspect-[16/9] overflow-hidden relative">
              <img
                src="{{ image.url | img_resize: 450, 260, true }}"
                alt="{{ property.title }}"
                class="w-full h-full object-cover blur-sm scale-105"
                width="450"
                height="260"
                loading="lazy"
                onload="this.closest('.vp-img-wrap').classList.add('vp-loaded')"
                onerror="this.closest('.vp-img-wrap').classList.add('vp-loaded');this.parentElement.innerHTML='<div class=\'aspect-[16/9] bg-gray-200 flex items-center justify-center\'><i class=\'ph ph-image text-4xl text-gray-400\'></i></div>'"
              >
              <div class="absolute inset-0 bg-black/50 flex items-center justify-center">
                <span class="text-white text-lg font-semibold">+{{ remaining_photos }} fotos</span>
              </div>
            </a>
            {% else %}
            <a href="{{ routes.property }}/{{ property.sku }}/{{ property.slug }}" class="vp-img-wrap block aspect-[16/9] overflow-hidden">
              <img
                src="{{ image.url | img_resize: 450, 260, true }}"
                alt="{{ property.title }}"
                class="w-full h-full object-cover"
                width="450"
                height="260"
                loading="lazy"
                decoding="async"
                onload="this.closest('.vp-img-wrap').classList.add('vp-loaded')"
                onerror="this.closest('.vp-img-wrap').classList.add('vp-loaded');this.parentElement.innerHTML='<div class=\'aspect-[16/9] bg-gray-200 flex items-center justify-center\'><i class=\'ph ph-image text-4xl text-gray-400\'></i></div>'"
              >
            </a>
            {% endif %}
          </div>
          {% endfor %}
        {% else %}
          <div class="swiper-slide">
            <div class="aspect-[16/9] bg-gray-200 flex items-center justify-center">
              <i class="ph ph-buildings text-5xl text-gray-400"></i>
            </div>
          </div>
        {% endif %}
      </div>

      <!-- Navigation Arrows -->
      {% if property.images and property.images.size > 1 %}
      <button type="button" class="swiper-button-prev-{{ property.sku }} absolute left-2 top-1/2 -translate-y-1/2 z-10 w-8 h-8 bg-white/80 hover:bg-white rounded-full flex items-center justify-center shadow-md lg:opacity-0 lg:group-hover:opacity-100 transition-opacity touch-manipulation" aria-label="Imagem anterior">
        <i class="ph ph-caret-left text-gray-700"></i>
      </button>
      <button type="button" class="swiper-button-next-{{ property.sku }} absolute right-2 top-1/2 -translate-y-1/2 z-10 w-8 h-8 bg-white/80 hover:bg-white rounded-full flex items-center justify-center shadow-md lg:opacity-0 lg:group-hover:opacity-100 transition-opacity touch-manipulation" aria-label="Proxima imagem">
        <i class="ph ph-caret-right text-gray-700"></i>
      </button>
      {% endif %}
    </div>

    <!-- Badges Top Left -->
    <div class="absolute top-3 left-3 flex flex-wrap items-center gap-2 z-10">
      <!-- SKU Badge -->
      <span class="bg-gray-900/80 text-white text-xs font-medium px-2.5 py-1 rounded">
        {{ property.sku }}
      </span>

    </div>

    <!-- Favorite Button -->
    <button
      type="button"
      class="absolute top-3 right-3 z-10 w-9 h-9 bg-white/90 hover:bg-white rounded-full flex items-center justify-center transition-all hover:scale-110 shadow-md favorite-btn"
      aria-label="Adicionar aos favoritos"
      data-property-sku="{{ property.sku }}"
      @click.prevent.stop="toggleFavorite($el)"
      x-data="{ sku: '{{ property.sku }}' }"
      :class="{ 'favorited': $store.favorites.is(sku) }"
    >
      <i class="text-xl transition-colors"
         :class="$store.favorites.is(sku) ? 'ph-fill ph-heart text-gray-500 hover:text-primary' : 'ph ph-heart text-gray-500 hover:text-primary'"
         :style="$store.favorites.is(sku) && 'color: #ef4444'"></i>
    </button>
  </div>

  <!-- Content -->
  <div class="p-5">
    <!-- Location -->
    <div class="flex items-center gap-1.5 text-sm text-gray-500 mb-2">
      <i class="ph ph-map-pin text-primary flex-shrink-0"></i>
      <span class="truncate">{{ property.neighborhood }}{% if property.city %}, {{ property.city }}{% endif %}{% if property.state %} - {{ property.state }}{% endif %}</span>
    </div>

    <!-- Title/Description -->
    <h3 class="text-gray-800 text-md leading-relaxed mb-3 line-clamp-2 min-h-[40px]">
      <a href="{{ routes.property }}/{{ property.sku }}/{{ property.slug }}" class="hover:text-primary transition-colors">
        {{ property.formatted_title | default: property.title }}
      </a>
    </h3>

    <!-- Price -->
    <div class="mb-4">
      {% assign _has_sale = false %}
      {% assign _has_rent = false %}
      {% if property.for_sale and property.sale_price %}{% assign _has_sale = true %}{% endif %}
      {% if property.for_rent and property.rental_price %}{% assign _has_rent = true %}{% endif %}
      {% assign _rent_primary = false %}
      {% if filters.operation == 'rent' or applied_filters.operation == 'rent' %}{% assign _rent_primary = true %}{% endif %}

      {% if _has_sale and _has_rent %}
        {% if _rent_primary %}
          {% if property.rental_price == 'on_request' or property.rental_price == 'negotiable' %}
          <p class="text-lg font-bold text-gray-900">Consulte-nos</p>
          {% else %}
          <p class="text-lg font-bold">{{ property.rental_price | money_format }}<span class="text-sm font-normal text-gray-500">/mês</span></p>
          {% endif %}
          {% if property.sale_price == 'on_request' or property.sale_price == 'negotiable' %}
          <p class="text-sm text-gray-600">Venda: Consulte-nos</p>
          {% else %}
          <p class="text-sm text-gray-600">Venda: {{ property.sale_price | money_format }}</p>
          {% endif %}
        {% else %}
          {% if property.sale_price == 'on_request' or property.sale_price == 'negotiable' %}
          <p class="text-lg font-bold text-gray-900">Consulte-nos</p>
          {% else %}
          <p class="text-lg font-bold">{{ property.sale_price | money_format }}</p>
          {% endif %}
          {% if property.rental_price == 'on_request' or property.rental_price == 'negotiable' %}
          <p class="text-sm text-gray-600">Aluguel: Consulte-nos</p>
          {% else %}
          <p class="text-sm text-gray-600">Aluguel: {{ property.rental_price | money_format }}<span class="text-sm font-normal text-gray-500">/mês</span></p>
          {% endif %}
        {% endif %}
      {% elsif _has_sale %}
        {% if property.sale_price == 'on_request' or property.sale_price == 'negotiable' %}
        <p class="text-lg font-bold text-gray-900">Consulte-nos</p>
        {% else %}
        <p class="text-lg font-bold">{{ property.sale_price | money_format }}</p>
        {% endif %}
      {% elsif _has_rent %}
        {% if property.rental_price == 'on_request' or property.rental_price == 'negotiable' %}
        <p class="text-lg font-bold text-gray-900">Consulte-nos</p>
        {% else %}
        <p class="text-lg font-bold">{{ property.rental_price | money_format }}<span class="text-sm font-normal text-gray-500">/mês</span></p>
        {% endif %}
      {% endif %}
    </div>

    <!-- Features -->
    {% assign area_value = property.total_area | default: property.usable_area %}
    {% if property.total_area and property.total_area > 0 %}
      {% assign area_value_max = property.total_area_max %}
    {% else %}
      {% assign area_value_max = property.usable_area_max %}
    {% endif %}
    {% assign has_features = false %}
    {% if area_value and area_value > 0 %}{% assign has_features = true %}{% endif %}
    {% if property.beds and property.beds > 0 %}{% assign has_features = true %}{% endif %}
    {% if property.parkings and property.parkings > 0 %}{% assign has_features = true %}{% endif %}

    {% if has_features %}
    <div class="flex items-center gap-4 pt-4 border-t border-gray-100 text-sm text-gray-600">
      {% if area_value and area_value > 0 %}
      <div class="flex items-center gap-1.5">
        <i class="ph ph-ruler text-primary"></i>
        <span>{{ area_value }}{% if area_value_max and area_value_max > area_value %} – {{ area_value_max }}{% endif %} m<sup>2</sup></span>
      </div>
      {% endif %}

      {% if property.beds and property.beds > 0 %}
      <div class="flex items-center gap-1.5">
        <i class="ph ph-bed text-primary"></i>
        {% if property.beds_max and property.beds_max > property.beds %}
        <span>{{ property.beds }} – {{ property.beds_max }} quartos</span>
        {% else %}
        <span>{{ property.beds }} {% if property.beds == 1 %}quarto{% else %}quartos{% endif %}</span>
        {% endif %}
      </div>
      {% endif %}

      {% if property.parkings and property.parkings > 0 %}
      <div class="flex items-center gap-1.5">
        <i class="ph ph-car text-primary"></i>
        {% if property.parkings_max and property.parkings_max > property.parkings %}
        <span>{{ property.parkings }} – {{ property.parkings_max }} vagas</span>
        {% else %}
        <span>{{ property.parkings }} {% if property.parkings == 1 %}vaga{% else %}vagas{% endif %}</span>
        {% endif %}
      </div>
      {% endif %}
    </div>
    {% endif %}
  </div>
</article>
