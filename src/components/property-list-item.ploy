<!-- Property List Item Component -->
<article class="vp-property-list-item bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-lg transition-shadow group flex flex-col sm:flex-row sm:max-h-[280px]">

  <!-- Image Carousel -->
  <div class="vp-property-list-item__gallery relative w-full sm:w-[280px] md:w-[320px] sm:h-auto flex-shrink-0">
    <div class="vp-property-list-item__carousel swiper property-card-swiper-{{ property.sku }} h-full" data-swiper-id="{{ property.sku }}">
      <div class="swiper-wrapper">
        {% if property.images and property.images.size > 0 %}
          {% assign remaining_photos = property.images.size | minus: 4 %}
          {% for image in property.images limit: 5 %}
          <div class="swiper-slide">
            {% if forloop.index == 5 and property.images.size > 5 %}
            <a href="{{ routes.property }}/{{ property.sku }}/{{ property.slug }}" class="vp-img-wrap block h-52 sm:h-full overflow-hidden relative">
              <img
                src="{{ image.url | img_resize: 640, 480, true }}"
                alt="{{ property.title }}"
                class="w-full h-full object-cover blur-sm scale-105"
                width="640"
                height="480"
                loading="lazy"
                onload="this.closest('.vp-img-wrap').classList.add('vp-loaded')"
                onerror="this.closest('.vp-img-wrap').classList.add('vp-loaded');this.parentElement.innerHTML='<div class=\'h-52 sm:h-full bg-gray-200 flex items-center justify-center\'><i class=\'ph ph-image text-4xl text-gray-400\'></i></div>'"
              >
              <div class="absolute inset-0 bg-black/50 flex items-center justify-center">
                <span class="text-white text-lg font-semibold">+{{ remaining_photos }} fotos</span>
              </div>
            </a>
            {% else %}
            <a href="{{ routes.property }}/{{ property.sku }}/{{ property.slug }}" class="vp-img-wrap block h-52 sm:h-full overflow-hidden">
              <img
                src="{{ image.url | img_resize: 640, 480, true }}"
                alt="{{ property.title }}"
                class="w-full h-full object-cover"
                width="640"
                height="480"
                {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
                onload="this.closest('.vp-img-wrap').classList.add('vp-loaded')"
                onerror="this.closest('.vp-img-wrap').classList.add('vp-loaded');this.parentElement.innerHTML='<div class=\'h-52 sm:h-full bg-gray-200 flex items-center justify-center\'><i class=\'ph ph-image text-4xl text-gray-400\'></i></div>'"
              >
            </a>
            {% endif %}
          </div>
          {% endfor %}
        {% else %}
          <div class="swiper-slide">
            <div class="h-52 sm:h-full bg-gray-200 flex items-center justify-center">
              <i class="ph ph-buildings text-5xl text-gray-400"></i>
            </div>
          </div>
        {% endif %}
      </div>

      <!-- Navigation Arrows -->
      {% if property.images and property.images.size > 1 %}
      <button type="button" class="swiper-button-prev-{{ property.sku }} absolute left-2 top-1/2 -translate-y-1/2 z-10 w-8 h-8 bg-white/80 hover:bg-white rounded-full flex items-center justify-center shadow-md opacity-0 group-hover:opacity-100 transition-opacity touch-manipulation" aria-label="Imagem anterior">
        <i class="ph ph-caret-left text-gray-700"></i>
      </button>
      <button type="button" class="swiper-button-next-{{ property.sku }} absolute right-2 top-1/2 -translate-y-1/2 z-10 w-8 h-8 bg-white/80 hover:bg-white rounded-full flex items-center justify-center shadow-md opacity-0 group-hover:opacity-100 transition-opacity touch-manipulation" aria-label="Proxima imagem">
        <i class="ph ph-caret-right text-gray-700"></i>
      </button>
      {% endif %}
    </div>

    <!-- Favorite Button -->
    <button
      type="button"
      class="absolute top-3 right-3 z-10 w-9 h-9 bg-white/90 hover:bg-white rounded-full flex items-center justify-center transition-all hover:scale-110 shadow-md favorite-btn"
      aria-label="Adicionar aos favoritos"
      data-property-sku="{{ property.sku }}"
      @click.prevent.stop="toggleFavorite($el)"
      x-data="{ sku: '{{ property.sku }}' }"
      :class="{ 'favorited': $store.favorites.is(sku) }"
    >
      <i class="text-xl transition-colors"
         :class="$store.favorites.is(sku) ? 'ph-fill ph-heart text-gray-500 hover:text-primary' : 'ph ph-heart text-gray-500 hover:text-primary'"
         :style="$store.favorites.is(sku) && 'color: #ef4444'"></i>
    </button>
  </div>

  <!-- Content -->
  <div class="flex-1 p-5 md:p-6 flex flex-col min-w-0">

    <!-- SKU -->
    <span class="text-xs font-medium text-gray-400 tracking-wide mb-1">{{ property.sku }}</span>

    <!-- Title -->
    <h3 class="text-gray-900 text-base md:text-lg font-semibold leading-snug line-clamp-2 mb-2">
      <a href="{{ routes.property }}/{{ property.sku }}/{{ property.slug }}" class="hover:text-primary transition-colors">
        {{ property.formatted_title | default: property.title }}
      </a>
    </h3>

    <!-- Location -->
    <div class="flex items-center gap-1.5 text-xs font-medium text-gray-500 uppercase tracking-wide mb-3">
      <i class="ph ph-map-pin text-primary flex-shrink-0"></i>
      <span class="truncate">{{ property.neighborhood }}{% if property.city %}, {{ property.city }}{% endif %}{% if property.state %} - {{ property.state }}{% endif %}</span>
    </div>

    <!-- Description -->
    {% if property.description != blank %}
    <p class="text-sm text-gray-500 line-clamp-2 mb-4 hidden md:block">{{ property.description | strip_html | truncate: 160 }}</p>
    {% endif %}

    <!-- Features -->
    {% assign _li_area = property.total_area | default: property.usable_area %}
    {% if property.total_area and property.total_area > 0 %}
      {% assign _li_area_max = property.total_area_max %}
    {% else %}
      {% assign _li_area_max = property.usable_area_max %}
    {% endif %}
    {% assign _li_has_features = false %}
    {% if _li_area and _li_area > 0 %}{% assign _li_has_features = true %}{% endif %}
    {% if property.beds and property.beds > 0 %}{% assign _li_has_features = true %}{% endif %}
    {% if property.parkings and property.parkings > 0 %}{% assign _li_has_features = true %}{% endif %}

    {% if _li_has_features %}
    <div class="flex items-center gap-4 text-sm text-gray-600 mb-4">
      {% if _li_area and _li_area > 0 %}
      <div class="flex items-center gap-1.5">
        <i class="ph ph-ruler text-gray-400"></i>
        <span>{{ _li_area }}{% if _li_area_max and _li_area_max > _li_area %} – {{ _li_area_max }}{% endif %} m<sup>2</sup></span>
      </div>
      {% endif %}
      {% if property.beds and property.beds > 0 %}
      <div class="flex items-center gap-1.5">
        <i class="ph ph-bed text-gray-400"></i>
        {% if property.beds_max and property.beds_max > property.beds %}
        <span>{{ property.beds }} – {{ property.beds_max }} quartos</span>
        {% else %}
        <span>{{ property.beds }} {% if property.beds == 1 %}quarto{% else %}quartos{% endif %}</span>
        {% endif %}
      </div>
      {% endif %}
      {% if property.parkings and property.parkings > 0 %}
      <div class="flex items-center gap-1.5">
        <i class="ph ph-car text-gray-400"></i>
        {% if property.parkings_max and property.parkings_max > property.parkings %}
        <span>{{ property.parkings }} – {{ property.parkings_max }} vagas</span>
        {% else %}
        <span>{{ property.parkings }} {% if property.parkings == 1 %}vaga{% else %}vagas{% endif %}</span>
        {% endif %}
      </div>
      {% endif %}
    </div>
    {% endif %}

    <!-- Footer: price + CTA -->
    <div class="mt-auto flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 pt-4 border-t border-gray-100">

      <!-- Price Block -->
      <div>
        {% assign _has_sale = false %}
        {% assign _has_rent = false %}
        {% if property.for_sale and property.sale_price %}{% assign _has_sale = true %}{% endif %}
        {% if property.for_rent and property.rental_price %}{% assign _has_rent = true %}{% endif %}
        {% assign _rent_primary = false %}
        {% if filters.operation == 'rent' or applied_filters.operation == 'rent' %}{% assign _rent_primary = true %}{% endif %}

        {% if _has_sale and _has_rent %}
          {% if _rent_primary %}
            {% if property.rental_price == 'on_request' or property.rental_price == 'negotiable' %}
            <p class="text-xl font-bold text-gray-900">Consulte-nos</p>
            {% else %}
            <p class="text-xl font-bold">{{ property.rental_price | money_format }}<span class="text-sm font-normal text-gray-500">/mês</span></p>
            {% endif %}
            {% unless property.sale_price == 'on_request' or property.sale_price == 'negotiable' %}<p class="text-sm text-gray-500">Venda: {{ property.sale_price | money_format }}</p>{% endunless %}
          {% else %}
            {% if property.sale_price == 'on_request' or property.sale_price == 'negotiable' %}
            <p class="text-xl font-bold text-gray-900">Consulte-nos</p>
            {% else %}
            <p class="text-xl font-bold">{{ property.sale_price | money_format }}</p>
            {% endif %}
            {% unless property.rental_price == 'on_request' or property.rental_price == 'negotiable' %}<p class="text-sm text-gray-500">Aluguel: {{ property.rental_price | money_format }}<span class="text-sm font-normal">/mês</span></p>{% endunless %}
          {% endif %}
        {% elsif _has_sale %}
          {% if property.sale_price == 'on_request' or property.sale_price == 'negotiable' %}
          <p class="text-xl font-bold text-gray-900">Consulte-nos</p>
          {% else %}
          <p class="text-xl font-bold">{{ property.sale_price | money_format }}</p>
          {% endif %}
        {% elsif _has_rent %}
          {% if property.rental_price == 'on_request' or property.rental_price == 'negotiable' %}
          <p class="text-xl font-bold text-gray-900">Consulte-nos</p>
          {% else %}
          <p class="text-xl font-bold">{{ property.rental_price | money_format }}<span class="text-sm font-normal text-gray-500">/mês</span></p>
          {% endif %}
        {% endif %}

        <!-- IPTU + Condomínio -->
        <div class="flex items-center gap-3 text-xs text-gray-400 mt-1 flex-wrap">
          {% if property.iptu and property.iptu > 0 %}
          <span>IPTU: {{ property.iptu | money_format }}</span>
          {% endif %}
          {% if property.condo_fee and property.condo_fee > 0 %}
          {% if property.iptu and property.iptu > 0 %}<span>&bull;</span>{% endif %}
          <span>Condomínio: {{ property.condo_fee | money_format }}</span>
          {% endif %}
        </div>
      </div>

      <!-- CTA -->
      <a
        href="{{ routes.property }}/{{ property.sku }}/{{ property.slug }}"
        class="inline-flex items-center gap-2 px-5 py-2.5 border rounded-xl text-sm font-semibold transition-colors whitespace-nowrap flex-shrink-0"
        style="border-color: rgb(var(--color-primary)); color: rgb(var(--color-primary));"
        onmouseover="this.style.background='rgb(var(--color-primary))';this.style.color='#fff'"
        onmouseout="this.style.background='';this.style.color='rgb(var(--color-primary))'"
      >
        Mais detalhes
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>

  </div>
</article>
