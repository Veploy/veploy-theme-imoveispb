{%- comment -%}
  Filtros da listagem da Passos & Buytendorp.

  Igual à coluna "vertical-filters" do original: caixa com borda #E7E0D2,
  "Buscar pelo código do imóvel" no topo, campos de 45px com borda #EDEDED,
  Quartos/Suítes/Vagas em linha com os botões 1-2-3-4+ à direita, a lista de
  características numa caixa com rolagem própria e o botão "Buscar" escuro.
  A operação (venda/locação) não aparece aqui: ela vem das abas da listagem e
  vai num campo oculto para a busca não trocar de aba.
{%- endcomment -%}
{%- assign _op = filters.operation | default: 'sale' -%}

<div class="pb-filters" x-data="{ searchByCode: {% if filters.code != blank %}true{% else %}false{% endif %} }">
  <label class="pb-check pb-filters__code-toggle">
    <input type="checkbox" x-model="searchByCode">
    <span class="pb-check__box" aria-hidden="true"></span>
    <span class="pb-check__label">{{ t.search.search_by_code }}</span>
  </label>

  {%- comment -%} Busca por código: formulário próprio, só leva o código {%- endcomment -%}
  <form x-show="searchByCode" {% if filters.code == blank %}style="display: none"{% endif %} method="GET" action="{{ locale_prefix }}{{ routes.properties | default: '/imoveis' }}">
    <div class="pb-filters__field">
      <label class="pb-filters__label" for="pb-filter-code">{{ t.search.property_code }}</label>
      <input id="pb-filter-code" type="text" name="code" value="{{ filters.code | escape }}" placeholder="{{ t.search.code_placeholder }}" class="pb-filters__input">
      <span class="pb-filters__hint">{{ t.search.code_hint }}</span>
    </div>
    <button type="submit" class="pb-filters__submit">{{ t.search.search }}</button>
  </form>

  <form class="vp-property-filters__form" x-show="!searchByCode" {% if filters.code != blank %}style="display: none"{% endif %} method="GET" action="{{ locale_prefix }}{{ routes.properties | default: '/imoveis' }}">
    <input type="hidden" name="operation" value="{{ _op }}">

    <div class="pb-filters__field">
      {% include 'components/global/form/filter/filter-location', init_selected: filters.location, resolved_locations: resolved_filters.locations %}
    </div>

    <div class="pb-filters__field">
      {% include 'components/global/form/filter/filter-property-type', init_selected: filters.type, close_on_select: true, placeholder: t.search.show_all %}
    </div>

    <div class="pb-filters__field">
      <span class="pb-filters__label">{{ t.search.price_label }}</span>
      <div class="grid grid-cols-2 gap-[15px]">
        {% include 'components/global/form/currency-input', name: 'price_min', value: filters.price_min, currency: 'BRL', placeholder: t.search.min %}
        {% include 'components/global/form/currency-input', name: 'price_max', value: filters.price_max, currency: 'BRL', placeholder: t.search.max %}
      </div>
    </div>

    <div class="pb-filters__field">
      <span class="pb-filters__label">{{ t.search.area_label }}</span>
      <div class="grid grid-cols-2 gap-[15px]">
        <input type="text" inputmode="numeric" name="area_min" value="{{ filters.area_min | escape }}" placeholder="{{ t.search.min }}" aria-label="{{ t.search.area_min }}" class="pb-filters__input">
        <input type="text" inputmode="numeric" name="area_max" value="{{ filters.area_max | escape }}" placeholder="{{ t.search.max }}" aria-label="{{ t.search.area_max }}" class="pb-filters__input">
      </div>
    </div>

    {%- comment -%} Quartos / Suítes / Vagas: rótulo à esquerda, 1-2-3-4+ à direita {%- endcomment -%}
    {%- assign _num_opts = '1,2,3,4' | split: ',' -%}
    {%- assign _num_keys = 'beds,suites,parking' | split: ',' -%}
    {%- for _key in _num_keys -%}
      {%- case _key -%}
        {%- when 'beds' -%}{%- assign _selected = filters.beds | split: ',' -%}{%- assign _num_label = t.search.bedrooms -%}
        {%- when 'suites' -%}{%- assign _selected = filters.suites | split: ',' -%}{%- assign _num_label = t.search.suites -%}
        {%- else -%}{%- assign _selected = filters.parking | split: ',' -%}{%- assign _num_label = t.search.parking -%}
      {%- endcase -%}
      <div class="pb-filters__num">
        <span class="pb-filters__label">{{ _num_label }}</span>
        <div class="pb-filters__num-opts">
          {%- for opt in _num_opts -%}
          <label>
            <input type="checkbox" name="{{ _key }}[]" value="{{ opt }}" class="sr-only"{% if _selected contains opt %} checked{% endif %}>
            <span>{% if opt == '4' %}4+{% else %}{{ opt }}{% endif %}</span>
          </label>
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}

    {% if amenities.size > 0 %}
      {%- if filters.amenities -%}
        {%- assign selected_amenities = filters.amenities | split: ',' -%}
      {%- else -%}
        {%- assign selected_amenities = '' | split: ',' -%}
      {%- endif -%}
      <div class="pb-filters__amenities">
        {% for amenity in amenities %}
        <label class="pb-check">
          <input type="checkbox" name="amenities[]" value="{{ amenity.slug }}"{% if selected_amenities contains amenity.slug %} checked{% endif %}>
          <span class="pb-check__box" aria-hidden="true"></span>
          <span class="pb-check__label">{{ amenity.name }}</span>
        </label>
        {% endfor %}
      </div>
    {% endif %}

    <button type="submit" class="pb-filters__submit">{{ t.search.search }}</button>
  </form>
</div>
