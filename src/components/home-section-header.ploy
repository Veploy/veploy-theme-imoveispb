{%- comment -%}
  Cabeçalho padrão das seções do site original: sobretítulo em caixa alta,
  título em Reckless Neue (com o trecho em destaque em `heading_highlight`) e,
  abaixo, uma linha fina que empurra o link "Ver mais imóveis" para a direita.

  Params:
    eyebrow, heading, heading_highlight, heading_after
    cta_text, cta_url
    align     'left' (padrão) | 'center'
    variant   'light' (padrão, sobre fundo claro) | 'dark' (sobre fundo escuro)
    italic    true para o título em itálico (seções "Nosso time" e "Destaque")
{%- endcomment -%}
{%- assign _align = align | default: 'left' -%}
{%- assign _dark = false -%}
{%- if variant == 'dark' -%}{%- assign _dark = true -%}{%- endif -%}

<div class="pb-section-header{% if _align == 'center' %} text-center{% endif %}">
  {%- if eyebrow != blank %}
  <span class="pb-eyebrow{% if _dark %} pb-eyebrow--light{% endif %} block mb-3">{{ eyebrow }}</span>
  {%- endif %}

  {%- if heading != blank or heading_highlight != blank %}
  <h2 class="pb-title{% if _dark %} pb-title--light{% endif %}{% if italic %} pb-title--italic{% endif %}{% if _align == 'center' %} mx-auto{% endif %}">
    {{- heading }}{% if heading_highlight != blank %} <span>{{ heading_highlight }}</span>{% endif %}{% if heading_after != blank %} {{ heading_after }}{% endif -%}
  </h2>
  {%- endif %}

  {%- if cta_text != blank %}
  <div class="flex items-center gap-6 mt-2">
    <span class="pb-divider{% if _dark %} pb-divider--light{% endif %}"></span>
    <a href="{{ cta_url }}" class="pb-link{% if _dark %} pb-link--light{% endif %}">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true"><path d="M313.941 216H12c-6.627 0-12 5.373-12 12v56c0 6.627 5.373 12 12 12h301.941v46.059c0 21.382 25.851 32.09 40.971 16.971l86.059-86.059c9.373-9.373 9.373-24.569 0-33.941l-86.059-86.059c-15.119-15.119-40.971-4.411-40.971 16.971V216z"/></svg>
      <span>{{ cta_text }}</span>
    </a>
  </div>
  {%- elsif show_divider %}
  <div class="flex items-center mt-2">
    <span class="pb-divider{% if _dark %} pb-divider--light{% endif %}"></span>
  </div>
  {%- endif %}
</div>
