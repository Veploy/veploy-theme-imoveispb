{% comment %}
  Filter: Location Search — minimal implementation
  Props:
    - init_selected: pre-selected value(s), comma-separated
    - resolved_locations: array of { value, label, type } for pre-selected locations
{% endcomment %}
{% assign location_label = 'search.location_or_development' | t %}
{% assign location_placeholder = 'search.location_placeholder' | t %}

<div
  class="location-filter relative"
  @click.outside="if (open) close()"
  x-data='locationFilter({
    searchApi: "/api/locations/search",
    placeholder: {{ location_placeholder | json | escape }},
    initSelected: {{ init_selected | default: '' | json | escape }},
    initLabels: {% if resolved_locations %}{{ resolved_locations | json | escape }}{% else %}[]{% endif %}
  })'
>
  {% if location_label != blank %}
  <label class="block text-base font-semibold text-gray-900 mb-2">{{ location_label }}</label>
  {% endif %}

  <!-- Hidden native select for form submission -->
  <select name="location[]" multiple class="sr-only" tabindex="-1" aria-hidden="true" x-ref="nativeSelect"></select>

  <!-- Input trigger -->
  <div class="relative" x-ref="wrapper">
    <!-- Selected display (when not editing) -->
    <div
      x-show="selectedItems.length > 0 && !editing"
      @click="onFocus()"
      class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-base cursor-pointer flex items-center gap-2 transition-colors hover:border-gray-300"
    >
      <span class="truncate text-gray-900 flex-1" x-text="selectedLabel"></span>
      <span
        x-show="extraCount > 0"
        class="flex-shrink-0 inline-flex items-center justify-center px-2 py-0.5 rounded-md bg-gray-100 text-xs font-medium text-gray-600"
        x-text="'+' + extraCount"
      ></span>
      <button
        @click.stop="clearSelection()"
        type="button"
        class="flex-shrink-0 text-gray-400 hover:text-gray-600"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Search input (when editing or nothing selected) -->
    <input
      x-show="selectedItems.length === 0 || editing"
      type="text"
      x-model="query"
      x-ref="input"
      :placeholder="placeholder"
      class="w-full border rounded-lg px-4 py-2.5 text-base focus:ring-2 transition-colors outline-none"
      :class="error ? 'border-red-400 focus:ring-red-200 focus:border-red-400' : 'border-gray-200 focus:ring-primary/20 focus:border-primary'"
      @focus="onFocus()"
      @keydown.escape="close()"
      autocomplete="off"
    >
  </div>

  <!-- Validation error -->
  <p x-show="error" x-text="error" class="absolute text-red-500 text-sm mt-1 left-0" x-cloak></p>

  <!-- Dropdown panel -->
  <div
    x-show="open"
    x-transition.opacity.duration.150ms
    @mousedown.prevent
    class="absolute z-50 mt-1.5 left-0 right-0 bg-white border border-gray-200 rounded-xl shadow-lg max-h-64 overflow-y-auto"
    x-cloak
  >
    <!-- Selected items (always visible) -->
    <template x-if="selectedItems.length > 0">
      <div>
        <div class="px-4 py-1.5 text-xs font-semibold text-gray-500 uppercase tracking-wider bg-gray-50">Selecionados</div>
        <template x-for="item in selectedItems" :key="'sel-' + item.value">
          <div
            @click="selectOption(item)"
            class="px-4 py-2.5 hover:bg-gray-50 cursor-pointer transition-colors flex items-center gap-3 bg-primary/5"
          >
            <span class="relative w-5 h-5 flex-shrink-0">
              <span class="absolute inset-0 rounded border-2 pointer-events-none bg-primary border-primary"></span>
              <span class="absolute inset-0 flex items-center justify-center pointer-events-none">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-3.5 h-3.5 text-white">
                  <path fill-rule="evenodd" d="M12.416 3.376a.75.75 0 01.208 1.04l-5 7.5a.75.75 0 01-1.154.114l-3-3a.75.75 0 011.06-1.06l2.353 2.353 4.493-6.74a.75.75 0 011.04-.207z" clip-rule="evenodd"/>
                </svg>
              </span>
            </span>
            <span class="text-[14px] text-gray-700" x-text="item.label"></span>
          </div>
        </template>
      </div>
    </template>

    <!-- Loading -->
    <div x-show="loading" class="px-4 py-4 text-center">
      <svg class="animate-spin h-5 w-5 text-primary mx-auto" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
      </svg>
    </div>

    <!-- Grouped Results (excluding already selected, hidden during loading) -->
    <template x-if="!loading">
    <div>
    <template x-for="(group, gi) in groupedResults" :key="gi">
      <div>
        <div class="px-4 py-1.5 text-xs font-semibold text-gray-500 uppercase tracking-wider bg-gray-50" x-text="group.label"></div>
        <template x-for="result in group.items" :key="result.value">
          <div
            @click="selectOption(result)"
            class="px-4 py-2.5 hover:bg-gray-50 cursor-pointer text-sm text-gray-700 transition-colors flex items-center gap-3"
            :class="isSelected(result.value) ? 'bg-primary/5' : ''"
          >
            <span class="relative w-5 h-5 flex-shrink-0">
              <span
                class="absolute inset-0 rounded border-2 pointer-events-none transition-colors"
                :class="isSelected(result.value) ? 'bg-primary border-primary' : 'border-gray-300 bg-white'"
              ></span>
              <span
                class="absolute inset-0 flex items-center justify-center pointer-events-none transition-all duration-200"
                :class="isSelected(result.value) ? 'opacity-100 scale-100' : 'opacity-0 scale-75'"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-3.5 h-3.5 text-white">
                  <path fill-rule="evenodd" d="M12.416 3.376a.75.75 0 01.208 1.04l-5 7.5a.75.75 0 01-1.154.114l-3-3a.75.75 0 011.06-1.06l2.353 2.353 4.493-6.74a.75.75 0 011.04-.207z" clip-rule="evenodd"/>
                </svg>
              </span>
            </span>
            <span class="text-[14px]" x-text="result.label"></span>
          </div>
        </template>
      </div>
    </template>
    </div>
    </template>

    <!-- No results -->
    <div x-show="!loading && query.length >= 2 && results.length === 0 && searched" class="px-4 py-6 text-center text-sm text-gray-500">
      Nenhum resultado encontrado
    </div>

    <!-- Recent searches (when no query and no results) -->
    <template x-if="!loading && query.length < 2 && results.length === 0 && recentSearches.length > 0">
      <div>
        <div class="px-4 py-1.5 text-xs font-semibold text-gray-500 uppercase tracking-wider bg-gray-50">Pesquisas recentes</div>
        <template x-for="(recent, ri) in recentSearches" :key="'recent-' + ri">
          <div
            @click="selectOption(recent)"
            class="px-4 py-2.5 hover:bg-gray-50 cursor-pointer transition-colors flex items-center gap-3"
            :class="isSelected(recent.value) ? 'bg-primary/5' : ''"
          >
            <i class="ph ph-clock-counter-clockwise text-gray-400 text-base flex-shrink-0"></i>
            <span class="text-[14px] text-gray-700" x-text="recent.label"></span>
          </div>
        </template>
      </div>
    </template>

    <!-- Prompt (no recents, no query) -->
    <div x-show="!loading && query.length < 2 && results.length === 0 && recentSearches.length === 0" class="px-4 py-6 text-center text-sm text-gray-400">
      Digite para buscar...
    </div>
  </div>
</div>
