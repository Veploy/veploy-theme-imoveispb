{%- comment -%}
  Botão flutuante do WhatsApp + cartão com o formulário.
  Incluído pelo layout/base.ploy quando o botão flutuante está ativo.

  Igual ao popup 24187 de produção (post-24187.css e post-34.css):
  - botão redondo #01BB00, a 30px da borda direita e de baixo;
  - cartão de 300px, fundo #F8F7F3, cantos de 10px e sombra sólida
    4px 4px #264D3D, aberto 110px acima do pé da tela e a 30px da direita;
  - título "Whatsapp" 20/600 em #264D3D, fechar (×) no canto;
  - só Nome e Celular, campos brancos com 10px entre eles, e o botão
    "Iniciar conversa" em #264D3D na largura toda.

  Depois do envio, abre o WhatsApp com a mensagem já preenchida.

  Variáveis esperadas:
    - _wa_phone: telefone só com dígitos
    - _is_property_page: boolean
    - property: imóvel (na página de imóvel)
{%- endcomment -%}

<style>
  .pb-wa { position: fixed; right: 30px; bottom: 30px; z-index: 999; }
  .pb-wa__fab {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #01BB00;
    color: #fff;
    box-shadow: 0 4px 12px rgba(0, 0, 0, .15);
    transition: transform .2s, background-color .2s;
  }
  .pb-wa__fab:hover { transform: scale(1.06); background: #00A800; }
  .pb-wa__fab svg { width: 32px; height: 32px; }

  /* O cartão fica 110px acima do pé da tela: 80px acima do botão, que já
     está a 30px do pé — mesma conta do `margin-bottom: 110px` do original */
  .pb-wa__card {
    position: absolute;
    right: 0;
    bottom: 80px;
    width: 300px;
    max-width: calc(100vw - 40px);
    padding: 20px;
    background: #F8F7F3;
    border-radius: 10px;
    box-shadow: 4px 4px 0 0 #264D3D;
  }
  .pb-wa__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 15px; }
  .pb-wa__title {
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.2;
    color: #264D3D;
  }
  .pb-wa__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    margin-right: -4px;
    color: #000;
  }
  .pb-wa__close svg { width: 16px; height: 16px; }
  .pb-wa__form { display: flex; flex-direction: column; gap: 10px; }
  .pb-wa__field {
    width: 100%;
    height: 40px;
    padding: 0 14px;
    background: #fff;
    border: 1px solid transparent;
    border-radius: 6px;
    font-family: var(--font-body);
    font-size: 15px;
    color: #181A20;
    outline: none;
    transition: border-color .15s;
  }
  .pb-wa__field::placeholder { color: #A3A3A3; opacity: 1; }
  .pb-wa__field:focus { border-color: #264D3D; }
  .pb-wa__submit {
    width: 100%;
    height: 40px;
    background: #264D3D;
    border-radius: 3px;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    color: #fff;
    transition: background-color .2s;
  }
  .pb-wa__submit:hover { background: #1D3C2F; }

  /* Celular: um pouco mais perto da borda, para o cartão de 300px caber */
  @media (max-width: 767px) {
    .pb-wa { right: 20px; bottom: 20px; }
    .pb-wa__fab { width: 54px; height: 54px; }
    .pb-wa__fab svg { width: 29px; height: 29px; }
    .pb-wa__card { bottom: 70px; }
  }
</style>

<div
  class="pb-wa{% if _is_property_page %} hidden lg:block{% endif %}"
  data-wa-float
  x-data="{ open: false }"
  @click.outside="open = false"
  @keydown.escape.window="open = false"
>
  <div
    class="pb-wa__card"
    x-show="open"
    x-cloak
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 translate-y-2"
    role="dialog"
    aria-label="Whatsapp"
  >
    <div class="pb-wa__head">
      <h3 class="pb-wa__title">Whatsapp</h3>
      <button type="button" class="pb-wa__close" @click="open = false" aria-label="Fechar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>

    {%- if _is_property_page %}
    {% form 'property_interest', name: 'Interesse em imóvel' %}
      <input type="hidden" name="property_interest[property_id]" value="{{ property.id }}">
      <input type="hidden" name="property_interest[property_sku]" value="{{ property.sku }}">
      <input type="hidden" name="property_interest[property_type]" value="{{ property.type }}">
      <input type="hidden" name="property_interest[contact_type]" value="whatsapp">
      <div class="pb-wa__form">
        <input type="text" name="property_interest[name]" required placeholder="Nome" aria-label="Nome" class="pb-wa__field">
        {% include 'components/global/form/phone-input', name: 'property_interest[phone]', placeholder: 'Celular', input_class: 'pb-wa__field', id: 'pb-wa-phone' %}
        <button type="submit" class="pb-wa__submit">Iniciar conversa</button>
      </div>
    {% endform %}
    {%- else %}
    {% form 'contact', name: 'Botão do Whatsapp' %}
      <input type="hidden" name="contact[contact_type]" value="whatsapp">
      <div class="pb-wa__form">
        <input type="text" name="contact[name]" required placeholder="Nome" aria-label="Nome" class="pb-wa__field">
        {% include 'components/global/form/phone-input', name: 'contact[phone]', placeholder: 'Celular', input_class: 'pb-wa__field', id: 'pb-wa-phone' %}
        <button type="submit" class="pb-wa__submit">Iniciar conversa</button>
      </div>
    {% endform %}
    {%- endif %}
  </div>

  <button
    type="button"
    class="pb-wa__fab"
    @click="open = !open"
    aria-label="Contato WhatsApp"
    :aria-expanded="open"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
  </button>
</div>

{%- comment -%} Depois do envio, abre o WhatsApp com a mensagem já preenchida {%- endcomment -%}
<script>
(function() {
  var waPhone = '{{ _wa_phone }}';
  if (!waPhone) return;

  function buildWaUrl(name) {
    var text = 'Olá! Meu nome é ' + (name || '') + '. Gostaria de mais informações.';
    {% if _is_property_page %}
    text = 'Olá! Meu nome é ' + (name || '') + '. Tenho interesse no imóvel {{ property.title | escape }} ({{ property.sku }}).';
    {% endif %}
    return 'https://wa.me/' + waPhone + '?text=' + encodeURIComponent(text);
  }

  document.addEventListener('DOMContentLoaded', function() {
    /* Procura pelo atributo, não pelas classes: o seletor antigo
       (.fixed.bottom-6.right-6) não batia com o container e o WhatsApp
       nunca abria depois do envio. */
    var floatEl = document.querySelector('[data-wa-float]');
    if (!floatEl) return;
    var form = floatEl.querySelector('form[data-ajax]');
    if (!form) return;

    var pendingName = '';
    form.addEventListener('submit', function() {
      var nameInput = form.querySelector('[name$="[name]"]');
      pendingName = nameInput ? nameInput.value : '';
    }, true);

    form.addEventListener('form:success', function() {
      window.open(buildWaUrl(pendingName), '_blank');
    });
  });
})();
</script>
