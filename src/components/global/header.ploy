{%- comment -%}
  Header do Elegance.
  `overlay: true` (home, via base.ploy): fica absoluto sobre o hero, com fundo em
  degradê preto → transparente e a barra de anúncio no topo — igual ao site original.
  Sem overlay (páginas internas): fundo sólido em header.bg_color.
{%- endcomment -%}
{% assign header_overlay = overlay | default: false %}
{% assign header_bg = workspace.theme_settings.header.bg_color | default: '#000000' %}
{% assign header_text = workspace.theme_settings.header.text_color | default: '#FFFFFF' %}
{% assign header_btn_bg = workspace.theme_settings.header.button_bg_color | default: '#FFEBCD' %}
{% assign header_btn_text = workspace.theme_settings.header.button_text_color | default: '#161616' %}
{% assign header_btn_hover = workspace.theme_settings.header.button_hover_bg_color | default: '#E7C48F' %}
{% assign header_sticky = false %}{%- comment -%}{% assign header_sticky = workspace.theme_settings.features.header_sticky %}{%- endcomment -%}

{%- assign _hero = workspace.theme_settings.sections['home/hero-carousel'] -%}
{%- assign announcement_text = _hero.announcement_text -%}
{%- assign announcement_url = _hero.announcement_url -%}
{%- assign announcement_bg = _hero.announcement_bg_color | default: header_btn_bg -%}
{%- assign announcement_color = _hero.announcement_text_color | default: '#000000' -%}

<style>
  .vp-header__menu-link {
    position: relative;
    font-family: var(--font-header, var(--font-body));
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 13px 0;
  }
  .vp-header__menu-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 6px;
    height: 1px;
    background-color: {{ header_btn_bg }};
    transform: scaleX(0);
    transition: transform .3s;
  }
  .vp-header__menu-link:hover::after { transform: scaleX(1); }
  .header-cta,
  .header-cta-outline {
    font-family: var(--font-header, var(--font-body));
    font-size: 13px;
    font-weight: 500;
    line-height: 18px;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 10px 15px;
    border: 1px solid {{ header_btn_bg }};
    border-radius: 0;
    transition: background-color .2s, color .2s;
  }
  .header-cta {
    background-color: {{ header_btn_bg }};
    color: {{ header_btn_text }};
  }
  .header-cta:hover { background-color: {{ header_btn_hover }}; }
  .header-cta-outline {
    background-color: transparent;
    color: {{ header_text }};
  }
  .header-cta-outline:hover { background-color: {{ header_btn_bg }}; color: {{ header_btn_text }}; }
  .vp-announcement {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: 1px;
  }
  @media (max-width: 1366px) {
    .vp-header__menu-link { font-size: 12px; }
    .header-cta, .header-cta-outline { font-size: 11px; padding: 10px; }
  }
</style>

<header
  class="vp-header z-50{% if header_overlay %} vp-header--overlay absolute top-0 left-0 right-0{% endif %}{% if header_sticky %} sticky top-0{% endif %}"
  style="{% if header_overlay %}background-image: linear-gradient(180deg, #000000 0%, #00000000 100%);{% else %}background-color: {{ header_bg }};{% endif %}"
>
  {%- if header_overlay and announcement_text != blank -%}
  <!-- Barra de anúncio -->
  <div class="vp-announcement w-full px-[5%] py-[5px] text-center" style="background-color: {{ announcement_bg }}; color: {{ announcement_color }};">
    {%- if announcement_url != blank -%}
      <a href="{{ announcement_url }}" class="hover:underline">{{ announcement_text }}</a>
    {%- else -%}
      {{ announcement_text }}
    {%- endif -%}
  </div>
  {%- endif -%}

  <nav class="vp-header__nav mx-auto px-[5%]" x-data="{ mobileOpen: false }">
    <div class="vp-header__content mx-auto max-w-[1300px] flex items-center justify-between min-h-[72px] py-2">
      <div class="vp-header__left flex items-center gap-10">
        <!-- Logo -->
        <a href="{{ locale_prefix }}/" class="vp-header__logo flex-shrink-0 block">
          {%- assign _logo = workspace.theme_settings.brand_identity.logo -%}
          {%- if header_overlay and workspace.theme_settings.brand_identity.logo_negative != blank -%}
            {%- assign _logo = workspace.theme_settings.brand_identity.logo_negative -%}
          {%- endif -%}
          {% if _logo %}
            <img
              src="{{ _logo }}"
              alt="{{ workspace.name }}"
              class="h-auto w-[125px] max-w-[125px] object-contain"
              width="125"
              height="43"
            >
          {% else %}
            <span class="text-2xl font-bold" style="color: {{ header_text }};">{{ workspace.name }}</span>
          {% endif %}
        </a>

        <!-- Desktop Navigation (theme_settings.navigation.main_menu — URLs já chegam resolvidas pelo engine) -->
        {% assign nav_items = workspace.theme_settings.navigation.main_menu %}
        {% if nav_items and nav_items.size > 0 %}
        <ul class="vp-header__menu hidden lg:flex items-center gap-10">
          {% for item in nav_items %}
          <li>
            {% assign resolved_url = item.url | replace: '{{routes.properties}}', routes.properties | replace: '{{routes.operation_sale}}', routes.operation_sale | replace: '{{routes.operation_rent}}', routes.operation_rent | replace: '{{routes.blog}}', routes.blog | replace: '{{routes.contact}}', routes.contact | replace: '{{routes.about}}', routes['about-us'] | replace: '{{routes.advertise}}', routes.advertise | replace: '{{routes.favorites}}', routes.favorites %}
            {% assign is_absolute = false %}
            {% if resolved_url contains 'http://' or resolved_url contains 'https://' %}
              {% assign is_absolute = true %}
            {% endif %}
            <a
              href="{% if is_absolute %}{{ resolved_url }}{% else %}{{ locale_prefix }}{{ resolved_url }}{% endif %}"
              class="vp-header__menu-link" style="color: {{ header_text }};"
              {% if item.target == '_blank' %}target="_blank" rel="noopener noreferrer"{% endif %}
            >
              {{ item.label }}
            </a>
          </li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>

      <!-- Desktop Actions -->
      <div class="vp-header__actions hidden lg:flex items-center gap-5">
        <a href="{{ locale_prefix }}{{ routes.contact }}" class="header-cta-outline">Fale Conosco</a>
        <a href="{{ locale_prefix }}{{ routes.advertise }}" class="header-cta">{{ t.nav.advertise }}</a>
      </div>

      <!-- Mobile Actions: Heart + Hamburger -->
      <div class="lg:hidden flex items-center gap-1">
        <a
          href="{{ locale_prefix }}{{ routes.favorites }}"
          class="p-2 transition-colors relative" style="color: {{ header_text }};"
          aria-label="{{ t.nav.favorites }}"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            :fill="$store.favorites.count > 0 ? '#ef4444' : 'none'"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            :stroke="$store.favorites.count > 0 ? '#ef4444' : 'currentColor'"
            class="w-6 h-6 transition-colors"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
          </svg>
          <span
            x-show="$store.favorites.count > 0"
            x-text="$store.favorites.count"
            class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] flex items-center justify-center rounded-full bg-red-500 text-white text-[10px] font-bold px-1 leading-none"
            x-cloak
          ></span>
        </a>
        <button
          type="button"
          class="vp-header__mobile-toggle p-2" style="color: {{ header_text }};"
          aria-label="Menu"
          @click="mobileOpen = !mobileOpen"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>
      </div>
    </div>


    <!-- Mobile Drawer Backdrop -->
    <div
      class="lg:hidden fixed inset-0 bg-black/40 z-[998]"
      x-cloak
      x-show="mobileOpen"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      @click="mobileOpen = false"
    ></div>

    <!-- Mobile Drawer (slide-in from right) -->
    <div
      class="lg:hidden fixed inset-y-0 right-0 w-[85vw] max-w-[360px] z-[999] shadow-2xl flex flex-col"
      style="background-color: {{ header_bg }}; color: {{ header_text }};"
      x-cloak
      x-show="mobileOpen"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="translate-x-full"
      x-transition:enter-end="translate-x-0"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="translate-x-0"
      x-transition:leave-end="translate-x-full"
      @keydown.escape.window="mobileOpen = false"
    >
      <!-- Drawer Header -->
      <div class="flex items-center justify-between px-5 py-4 flex-shrink-0" style="border-bottom: 1px solid {{ header_text }}15;">
        <a href="{{ locale_prefix }}/" class="block h-8">
          {% if workspace.theme_settings.brand_identity.logo %}
            <img src="{{ workspace.theme_settings.brand_identity.logo }}" alt="{{ workspace.name }}" class="h-full w-auto object-contain" width="120" height="32">
          {% else %}
            <span class="text-lg font-bold" style="color: {{ header_text }};">{{ workspace.name }}</span>
          {% endif %}
        </a>
        <button @click="mobileOpen = false" class="w-9 h-9 flex items-center justify-center rounded-full transition-colors" style="color: {{ header_text }};" aria-label="Fechar menu">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Drawer Body (scrollable) -->
      <div class="flex-1 overflow-y-auto">

        <!-- Navigation Links -->
        <nav class="py-2">
          {% assign mobile_items = workspace.theme_settings.navigation.mobile_menu | default: nav_items %}
          {% for item in mobile_items %}
            {% assign resolved_url = item.url | replace: '{{routes.properties}}', routes.properties | replace: '{{routes.operation_sale}}', routes.operation_sale | replace: '{{routes.operation_rent}}', routes.operation_rent | replace: '{{routes.blog}}', routes.blog | replace: '{{routes.contact}}', routes.contact | replace: '{{routes.about}}', routes['about-us'] | replace: '{{routes.advertise}}', routes.advertise | replace: '{{routes.favorites}}', routes.favorites %}
            {% assign is_absolute = false %}
            {% if resolved_url contains 'http://' or resolved_url contains 'https://' %}
              {% assign is_absolute = true %}
            {% endif %}
            <a
              href="{% if is_absolute %}{{ resolved_url }}{% else %}{{ locale_prefix }}{{ resolved_url }}{% endif %}"
              class="flex items-center justify-between px-5 py-3.5 transition-colors"
              style="color: {{ header_text }};"
              {% if item.target == '_blank' or is_absolute %}target="_blank" rel="noopener noreferrer"{% endif %}
            >
              <span class="text-base font-medium">{{ item.label }}</span>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 opacity-40">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </a>
          {% endfor %}
        </nav>

        <!-- Favorites -->
        <div style="border-top: 1px solid {{ header_text }}15;">
          <a
            href="{{ locale_prefix }}{{ routes.favorites }}"
            class="flex items-center justify-between px-5 py-3.5 transition-colors"
            style="color: {{ header_text }};"
          >
            <div class="flex items-center gap-3">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                :fill="$store.favorites.count > 0 ? '#ef4444' : 'none'"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                :stroke="$store.favorites.count > 0 ? '#ef4444' : 'currentColor'"
                class="w-5 h-5 transition-colors"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
              </svg>
              <span class="text-base font-medium">{{ t.nav.favorites }}</span>
            </div>
            <span
              x-show="$store.favorites.count > 0"
              x-text="$store.favorites.count"
              class="min-w-[22px] h-[22px] flex items-center justify-center rounded-full bg-red-500 text-white text-xs font-bold px-1.5"
              x-cloak
            ></span>
          </a>
        </div>

        <!-- CTA -->
        <div class="px-5 py-4" style="border-top: 1px solid {{ header_text }}15;">
          <a
            href="{{ locale_prefix }}{{ routes.advertise }}"
            class="header-cta flex items-center justify-center gap-2 w-full px-6 py-3 rounded-xl font-semibold text-sm transition-colors"
          >
            {{ t.nav.advertise }}
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>
