{% assign footer_bg = workspace.theme_settings.footer.bg_color | default: '#000000' %}
{% assign footer_text = workspace.theme_settings.footer.text_color | default: '#FFFFFF' %}

{%- assign _footer_bg_hex = footer_bg -%}
{%- if footer_bg == 'white' -%}{%- assign _footer_bg_hex = '#ffffff' -%}
{%- elsif footer_bg == 'black' -%}{%- assign _footer_bg_hex = '#000000' -%}
{%- elsif footer_bg == 'grey' or footer_bg == 'gray' -%}{%- assign _footer_bg_hex = '#808080' -%}
{%- endif -%}
{%- assign _footer_rgb = _footer_bg_hex | hex_to_rgb | split: ' ' -%}
{%- assign _footer_r = _footer_rgb[0] | plus: 0 | times: 299 -%}
{%- assign _footer_g = _footer_rgb[1] | plus: 0 | times: 587 -%}
{%- assign _footer_b = _footer_rgb[2] | plus: 0 | times: 114 -%}
{%- assign _footer_yiq = _footer_r | plus: _footer_g | plus: _footer_b | divided_by: 1000 -%}
{%- comment -%} Arquivos de src/assets são servidos pelo endereço de assets do tema (CDN), não pela raiz do site {%- endcomment -%}
{%- assign _cdn = theme.assets_url | default: '' -%}
{%- if _footer_yiq < 128 -%}
  {%- assign veploy_credits_logo = _cdn | append: '/assets/images/logo-veploy-branca.png' -%}
  {%- assign _footer_line = '#373737' -%}
{%- else -%}
  {%- assign veploy_credits_logo = _cdn | append: '/assets/images/logo-veploy.png' -%}
  {%- assign _footer_line = '#DDDDDD' -%}
{%- endif -%}

{%- assign _logo = theme_settings.brand_identity.logo_negative | default: theme_settings.brand_identity.logo -%}
{%- if _footer_yiq >= 128 -%}{%- assign _logo = theme_settings.brand_identity.logo -%}{%- endif -%}
{%- assign footer_links_types = theme_settings.footer.types_list | default: empty -%}
{%- assign footer_links_neighborhoods = theme_settings.footer.neighborhoods_list | default: empty -%}
{%- assign _cnpj = theme_settings.contact.cnpj | default: workspace.cnpj -%}
{%- assign _creci = theme_settings.contact.creci | remove: 'CRECI:' | strip -%}

<style>
  .vp-footer__title {
    font-family: var(--font-heading);
    font-size: 17px;
    font-weight: 600;
    line-height: 18px;
  }
  .vp-footer__list,
  .vp-footer__text {
    font-family: 'Nunito', var(--font-body), sans-serif;
    font-size: 15px;
    font-weight: 400;
  }
  .vp-footer__list a:hover,
  .vp-footer__text a:hover { opacity: .75; }
</style>

<footer class="vp-footer px-[5%]" style="background-color: {{ footer_bg }}; color: {{ footer_text }};">
  <div class="max-w-[1300px] mx-auto">
    <!-- Topo: logo + redes -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-5 py-5 border-b" style="border-color: {{ _footer_line }};">
      <a href="{{ locale_prefix }}/" class="block">
        {% if _logo %}
          <img src="{{ _logo }}" alt="{{ workspace.name }}" class="w-[125px] h-auto object-contain" width="125" height="43" loading="lazy">
        {% else %}
          <span class="text-2xl font-bold">{{ workspace.name }}</span>
        {% endif %}
      </a>

      {% if theme_settings.features.footer_show_social != false %}
      <div class="flex items-center gap-7">
        <h2 class="font-serif text-[20px] font-semibold leading-[22px]" style="color: {{ footer_text }};">Acompanhe nossas redes</h2>
        <div class="flex items-center gap-4 text-[22px]">
          {% if theme_settings.contact.instagram != blank %}
          <a href="{{ theme_settings.contact.instagram }}" target="_blank" rel="noopener" class="hover:opacity-75 transition-opacity" aria-label="Instagram"><i class="ph ph-instagram-logo"></i></a>
          {% endif %}
          {% if theme_settings.contact.facebook != blank %}
          <a href="{{ theme_settings.contact.facebook }}" target="_blank" rel="noopener" class="hover:opacity-75 transition-opacity" aria-label="Facebook"><i class="ph-fill ph-facebook-logo"></i></a>
          {% endif %}
          {% if theme_settings.contact.linkedin != blank %}
          <a href="{{ theme_settings.contact.linkedin }}" target="_blank" rel="noopener" class="hover:opacity-75 transition-opacity" aria-label="LinkedIn"><i class="ph-fill ph-linkedin-logo"></i></a>
          {% endif %}
          {% if theme_settings.contact.youtube != blank %}
          <a href="{{ theme_settings.contact.youtube }}" target="_blank" rel="noopener" class="hover:opacity-75 transition-opacity" aria-label="YouTube"><i class="ph-fill ph-youtube-logo"></i></a>
          {% endif %}
        </div>
      </div>
      {% endif %}
    </div>

    <!-- Colunas -->
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-10 py-[45px]">
      <div>
        <h4 class="vp-footer__title mb-5" style="color: {{ footer_text }};">Institucional</h4>
        <ul class="vp-footer__list space-y-2">
          <li><a href="{{ locale_prefix }}/">Home</a></li>
          <li><a href="{{ locale_prefix }}{{ routes['about-us'] }}">Sobre nós</a></li>
          <li><a href="{{ locale_prefix }}{{ routes.privacy-policy }}">Política de Privacidade</a></li>
          <li><a href="{{ locale_prefix }}{{ routes.careers }}">Trabalhe conosco</a></li>
          <li><a href="{{ locale_prefix }}{{ routes.advertise }}">Anuncie seu imóvel</a></li>
        </ul>
      </div>

      <div>
        <h4 class="vp-footer__title mb-5" style="color: {{ footer_text }};">Tipos de imóveis</h4>
        <ul class="vp-footer__list space-y-2">
          {% if footer_links_types != empty and footer_links_types.size > 0 %}
            {% for item in footer_links_types %}
              <li><a href="{{ item.url }}">{{ item.label }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="{{ locale_prefix }}{{ routes.properties }}{{ routes.operation_sale }}/tipo/casa">Casas à venda</a></li>
            <li><a href="{{ locale_prefix }}{{ routes.properties }}{{ routes.operation_sale }}/tipo/apartamento">Apartamentos à venda</a></li>
            <li><a href="{{ locale_prefix }}{{ routes.properties }}{{ routes.operation_sale }}/comercial">Imóveis comerciais à venda</a></li>
          {% endif %}
        </ul>
      </div>

      <div>
        <h4 class="vp-footer__title mb-5" style="color: {{ footer_text }};">Imóveis por bairro</h4>
        <ul class="vp-footer__list space-y-2">
          {% for item in footer_links_neighborhoods %}
            <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div class="vp-footer__text">
        <h4 class="vp-footer__title mb-1" style="color: {{ footer_text }};">Fale conosco</h4>
        {% if theme_settings.contact.phone != blank %}
        <p class="mb-5"><a href="tel:{{ theme_settings.contact.phone | remove: '-' | remove: '(' | remove: ')' | remove: ' ' }}">{{ theme_settings.contact.phone }}</a></p>
        {% endif %}

        {% if theme_settings.contact.email != blank %}
        <h4 class="vp-footer__title mb-1" style="color: {{ footer_text }};">Nos envie uma mensagem</h4>
        <p class="mb-5 break-all"><a href="mailto:{{ theme_settings.contact.email }}">{{ theme_settings.contact.email }}</a></p>
        {% endif %}

        {% if theme_settings.contact.address != blank %}
        <h4 class="vp-footer__title mb-1" style="color: {{ footer_text }};">Conheça nosso espaço</h4>
        <p>{{ theme_settings.contact.address }}</p>
        {% endif %}
      </div>
    </div>

    <!-- Rodapé legal: CNPJ | CRECI | Copyright | Desenvolvido por Veploy -->
    <div class="border-t py-[10px]" style="border-color: {{ _footer_line }};">
      <div class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-center text-[14px] leading-[20px]" style="color: {{ footer_text }};">
        {% if _cnpj != blank %}
        <span>{{ _cnpj }}</span>
        <span class="h-[20px] border-l" style="border-color: #DDDDDD;"></span>
        {% endif %}
        {% if _creci != blank %}
        <span>CRECI: {{ _creci }}</span>
        <span>|</span>
        {% endif %}
        <span>Copyright {{ 'now' | date: '%Y' }} – Todos os Direitos Reservados</span>
        <span>|</span>
        {%- assign _footer_host = canonical_url | split: '/' -%}
        <span class="inline-flex items-center gap-1.5">
          Desenvolvido por
          <a href="https://veploy.com?utm_source={{ _footer_host[2] | url_encode }}&utm_medium=referral&utm_campaign=footer_badge" target="_blank" rel="noopener" class="inline-flex items-center hover:opacity-80 transition-opacity">
            <img src="{{ veploy_credits_logo }}" alt="Veploy" class="w-[70px] h-auto" width="70" height="18" loading="lazy">
          </a>
        </span>
      </div>
    </div>
  </div>
</footer>
