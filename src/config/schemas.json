        {
          "type": "select",
          "id": "autofill_source",
          "label": "Auto-fill source",
          "default": "recent",
          "options": [
            {
              "value": "recent",
              "label": "Most recent"
            },
            {
              "value": "random",
              "label": "Random"
            },
            {
              "value": "price_above",
              "label": "Price above"
            },
            {
              "value": "price_below",
              "label": "Price below"
            }
          ]
        },
        {
          "type": "number",
          "id": "price_threshold",
          "label": "Price threshold"
        }
      ],
      "location": "home"
    },
    "hero-carousel": {
      "name": "Hero Carousel",
      "settings": [
        {
          "type": "repeater",
          "id": "slides",
          "label": "Slides",
          "max_items": 4,
          "settings": [
            {
              "type": "image_picker",
              "id": "image_desktop",
              "label": "Desktop Image"
            },
            {
              "type": "image_picker",
              "id": "image_mobile",
              "label": "Mobile Image"
            },
            {
              "type": "url",
              "id": "redirect_url",
              "label": "Redirect URL"
            }
