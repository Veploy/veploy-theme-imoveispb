            {
              "type": "image_picker",
              "id": "image_desktop",
              "label": "Desktop Image"
            },
            {
              "type": "image_picker",
              "id": "image_mobile",
              "label": "Mobile Image"
            },
            {
              "type": "url",
              "id": "redirect_url",
              "label": "Redirect URL"
            }
          ]
        }
      ],
      "location": "home"
    },
    "differentials": {
      "name": "Differentials",
