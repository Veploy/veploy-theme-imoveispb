        {
          "type": "text",
          "id": "title",
          "label": "Section Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Section Description"
        },
        {
          "type": "repeater",
          "id": "differentials",
          "label": "Differentials",
          "max_items": 8,
          "settings": [
            {
              "type": "text",
              "id": "icon_path",
              "label": "SVG Icon Path"
            },
            {
              "type": "text",
              "id": "title",
              "label": "Title"
            },
            {
              "type": "textarea",
              "id": "description",
              "label": "Description"
            }
          ]
        }
      ],
      "location": "home"
    },
