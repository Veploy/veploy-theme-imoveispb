<!-- Blog Section -->
<section class="vp-section vp-blog pt-8 pb-16 bg-white">
  <div class="vp-section__container max-w-screen-2xl mx-auto px-[3%]">
    <!-- Section Header -->
    <div class="vp-section__header text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        {{ 'home.blog_title' | t }}
      </h2>
      <p class="text-gray-500 text-lg">
        {{ 'home.blog_description' | t }}
      </p>
    </div>

    <!-- Articles Grid -->
    <div class="vp-articles-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {% for article in articles limit: 3 %}
      <article class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-lg transition-shadow group">
        <!-- Image -->
        <a href="{{ locale_prefix }}{{ routes.blog }}/{{ article.slug }}" class="block relative overflow-hidden">
          <div class="aspect-[4/3]">
            <img
              src="{{ article.featured_image | default: 'https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=800&q=80' }}"
              alt="{{ article.title }}"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            >
          </div>
          <!-- Category Badge -->
          {% if article.category %}
          <span class="absolute top-4 left-4 bg-primary/90 text-white text-xs font-semibold px-3 py-1.5 rounded">
            {{ article.category }}
          </span>
          {% endif %}
        </a>

        <!-- Content -->
        <div class="p-6">
          <!-- Title -->
          <h3 class="text-lg font-bold text-gray-900 mb-3 line-clamp-2 min-h-[56px]">
            <a href="{{ locale_prefix }}{{ routes.blog }}/{{ article.slug }}" class="hover:text-primary transition-colors">
              {{ article.title }}
            </a>
          </h3>

          <!-- Excerpt -->
          <p class="text-gray-500 text-sm leading-relaxed mb-4 line-clamp-3">
            {{ article.excerpt }}
          </p>

          <!-- Read More Link -->
          <a href="{{ locale_prefix }}{{ routes.blog }}/{{ article.slug }}" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-primary transition-colors">
            {{ 'home.blog_read_more' | t }}
            <span class="ml-1">&raquo;</span>
          </a>
        </div>

        <!-- Footer with Date -->
        <div class="px-6 py-4 border-t border-gray-100">
          <time class="text-sm text-gray-400" datetime="{{ article.published_at }}">
            {{ article.published_at | date: "%d/%m/%Y" }}
          </time>
        </div>
      </article>
      {% endfor %}
    </div>

    <!-- View All Link -->
    <div class="text-center mt-12">
      <a href="{{ locale_prefix }}{{ routes.blog }}" class="inline-flex items-center gap-2 text-primary hover:text-primary/80 font-semibold text-lg transition-colors group">
        {{ 'home.blog_view_all' | t }}
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 group-hover:translate-x-1 transition-transform">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
