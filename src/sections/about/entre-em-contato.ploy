<section class="w-full bg-white py-3">
  <div class="relative w-full overflow-hidden">
    <div class="mx-auto w-full max-w-[1920px] px-2 md:px-3 xl:px-4">
      <div class="relative min-h-[620px] overflow-hidden rounded-[12px] md:min-h-[700px]">
        <!-- Imagem de fundo -->
        <div class="absolute inset-0">
          <img
            src="	https://www.lopesurban.com.br/wp-content/uploads/2024/07/3c663e149558945.62e9a62ec072f-scaled.jpg"
            alt="Imóvel em destaque"
            class="h-full w-full object-cover"
          >
        </div>

        <!-- Overlay sutil -->
        <div class="absolute inset-0 bg-black/10"></div>

        <!-- Conteúdo alinhado ao container do tema -->
        <div class="relative z-10 min-h-[620px]">
          <div class="vp-section h-full">
            <div class="max-w-screen-2xl mx-auto px-[3%] h-full">
              <div class="flex min-h-[620px] items-center md:min-h-[700px]">
                <div class="w-full py-8 md:px-0 md:py-10 xl:py-12">
                  <div class="max-w-[500px] rounded-[14px] bg-white px-7 py-8 shadow-[0_18px_60px_rgba(0,0,0,0.12)] md:px-8 md:py-9">
                    <h2 class="max-w-[390px] text-[24px] font-normal leading-[1.08] tracking-[-0.03em] text-[#111827] md:text-[32px]">
                      Deixe-nos ajudá-lo a encontrar o seu imóvel ideal
                    </h2>

                    <p class="mt-5 max-w-[360px] text-[16px] leading-[1.45] text-[#8A8F98]">
                      Envie-nos uma mensagem e um dos nossos consultores entrará em contato com você.
                    </p>

                    <div class="mt-8">
                      {% form 'contact' %}
                        <div class="space-y-4">
                          <input
                            type="text"
                            name="contact[name]"
                            required
                            placeholder="Nome Completo"
                            class="h-[52px] w-full rounded-[4px] border border-[#ECECEC] bg-[#F7F7F7] px-4 text-[15px] text-[#111827] placeholder:text-[#8A8F98] outline-none transition focus:border-[#DADADA]"
                          >

                          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                            <input
                              type="email"
                              name="contact[email]"
                              required
                              placeholder="Email"
                              class="h-[52px] w-full rounded-[4px] border border-[#ECECEC] bg-[#F7F7F7] px-4 text-[15px] text-[#111827] placeholder:text-[#8A8F98] outline-none transition focus:border-[#DADADA]"
                            >

                            <input
                              type="text"
                              inputmode="tel"
                              autocomplete="tel"
                              name="contact[phone]"
                              placeholder="Telefone com DDD"
                              class="h-[52px] w-full rounded-[4px] border border-[#ECECEC] bg-[#F7F7F7] px-4 text-[15px] text-[#111827] placeholder:text-[#8A8F98] outline-none transition focus:border-[#DADADA]"
                            >
                          </div>

                          <textarea
                            name="contact[message]"
                            rows="3"
                            required
                            placeholder="Escreva aqui sua mensagem"
                            class="min-h-[86px] w-full rounded-[4px] border border-[#ECECEC] bg-[#F7F7F7] px-4 py-3 text-[15px] text-[#111827] placeholder:text-[#8A8F98] outline-none transition focus:border-[#DADADA] resize-none"
                          ></textarea>

                          {% if workspace.settings.turnstile.enabled %}
                            <div class="pt-1">
                              <div class="cf-turnstile" data-sitekey="{{ workspace.settings.turnstile.site_key }}"></div>
                            </div>
                          {% endif %}

                          <button
                            type="submit"
                            class="flex h-[54px] w-full items-center justify-center rounded-[4px] bg-[#121722] px-6 text-[16px] font-medium text-white transition hover:opacity-95"
                          >
                            Enviar mensagem
                          </button>
                        </div>
                      {% endform %}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        {% if workspace.settings.turnstile.enabled %}
          <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
        {% endif %}
      </div>
    </div>
  </div>
</section>