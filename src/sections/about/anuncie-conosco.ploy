<section class="w-full bg-white pb-20 md:py-28 xl:py-32">
  <div class="vp-section">
    <div class="max-w-screen-2xl mx-auto px-[3%]">
      <!-- Parte 1: título -->
      <div class="max-w-[1220px]">
        <span class="inline-flex items-center rounded-full border border-[#E5E7EB] px-2 py-0.5 text-[13px] font-medium text-[#111827]">
          Anuncie conosco
        </span>

        <div class="mt-7 max-w-[1180px]">
          <h2 class="text-[30px] font-normal leading-[1.08] tracking-[-0.035em] text-[#111827] md:text-[46px]">
            Anuncie seu imóvel com a Lopes Urban e conte com a credibilidade e experiência de quem entende o mercado e oferece suporte completo em todas as etapas da venda.
          </h2>
        </div>
      </div>

      <!-- Parte 2: imagem + accordions -->
      <div class="mt-16 grid grid-cols-1 gap-10 xl:grid-cols-[minmax(0,0.9fr)_minmax(0,1.05fr)] xl:items-stretch xl:gap-12">
        <!-- Imagem: primeiro no mobile, segundo no desktop -->
        <div class="order-1 xl:order-2 relative h-full overflow-hidden rounded-[0] md:rounded-[0]">
          <img
            src="{{ theme_settings.sections['anuncie-conosco-about'].image }}"
            alt="Anuncie conosco"
            class="h-full w-full object-cover"
          >
        </div>

        <!-- Texto + accordions: segundo no mobile, primeiro no desktop -->
        <div class="order-2 xl:order-1" x-data="{ open: null }">
          <div class="border-t border-[#E5E7EB]">
            <!-- Item 1 -->
            <div class="border-b border-[#E5E7EB]">
              <button
                type="button"
                @click="open = open === 0 ? null : 0"
                class="flex w-full items-center justify-between gap-4 py-4 text-left"
              >
                <div class="flex items-center gap-3">
                  <span class="text-[13px] text-[#111827]">▸</span>
                  <span class="text-[24px] font-normal leading-[1.15] tracking-[-0.02em] text-[#111827] md:text-[30px]">
                    Ampla divulgação
                  </span>
                </div>
              </button>

              <div x-show="open === 0" x-transition x-cloak class="pb-7 pl-6 pr-4">
                <p class="max-w-[620px] text-[15px] leading-[1.5] text-[#6B7280] md:text-[16px]">
                  Seu imóvel será promovido nos grandes portais imobiliários, além da rede nacional da Lopes, garantindo maior visibilidade e alcance.
                </p>
              </div>
            </div>

            <!-- Item 2 -->
            <div class="border-b border-[#E5E7EB]">
              <button
                type="button"
                @click="open = open === 1 ? null : 1"
                class="flex w-full items-center justify-between gap-4 py-4 text-left"
              >
                <div class="flex items-center gap-3">
                  <span class="text-[13px] text-[#111827]">▸</span>
                  <span class="text-[24px] font-normal leading-[1.15] tracking-[-0.02em] text-[#111827] md:text-[30px]">
                    Equipe especializada
                  </span>
                </div>
              </button>

              <div x-show="open === 1" x-transition x-cloak class="pb-7 pl-6 pr-4">
                <p class="max-w-[620px] text-[15px] leading-[1.5] text-[#6B7280] md:text-[16px]">
                  Nossa equipe especializada oferece assessoria personalizada em todas as etapas, garantindo uma experiência gratificante e sem preocupações. Conte com a expertise da Lopes Urban.
                </p>
              </div>
            </div>

            <!-- Item 3 -->
            <div class="border-b border-[#E5E7EB]">
              <button
                type="button"
                @click="open = open === 2 ? null : 2"
                class="flex w-full items-center justify-between gap-4 py-4 text-left"
              >
                <div class="flex items-center gap-3">
                  <span class="text-[13px] text-[#111827]">▸</span>
                  <span class="text-[24px] font-normal leading-[1.15] tracking-[-0.02em] text-[#111827] md:text-[30px]">
                    Marketing eficiente
                  </span>
                </div>
              </button>

              <div x-show="open === 2" x-transition x-cloak class="pb-7 pl-6 pr-4">
                <p class="max-w-[620px] text-[15px] leading-[1.5] text-[#6B7280] md:text-[16px]">
                  Desenvolvemos estratégias de marketing que valorizam seu imóvel, com produção visual, divulgação segmentada e posicionamento adequado para atrair os compradores certos.
                </p>
              </div>
            </div>

            <!-- Item 4 -->
            <div class="border-b border-[#E5E7EB]">
              <button
                type="button"
                @click="open = open === 3 ? null : 3"
                class="flex w-full items-center justify-between gap-4 py-4 text-left"
              >
                <div class="flex items-center gap-3">
                  <span class="text-[13px] text-[#111827]">▸</span>
                  <span class="text-[24px] font-normal leading-[1.15] tracking-[-0.02em] text-[#111827] md:text-[30px]">
                    Avaliação precisa
                  </span>
                </div>
              </button>

              <div x-show="open === 3" x-transition x-cloak class="pb-7 pl-6 pr-4">
                <p class="max-w-[620px] text-[15px] leading-[1.5] text-[#6B7280] md:text-[16px]">
                  Fazemos uma análise criteriosa do imóvel e do mercado para posicionar o preço corretamente, aumentando as chances de venda com segurança e competitividade.
                </p>
              </div>
            </div>

            <!-- Item 5 -->
            <div class="border-b border-[#E5E7EB]">
              <button
                type="button"
                @click="open = open === 4 ? null : 4"
                class="flex w-full items-center justify-between gap-4 py-4 text-left"
              >
                <div class="flex items-center gap-3">
                  <span class="text-[13px] text-[#111827]">▸</span>
                  <span class="text-[24px] font-normal leading-[1.15] tracking-[-0.02em] text-[#111827] md:text-[30px]">
                    Rede de contatos
                  </span>
                </div>
              </button>

              <div x-show="open === 4" x-transition x-cloak class="pb-7 pl-6 pr-4">
                <p class="max-w-[620px] text-[15px] leading-[1.5] text-[#6B7280] md:text-[16px]">
                  Conte com a força de uma rede ampla de relacionamentos e oportunidades, conectando seu imóvel a compradores qualificados e parceiros estratégicos.
                </p>
              </div>
            </div>

            <!-- Item 6 -->
            <div class="border-b border-[#E5E7EB]">
              <button
                type="button"
                @click="open = open === 5 ? null : 5"
                class="flex w-full items-center justify-between gap-4 py-4 text-left"
              >
                <div class="flex items-center gap-3">
                  <span class="text-[13px] text-[#111827]">▸</span>
                  <span class="text-[24px] font-normal leading-[1.15] tracking-[-0.02em] text-[#111827] md:text-[30px]">
                    Suporte completo
                  </span>
                </div>
              </button>

              <div x-show="open === 5" x-transition x-cloak class="pb-7 pl-6 pr-4">
                <p class="max-w-[620px] text-[15px] leading-[1.5] text-[#6B7280] md:text-[16px]">
                  Acompanhamos todas as etapas da venda, do primeiro contato até a conclusão do negócio, oferecendo tranquilidade, transparência e atendimento próximo.
                </p>
              </div>
            </div>
          </div>

          <!-- Bloco inferior -->
          <div class="mt-16 max-w-[300px]">
            <h3 class="text-[18px] font-medium leading-[1.25] text-[#111827] md:text-[20px]">
              Anuncie conosco
            </h3>

            <p class="mt-3 text-[15px] leading-[1.5] text-[#6B7280] md:text-[16px]">
              Una-se à rede de imobiliárias que mais vende imóveis no Brasil.
            </p>

            <div class="mt-5">
              <a
                href="https://wa.me/"
                class="inline-flex min-h-[46px] items-center justify-center rounded-[6px] bg-[#BE9A4D] px-6 py-3 text-[15px] font-medium text-white transition hover:opacity-90"
              >
                Falar com um corretor
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>