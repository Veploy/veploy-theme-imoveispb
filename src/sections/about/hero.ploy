<section class="w-full bg-[#F3F4F6] py-20 md:py-28 xl:py-32">
  <div class="vp-section">
    <div class="max-w-screen-2xl mx-auto px-[3%]">
        <span class="inline-flex items-center rounded-full border border-[#E5E7EB] px-2 py-0.5 text-[13px] font-medium text-[#111827]">
          Sobre nós
        </span>

        <div class="mt-7 max-w-[900px]">
          <h2 class="text-[34px] font-normal leading-[1.08] tracking-[-0.04em] text-[#111827] md:text-[46px] xl:text-[58px]">
            Uma história de paixão pelo setor imobiliário,
            <span
              class="inline-block align-baseline text-[#CC0E3B] text-[0.95em] leading-none"
              style="font-family: 'Born Ready Upright Regular', sans-serif; font-weight: 400;"
            >
              excelencia e expertise
            </span>
          </h2>
        </div>

        <div class="mt-8">
          <a
            href="{{ locale_prefix }}{{ routes.contact }}"
            class="inline-flex min-h-[44px] items-center justify-center rounded-[6px] bg-[#BE9A4D] px-5 py-2.5 text-[14px] font-medium text-white transition hover:opacity-90"
          >
            Fale conosco
          </a>
        </div>
      </div>

      <div class="mt-10 mx-auto max-w-[1080px] overflow-hidden rounded-[10px]">
        <div class="relative w-full overflow-hidden pb-[56.25%]">
          <iframe
            class="absolute inset-0 h-full w-full"
            src="https://www.youtube.com/embed/5IMw3qaJpmw"
            title="Comunicado Lopes Urban - Nova Marca"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
</section>