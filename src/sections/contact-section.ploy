<section class="sm:p-4">
<div class="py-4 lg:py-40 flex items-center justify-center sm:rounded-lg px-4 lg:px-8 pointer-events-none bg-[url('https://www.lopesurban.com.br/wp-content/uploads/2024/07/3c663e149558945.62e9a62ec072f-scaled.jpg')] bg-cover bg-center">
    <div class="w-full max-w-screen-2xl bg-white shadow-xl rounded-sm pointer-events-auto">
      <div class="grid grid-cols-1 lg:grid-cols-[1.3fr_0.9fr] gap-12 lg:gap-24 p-6 md:p-10 lg:p-20">

        <!-- Left side -->
        <div class="flex flex-col">
          <h1 class="text-4xl md:text-5xl font-bold text-gray-900 leading-tight">
            Fale conosco
          </h1>

          <p class="mt-5 max-w-xl text-gray-500 leading-7">
            Verifique a seguir os nossos canais de atendimento e escolha aquele que melhor te atender, estamos aqui à sua disposição.
          </p>

          <!-- WhatsApp CTA -->
          {% if theme_settings.contact.whatsapp != blank %}
          <div class="mt-8 bg-[#edf7f1] max-w-[80%] rounded-sm p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <span class="font-semibold text-gray-800">
              Prefere falar por whatsapp?
            </span>

            <a
              href="https://wa.me/{{ theme_settings.contact.country_code }}{{ theme_settings.contact.whatsapp | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '+' }}"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center gap-2 bg-[#005c4b] hover:opacity-90 text-white px-6 py-3 rounded-sm font-semibold transition-opacity"
            >
              <i class="ph ph-whatsapp-logo text-lg"></i>
              <span>Chamar</span>
            </a>
          </div>
          {% endif %}

          <!-- Contact info blocks -->
          <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10">
            <!-- Visit us -->
            <div>
              <h2 class="text-2xl font-bold text-gray-900 mb-6">
                Visite nosso espaço
              </h2>

              <div class="space-y-5 text-gray-500">
                {% if theme_settings.contact.address != blank %}
                <div class="flex items-start gap-3">
                  <i class="ph ph-map-pin text-primary text-lg mt-1"></i>
                  <span class="leading-6">{{ theme_settings.contact.address }}</span>
                </div>
                {% endif %}

                {% if theme_settings.contact.hours != blank %}
                <div class="flex items-start gap-3">
                  <i class="ph ph-clock text-primary text-lg mt-1"></i>
                  <span class="leading-6">{{ theme_settings.contact.hours }}</span>
                </div>
                {% endif %}
              </div>
            </div>

            <!-- Divider desktop -->
            <div class="hidden md:block absolute"></div>

            <!-- Talk to us -->
            <div class="md:border-l md:border-gray-300 md:pl-8">
              <h2 class="text-2xl font-bold text-gray-900 mb-6">
                Fale conosco
              </h2>

              <div class="space-y-4 text-gray-500">
                <!-- WhatsApp -->
                {% if theme_settings.contact.whatsapp != blank %}
                <a href="https://wa.me/{{ theme_settings.contact.country_code }}{{ theme_settings.contact.whatsapp | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '+' }}" target="_blank" rel="noopener">
                    <div class="flex items-center gap-3">
                        <i class="ph ph-whatsapp-logo text-primary flex-shrink-0"></i>
                        <span class="text-gray-700">{{ theme_settings.contact.whatsapp }}</span>
                    </div>
                </a>
                {% endif %}

                {% if theme_settings.contact.email != blank %}
                <a href="mailto:{{ theme_settings.contact.email }}"
                   class="flex items-center gap-3 hover:text-primary transition-colors">
                  <i class="ph ph-envelope text-primary text-lg"></i>
                  <span>{{ theme_settings.contact.email }}</span>
                </a>
                {% endif %}
              </div>

              {% if theme_settings.contact.facebook != blank or theme_settings.contact.instagram != blank or theme_settings.contact.youtube != blank %}
              <div class="flex items-center gap-3 mt-6">
                {% if theme_settings.contact.facebook != blank %}
                <a href="{{ theme_settings.contact.facebook }}" target="_blank" rel="noopener" class="w-9 h-9 bg-[#fff1f4] text-primary rounded-sm flex items-center justify-center hover:bg-primary hover:text-white transition-colors">
                  <i class="ph ph-facebook-logo"></i>
                </a>
                {% endif %}

                {% if theme_settings.contact.instagram != blank %}
                <a href="{{ theme_settings.contact.instagram }}" target="_blank" rel="noopener" class="w-9 h-9 bg-[#fff1f4] text-primary rounded-sm flex items-center justify-center hover:bg-primary hover:text-white transition-colors">
                  <i class="ph ph-instagram-logo"></i>
                </a>
                {% endif %}

                {% if theme_settings.contact.youtube != blank %}
                <a href="{{ theme_settings.contact.youtube }}" target="_blank" rel="noopener" class="w-9 h-9 bg-[#fff1f4] text-primary rounded-sm flex items-center justify-center hover:bg-primary hover:text-white transition-colors">
                  <i class="ph ph-youtube-logo"></i>
                </a>
                {% endif %}
              </div>
              {% endif %}
            </div>
          </div>
        </div>

        <!-- Right side: form -->
        <div class="bg-white border border-gray-200 shadow-md rounded-xl p-6 md:p-7 self-start">
          <h2 class="text-xl md:text-2xl font-bold text-gray-800">
            Nos envie uma mensagem
          </h2>

          <p class="mt-2 text-gray-500 leading-6">
            Verifique a seguir os nossos canais de atendimento.
          </p>

          {% form 'contact', name: 'Contato' %}
            <div class="mt-6 space-y-4">
              {% if form.posted_successfully %}
              <div class="p-4 rounded-lg border border-green-200 bg-green-50">
                <p class="text-green-800 font-medium">{{ form.success }}</p>
              </div>
              {% endif %}

              {% if form.errors %}
              <div class="p-4 rounded-lg border border-red-200 bg-red-50">
                <p class="text-red-800 font-medium">{{ form.errors | first }}</p>
              </div>
              {% endif %}

              <div>
                <input
                  type="text"
                  name="contact[name]"
                  required
                  placeholder="Nome Completo"
                  class="w-full h-12 border border-gray-200 rounded-sm px-4 text-gray-800 placeholder:text-gray-400 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none"
                >
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <input
                    type="email"
                    name="contact[email]"
                    required
                    placeholder="E-mail"
                    class="w-full h-12 border border-gray-200 rounded-sm px-4 text-gray-800 placeholder:text-gray-400 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none"
                  >
                </div>

                <div>
                  {% include 'components/global/form/phone-input', name: 'contact[phone]', placeholder: 'Telefone com DDD' %}
                </div>
              </div>

              <div>
                <textarea
                  name="contact[message]"
                  rows="4"
                  required
                  placeholder="Escreva aqui sua mensagem."
                  class="w-full border border-gray-200 rounded-sm px-4 py-3 text-gray-800 placeholder:text-gray-400 resize-none focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none"
                ></textarea>
              </div>

              <div class="pt-2">
                <button
                  type="submit"
                  class="w-full h-12 bg-[#111827] hover:opacity-90 text-white font-semibold rounded-sm transition-opacity"
                >
                  Envie sua mensagem
                </button>
              </div>
            </div>
          {% endform %}
        </div>

      </div>
    </div>
  </div>
  </section>