<!-- Hero Carousel Section -->
<section class="vp-section vp-hero relative">
  <div
    class="vp-hero__carousel swiper hero-swiper relative"
    style="contain: layout;"
    x-data="{}"
    x-init="
      const initSwiper = () => {
        if (typeof Swiper !== 'undefined') {
          new Swiper($el, {
            loop: true,
            speed: 800,
            autoplay: { delay: 5000, disableOnInteraction: false },
            effect: 'fade',
            fadeEffect: { crossFade: true },
            pagination: {
              el: $el.querySelector('.swiper-pagination'),
              clickable: true
            },
            navigation: {
              nextEl: $el.querySelector('.swiper-button-next'),
              prevEl: $el.querySelector('.swiper-button-prev')
            }
          });
        }
      };

      if ('requestIdleCallback' in window) {
        requestIdleCallback(initSwiper, { timeout: 500 });
      } else {
        setTimeout(initSwiper, 100);
      }
    "
  >
    <div class="swiper-wrapper">
      {% assign hero_slides = sections['hero-carousel'].items %}

      {% for slide in hero_slides %}
      <div class="swiper-slide relative">
        <picture>
          <source media="(min-width: 768px)" srcset="{{ slide.image_desktop }}">
          <img
            src="{{ slide.image_mobile | default: slide.image_desktop }}"
            alt="{{ slide.alt | default: 'Banner' }}"
            class="w-full h-[780px] md:h-[820px] object-cover"
            loading="eager"
            fetchpriority="high"
          >
        </picture>

        {% if slide.redirect_url %}
        <a href="{{ slide.redirect_url }}" class="absolute inset-0 z-10" aria-label="Abrir banner"></a>
        {% endif %}
      </div>
      {% endfor %}

      {% if hero_slides == nil or hero_slides.size == 0 %}
      <div class="swiper-slide">
        <div class="w-full h-[780px] md:h-[820px] bg-gray-200"></div>
      </div>
      {% endif %}
    </div>

    <div class="swiper-button-prev"></div>
    <div class="swiper-button-next"></div>
    <div class="swiper-pagination"></div>
  </div>

  <!-- Contact card overlay -->
  {% include 'sections/contact-section' %}
</section>

{% schema %}
{
  "name": "Hero Carousel",
  "page": "home",
  "settings": [
    {
      "type": "repeater",
      "id": "slides",
      "label": "Slides",
      "max_items": 4,
      "settings": [
        { "type": "image_picker", "id": "image_desktop", "label": "Desktop Image" },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile Image" },
        { "type": "url", "id": "redirect_url", "label": "Redirect URL" }
      ]
    }
  ]
}
{% endschema %}