<!-- Promotional Banners Section -->
<section class="vp-section vp-promo-banners py-12 md:py-16 bg-white">
  <div class="vp-section__container max-w-screen-xl mx-auto px-4 lg:px-8">
    <div class="vp-banners-grid grid grid-cols-1 md:grid-cols-2 gap-4">
      {% if promo_banners.size > 0 %}
        {% for banner in promo_banners limit: 2 %}
        <a href="{{ banner.url }}"
           class="group relative block rounded-xl overflow-hidden aspect-[16/9] md:aspect-[2/1]"
           {% if banner.external %}target="_blank" rel="noopener"{% endif %}>
          <!-- Background Image -->
          <img
            src="{{ banner.image }}"
            alt="{{ banner.title | default: 'Banner promocional' }}"
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          >

          <!-- Optional Overlay for text visibility -->
          {% if banner.title or banner.subtitle %}
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>

          <!-- Banner Content -->
          <div class="absolute bottom-4 left-4 right-4">
            {% if banner.title %}
            <h3 class="text-white text-lg font-semibold drop-shadow-lg">
              {{ banner.title }}
            </h3>
            {% endif %}
            {% if banner.subtitle %}
            <p class="text-white/80 text-sm drop-shadow-lg">
              {{ banner.subtitle }}
            </p>
            {% endif %}
          </div>
          {% endif %}
        </a>
        {% endfor %}
      {% else %}
        <!-- Default Promotional Banners -->
        <a href="{{ workspace.whatsapp_link | default: '#contato' }}"
           class="group relative block rounded-xl overflow-hidden aspect-[16/9] md:aspect-[2/1]"
           target="_blank"
           rel="noopener">
          <!-- Background with gradient fallback -->
          <div class="absolute inset-0 bg-gradient-to-br from-primary to-primary/80">
            <img
              src="https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=800&q=80"
              alt="Fale com um corretor"
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-40"
              loading="lazy"
            >
          </div>

          <!-- Content -->
          <div class="absolute inset-0 flex flex-col justify-center items-center text-center p-6">
            <h3 class="text-white text-xl md:text-2xl font-bold drop-shadow-lg mb-2">
              Fale com um corretor
            </h3>
            <p class="text-white/90 text-sm md:text-base drop-shadow-lg mb-4">
              Tire suas dúvidas pelo WhatsApp
            </p>
            <span class="inline-flex items-center gap-2 bg-white text-gray-900 px-5 py-2 rounded-full font-medium text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 24 24" class="text-green-600">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Chamar no WhatsApp
            </span>
          </div>
        </a>

        <a href="/financiamento"
           class="group relative block rounded-xl overflow-hidden aspect-[16/9] md:aspect-[2/1]">
          <!-- Background with gradient fallback -->
          <div class="absolute inset-0 bg-gradient-to-br from-secondary to-secondary/80">
            <img
              src="https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=800&q=80"
              alt="Financiamento imobiliário"
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-30"
              loading="lazy"
            >
          </div>

          <!-- Content -->
          <div class="absolute inset-0 flex flex-col justify-center items-center text-center p-6">
            <h3 class="text-white text-xl md:text-2xl font-bold drop-shadow-lg mb-2">
              Simule seu financiamento
            </h3>
            <p class="text-white/90 text-sm md:text-base drop-shadow-lg mb-4">
              Encontre as melhores condições para você
            </p>
            <span class="inline-flex items-center gap-2 bg-white text-gray-900 px-5 py-2 rounded-full font-medium text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" />
              </svg>
              Simular agora
            </span>
          </div>
        </a>
      {% endif %}
    </div>
  </div>
</section>
