{%- comment -%}
  Abertura do "Anuncie seu imóvel": foto de fundo ocupando a faixa inteira,
  conteúdo alinhado à esquerda com sobretítulo, título grande em Reckless Neue,
  texto e o botão escuro que leva ao formulário. Medidas do original: 855px de
  altura (700px no celular), título 55/66 (30/39 no celular) com os destaques
  em peso 400 e botão de 44px.
{%- endcomment -%}
{%- assign s = sections['advertise/hero'] -%}

<style>
  .pb-adhero {
    position: relative;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
  }
  .pb-adhero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(0 0 0 / .45) 0%, rgb(0 0 0 / .1) 70%);
  }
  .pb-adhero__title {
    font-family: var(--font-heading);
    font-size: 55px;
    font-weight: 300;
    line-height: 66px;
    color: #FDFBF7;
    max-width: 640px;
    text-shadow: 0 0 20px rgb(0 0 0 / .45);
  }
  .pb-adhero__title span { font-weight: 400; }
  @media (max-width: 1024px) { .pb-adhero__title { font-size: 40px; line-height: 48px; } }
  @media (max-width: 767px)  { .pb-adhero__title { font-size: 30px; line-height: 39px; } }
  .pb-adhero__text { color: #FDFBF7; max-width: 594px; }
  .pb-adhero__text strong { font-weight: 700; color: #FDFBF7; }
  .pb-adhero__btn {
    display: inline-flex;
    align-items: center;
    padding: 15px 25px;
    border-radius: 3px;
    background: #181A20;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    line-height: 14px;
    color: #fff;
    transition: background-color .2s;
  }
  .pb-adhero__btn:hover { background: #373630; }
  .pb-adhero__inner { min-height: 855px; padding-top: 140px; padding-bottom: 60px; }
  @media (max-width: 767px) { .pb-adhero__inner { min-height: 700px; padding-top: 140px; padding-bottom: 40px; } }
</style>

<section {{ section_attrs }} class="pb-adhero pb-section{% if section_class %} {{ section_class }}{% endif %}"{% if s.image != blank %} style="background-image: url('{{ s.image }}');"{% endif %}>
  <div class="pb-container pb-adhero__inner relative z-10 !mb-0 flex flex-col justify-center">
    {%- if s.eyebrow != blank %}
    <span class="pb-eyebrow pb-eyebrow--light block mb-[19px] max-md:mb-[9px]">{{ s.eyebrow }}</span>
    {%- endif %}

    <h1 class="pb-adhero__title">
      {{- s.title }}{% if s.title_highlight != blank %} <span>{{ s.title_highlight }}</span>{% endif %}{% if s.title_middle != blank %} {{ s.title_middle }}{% endif %}{% if s.title_highlight2 != blank %} <span>{{ s.title_highlight2 }}</span>{% endif -%}
    </h1>

    {%- if s.description != blank %}
    <div class="pb-text pb-adhero__text mt-5">{{ s.description }}</div>
    {%- endif %}

    {%- if s.cta_text != blank %}
    <div class="mt-5 max-md:mt-0">
      <a href="{{ s.cta_url | default: '#anunciar-form' }}" class="pb-adhero__btn">{{ s.cta_text }}</a>
    </div>
    {%- endif %}
  </div>
</section>

{% schema %}
{
  "name": "Anuncie — abertura",
  "location": "advertise",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Anuncie seu imóvel" },
    { "type": "text", "id": "title", "label": "Título — início" },
    { "type": "text", "id": "title_highlight", "label": "Título — 1º destaque" },
    { "type": "text", "id": "title_middle", "label": "Título — meio" },
    { "type": "text", "id": "title_highlight2", "label": "Título — 2º destaque" },
    { "type": "richtext", "id": "description", "label": "Texto" },
    { "type": "text", "id": "cta_text", "label": "Texto do botão", "default": "Cadastrar agora" },
    { "type": "url", "id": "cta_url", "label": "Link do botão", "default": "#anunciar-form" },
    { "type": "image_picker", "id": "image", "label": "Foto de fundo" }
  ]
}
{% endschema %}
