<!-- Anuncie seu imóvel (Elegance): faixa preta em cima / clara embaixo, texto à esquerda e
     card de formulário (captação de imóvel) sobreposto à divisão, à direita -->
{%- assign af = sections['advertise/form'] -%}
{%- assign af_eyebrow = af.eyebrow | default: '/Anuncie seu imóvel' -%}
{%- assign af_title = af.title | default: 'Potencialize seu anúncio e valorize seu imóvel com nosso auxílio especializado.' -%}
{%- assign af_description = af.description | default: 'Envie-nos uma mensagem e um dos nossos consultores entrará em contato com você. Será um prazer lhe atender!' -%}
{%- assign af_wa_text = af.cta_whatsapp_text | default: 'Chamar no WhatsApp' -%}
{%- assign af_help_title = af.help_title | default: 'Ficou com alguma dúvida?' -%}
{%- assign af_bottom_bg = af.bottom_bg_color | default: '#F8F8F8' -%}
{%- assign _wa = theme_settings.contact.whatsapp | remove: '-' | remove: '(' | remove: ')' | remove: ' ' -%}
{%- assign whatsapp_url = theme_settings.contact.whatsapp_link | default: '' -%}
{%- if whatsapp_url == '' -%}{%- assign whatsapp_url = 'https://wa.me/55' | append: _wa -%}{%- endif -%}

<section {{ section_attrs }} id="anunciar-form" class="vp-section vp-advertise-form w-full -mt-px px-[5%] overflow-hidden{% if section_class %} {{ section_class }}{% endif %}" style="background-color: {{ af_bottom_bg }};">
  <div class="max-w-[1300px] mx-auto grid grid-cols-1 lg:grid-cols-2">
    <!-- Faixa preta: texto + WhatsApp -->
    <div class="vp-band pt-[90px] pb-[80px] lg:pr-[60px] text-white">
      <span class="vp-eyebrow text-[#FBFBFB] pb-[10px]">{{ af_eyebrow }}</span>
      <h1 class="font-serif text-[30px] leading-[40px] md:text-[39px] md:leading-[52px] font-normal text-white mb-5">{{ af_title }}</h1>
      <p class="text-[15px] leading-[22px] text-white mb-10">{{ af_description }}</p>
      {%- if theme_settings.contact.whatsapp != blank -%}
      <a href="{{ whatsapp_url }}" target="_blank" rel="noopener" class="vp-btn border-white text-white bg-transparent hover:bg-white hover:text-black">
        <i class="ph ph-whatsapp-logo text-[16px]"></i>
        {{ af_wa_text }}
      </a>
      {%- endif -%}
    </div>

    <!-- Card do formulário de captação (sobrepõe a divisão preto/claro) -->
    <div class="relative z-[3] lg:row-span-2 lg:mt-[110px] mb-[60px] lg:mb-[80px]">
      <div class="vp-form bg-white p-10 md:p-[70px] shadow-[0_10px_40px_0_rgb(0_0_0/0.10)]">
        {% form 'property_submission' %}
          {% if form.posted_successfully %}
            <p class="mb-6 border border-green-200 bg-green-50 p-4 text-green-800 font-medium">{{ form.success }}</p>
          {% endif %}
          {% if form.errors %}
            <p class="mb-6 border border-red-200 bg-red-50 p-4 text-red-800 font-medium">{{ form.errors | first }}</p>
          {% endif %}
          <div class="space-y-[30px]">
            <div>
              <label for="af-name">Nome</label>
              <input id="af-name" type="text" name="property_submission[name]" required placeholder="Nome completo" class="vp-form__input">
            </div>
            <div>
              <label for="af-email">E-mail</label>
              <input id="af-email" type="email" name="property_submission[email]" required placeholder="Seu melhor e-mail" class="vp-form__input">
            </div>
            <div>
              <label>Telefone com DDD</label>
              {% include 'components/global/form/phone-input', name: 'property_submission[phone]', placeholder: '(99) 99999-9999', input_class: 'vp-form__input' %}
            </div>
            <div>
              <label for="af-method">Selecione a forma de contato desejada</label>
              <select id="af-method" name="property_submission[contact_method]" class="vp-form__input cursor-pointer">
                <option value="Telefone">Telefone</option>
                <option value="Whatsapp">Whatsapp</option>
              </select>
            </div>
            <div>
              <label for="af-type">Tipo de imóvel</label>
              <input id="af-type" type="text" name="property_submission[property_type]" placeholder="Casa, apartamento, lote..." class="vp-form__input">
            </div>
            <div>
              <label for="af-operation">Eu quero</label>
              <select id="af-operation" name="property_submission[operation]" class="vp-form__input cursor-pointer">
                <option value="Vender">Vender</option>
                <option value="Alugar">Alugar</option>
                <option value="Permutar">Permutar</option>
              </select>
            </div>

            {% if workspace.settings.turnstile.enabled %}
              <div class="cf-turnstile" data-sitekey="{{ workspace.settings.turnstile.site_key }}"></div>
            {% endif %}

            <button type="submit" class="vp-form__submit">Enviar</button>
          </div>
        {% endform %}
      </div>
    </div>

    <!-- Área clara: dúvidas + canais -->
    <div class="pt-[60px] pb-[60px] lg:pb-[80px] lg:pr-[60px] lg:pl-[10px]">
      <h2 class="font-serif text-[32px] font-bold leading-[37px] text-black pb-[10px] mb-4">{{ af_help_title }}</h2>
      {%- if theme_settings.contact.email != blank -%}
      <p class="text-[15px] leading-[22px] text-black mb-6">
        Envie uma mensagem para <a href="mailto:{{ theme_settings.contact.email }}" class="hover:underline">{{ theme_settings.contact.email }}</a> e nós te responderemos assim que possível.
      </p>
      {%- endif -%}
      {% include 'components/contact-channels', social_style: 'outline', show_email: false, show_whatsapp_social: true %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Formulário de anúncio",
  "location": "advertise",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "/Anuncie seu imóvel" },
    { "type": "textarea", "id": "title", "label": "Título" },
    { "type": "textarea", "id": "description", "label": "Descrição" },
    { "type": "text", "id": "cta_whatsapp_text", "label": "Texto do botão WhatsApp", "default": "Chamar no WhatsApp" },
    { "type": "text", "id": "help_title", "label": "Título do bloco de dúvidas", "default": "Ficou com alguma dúvida?" },
    { "type": "color", "id": "bottom_bg_color", "label": "Cor de fundo da parte de baixo", "default": "#F8F8F8" }
  ]
}
{% endschema %}
