{%- comment -%}
  Corpo do "Anuncie seu imóvel": à esquerda os benefícios, o painel cinza de
  reforço e o passo a passo; à direita o cartão do formulário, que acompanha a
  rolagem (sticky) como no original.

  Os textos vêm de três grupos: `advertise/benefits`, `advertise/process` e
  `advertise/form`.
{%- endcomment -%}
{%- assign b = sections['advertise/benefits'] -%}
{%- assign p = sections['advertise/process'] -%}
{%- assign f = sections['advertise/form'] -%}
{%- assign benefits = b.benefits.items | default: empty -%}
{%- assign steps = p.process.items | default: empty -%}

<style>
  /* Cartões de benefícios e etapas: borda bege, 30px de respiro, título 20/24 */
  .pb-ad__card,
  .pb-ad__step {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 30px;
    border: 1px solid #E7E0D2;
    border-radius: 4px;
  }
  /* Etapas: sem borda, só o texto — como no original */
  .pb-ad__step { gap: 14px; padding: 30px; border: 0; }
  .pb-ad__card h3,
  .pb-ad__step h3 {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 400;
    line-height: 1.2em;
    color: #181A20;
  }
  .pb-ad__panel {
    background: #F8F8F8;
    border-radius: 4px;
    padding: 115px 40px 112px;
    text-align: center;
  }
  .pb-ad__panel h2 {
    font-family: var(--font-heading);
    font-size: 45px;
    font-weight: 300;
    line-height: 54px;
    color: #181A20;
    max-width: 650px;
    margin-inline: auto;
  }
  .pb-ad__panel h2 span { font-weight: 400; }
  @media (max-width: 767px) { .pb-ad__panel { padding: 60px 30px; } .pb-ad__panel h2 { font-size: 25px; line-height: 32.5px; } }
  /* No celular o original esconde os links ao lado da linha */
  @media (max-width: 767px) { .pb-ad__rule .pb-link { display: none; } }

  .pb-ad__form {
    background: #fff;
    border: 1px solid #E7E0D2;
    border-radius: 4px;
    padding: 20px;
  }
  .pb-ad__form-title {
    font-family: var(--font-heading);
    font-size: 25px;
    font-weight: 400;
    line-height: 24px;
    color: #181A20;
  }
  .pb-ad__form-sub { margin: 10px 0 20px; font-family: var(--font-body); font-size: 15px; line-height: 17px; color: #666158; }
  /* Campos com a linha de baixo #666158, como no card do original */
  .pb-ad__form input.pb-form__field:not([type='checkbox']):not([type='radio']),
  .pb-ad__form select.pb-form__field { border-bottom-color: #666158; }
  @media (min-width: 1025px) {
    /* O card sobe 39px por cima da foto do topo e acompanha a rolagem.
       Os -139px somados aos 100px de padding do grid dão os -40px líquidos
       do cartão 7821faf em produção. */
    .pb-ad__aside { position: relative; z-index: 20; margin-top: -139px; }
    /* A barra flutuante (.pb-header--stuck) é fixa em `top: 2%` e o nav tem
       110px de altura, então o pé dela fica em 2vh + 110px. Com os 120px que
       estavam aqui o cabeçalho cobria o título do cartão. Agora o cartão para
       20px abaixo da barra, em qualquer altura de tela. */
    .pb-ad__sticky { position: sticky; top: calc(2vh + 130px); }
  }

  /* Entrada das seções ao rolar, portada do Elementor de produção
     (post-61.css). Cada elemento tem `animated-slow`, que no Elementor vale
     2s de duração:
       cabeçalho "Benefícios" (b1c06ae) ....... fadeInDown
       cards de benefício (04eb2ab e irmãos) .. fadeInLeft,  150ms
       painel "Somos referência" (883c093) .... fadeInUp
       cabeçalho "Como Anunciar" (a186103) .... fadeInDown
       etapas (cd6bbb5, 641a087, 02f0f22) ..... fadeInRight, 0 / 200 / 300ms
     Os atributos data-reveal ficam no HTML; o CSS e a classe .pb-reveal vêm
     do reveal.js, então, se o script não carregar, nada fica escondido. */
</style>

<section {{ section_attrs }} class="pb-ad pb-section bg-white{% if section_class %} {{ section_class }}{% endif %}">
  <div class="pb-container !mb-0 grid grid-cols-1 min-[1025px]:grid-cols-[minmax(0,1fr)_331px] gap-10 min-[1025px]:gap-[71px] pt-[60px] min-[1025px]:pt-[100px] pb-[90px]">

    {%- comment -%} Coluna da esquerda {%- endcomment -%}
    <div class="flex flex-col gap-[100px]">

      {%- comment -%} Benefícios {%- endcomment -%}
      <div>
        <div data-reveal="down">
        {% include 'components/home-section-header',
           eyebrow: b.eyebrow,
           heading: b.title,
           heading_highlight: b.title_highlight,
           heading_middle: b.title_middle,
           heading_highlight2: b.title_highlight2,
           heading_after: b.title_after,
           soft: true %}
        {%- if b.description != blank %}
        <div class="pb-text max-w-[710px] mt-[5px]">{{ b.description }}</div>
        {%- endif %}
        {%- if b.cta_text != blank %}
        <div class="pb-ad__rule flex items-center gap-5 min-h-[14px] mt-[27px]">
          <span class="pb-divider !my-0"></span>
          <a href="{{ b.cta_url }}"{% if b.cta_url contains '://' %} target="_blank" rel="noopener"{% endif %} class="pb-link">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true"><path d="M313.941 216H12c-6.627 0-12 5.373-12 12v56c0 6.627 5.373 12 12 12h301.941v46.059c0 21.382 25.851 32.09 40.971 16.971l86.059-86.059c9.373-9.373 9.373-24.569 0-33.941l-86.059-86.059c-15.119-15.119-40.971-4.411-40.971 16.971V216z"/></svg>
            <span>{{ b.cta_text }}</span>
          </a>
        </div>
        {%- endif %}
        </div>

        {%- if benefits != empty and benefits.size > 0 %}
        <div class="grid grid-cols-1 min-[1025px]:grid-cols-3 gap-5 mt-[60px] min-[1025px]:mt-[75px]">
          {%- for item in benefits -%}
          <div class="pb-ad__card" data-reveal="left" data-reveal-delay="150">
            <h3>{{ item.title }}</h3>
            <p class="pb-text">{{ item.description }}</p>
          </div>
          {%- endfor -%}
        </div>
        {%- endif %}
      </div>

      {%- comment -%} Painel cinza de reforço {%- endcomment -%}
      {%- if b.highlight_title != blank %}
      <div class="pb-ad__panel" data-reveal="up">
        <h2>
          {{- b.highlight_title }}{% if b.highlight_title_highlight != blank %} <span>{{ b.highlight_title_highlight }}</span>{% endif %}{% if b.highlight_title_after != blank %} {{ b.highlight_title_after }}{% endif -%}
        </h2>
        {%- if b.highlight_description != blank %}
        <div class="pb-text max-w-[710px] mx-auto mt-5">{{ b.highlight_description }}</div>
        {%- endif %}
        {%- if b.highlight_image != blank %}
        <img src="{{ b.highlight_image }}" alt="{{ workspace.name }}" class="mx-auto mt-10 w-[85px] h-auto object-contain" loading="lazy" width="85" height="85">
        {%- endif %}
      </div>
      {%- endif %}

      {%- comment -%} Como anunciar {%- endcomment -%}
      <div>
        <div data-reveal="down">
        {% include 'components/home-section-header',
           eyebrow: p.eyebrow,
           heading: p.title,
           heading_highlight: p.title_highlight,
           heading_middle: p.title_middle,
           heading_highlight2: p.title_highlight2,
           heading_after: p.title_after,
           soft: true %}
        {%- if p.description != blank %}
        <div class="pb-text max-w-[710px] mt-[5px]">{{ p.description }}</div>
        {%- endif %}
        {%- if p.cta_text != blank %}
        <div class="pb-ad__rule flex items-center gap-5 min-h-[14px] mt-[27px]">
          <span class="pb-divider !my-0"></span>
          <a href="{{ p.cta_url }}"{% if p.cta_url contains '://' %} target="_blank" rel="noopener"{% endif %} class="pb-link">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true"><path d="M313.941 216H12c-6.627 0-12 5.373-12 12v56c0 6.627 5.373 12 12 12h301.941v46.059c0 21.382 25.851 32.09 40.971 16.971l86.059-86.059c9.373-9.373 9.373-24.569 0-33.941l-86.059-86.059c-15.119-15.119-40.971-4.411-40.971 16.971V216z"/></svg>
            <span>{{ p.cta_text }}</span>
          </a>
        </div>
        {%- endif %}
        </div>

        {%- if steps != empty and steps.size > 0 %}
        <div class="grid grid-cols-1 min-[1025px]:grid-cols-3 gap-5 mt-[60px] min-[1025px]:mt-[75px]">
          {%- comment -%}
            Atrasos do original: 0ms na primeira etapa, 200ms na segunda e
            300ms da terceira em diante.
          {%- endcomment -%}
          {%- for item in steps -%}
          {%- if forloop.index0 == 0 -%}{%- assign _delay = 0 -%}
          {%- elsif forloop.index0 == 1 -%}{%- assign _delay = 200 -%}
          {%- else -%}{%- assign _delay = 300 -%}{%- endif -%}
          <div class="pb-ad__step" data-reveal="right" data-reveal-delay="{{ _delay }}">
            <h3>{{ item.title }}</h3>
            <p class="pb-text">{{ item.description }}</p>
          </div>
          {%- endfor -%}
        </div>
        {%- endif %}
      </div>
    </div>

    {%- comment -%} Coluna da direita: formulário que acompanha a rolagem {%- endcomment -%}
    <div class="pb-ad__aside">
      <div id="anunciar-form" class="pb-ad__sticky">
        <div class="pb-ad__form">
          <h2 class="pb-ad__form-title">{{ f.eyebrow | default: 'Anuncie conosco' }}</h2>
          {%- if f.title != blank %}
          <p class="pb-ad__form-sub">{{ f.title }}</p>
          {%- endif %}

          {% form 'contact', name: 'Anuncie seu imóvel' %}
            {% if form.posted_successfully %}
            <p class="pb-form__notice mb-5 border border-green-200 bg-green-50 text-green-800">{{ form.success }}</p>
            {% endif %}
            {% if form.errors %}
            <p class="pb-form__notice mb-5 border border-red-200 bg-red-50 text-red-800">{{ form.errors | first }}</p>
            {% endif %}

            <div class="flex flex-col gap-[10px]">
              <input type="text" name="contact[name]" required placeholder="Nome" class="pb-form__field" aria-label="Nome">
              <input type="email" name="contact[email]" required placeholder="E-mail" class="pb-form__field" aria-label="E-mail">
              {% include 'components/global/form/phone-input', name: 'contact[phone]', placeholder: 'Telefone', input_class: 'pb-form__field', id: 'pb-ad-phone' %}

              <div>
                <label class="pb-form__label" for="pb-ad-type">Tipo de imóvel</label>
                <select id="pb-ad-type" name="contact[property_type]" class="pb-form__field">
                  <option value="Terreno">Terreno</option>
                  <option value="Imóvel comercial">Imóvel comercial</option>
                  <option value="Casa em condomínio">Casa em condomínio</option>
                  <option value="Casa">Casa</option>
                  <option value="Apartamento">Apartamento</option>
                </select>
              </div>

              <div>
                <label class="pb-form__label" for="pb-ad-interest">Estou interessado em</label>
                <select id="pb-ad-interest" name="contact[interest]" class="pb-form__field">
                  <option value="Vender">Vender</option>
                  <option value="Alugar">Alugar</option>
                  <option value="Permutar">Permutar</option>
                </select>
              </div>

              {% if workspace.settings.turnstile.enabled %}
              <div class="cf-turnstile" data-sitekey="{{ workspace.settings.turnstile.site_key }}"></div>
              {% endif %}

              <button type="submit" class="pb-form__submit mt-1">{{ f.submit_text | default: 'Anunciar imóvel' }}</button>
            </div>
          {% endform %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Anuncie — conteúdo e formulário",
  "location": "advertise",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Título do formulário", "default": "Anuncie conosco" },
    { "type": "textarea", "id": "title", "label": "Chamada do formulário", "default": "Preencha o formulário e fale conosco." },
    { "type": "text", "id": "submit_text", "label": "Texto do botão", "default": "Anunciar imóvel" }
  ]
}
{% endschema %}
