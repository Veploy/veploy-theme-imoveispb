{%- assign relatos_image = theme_settings.sections.advertise.relatos.image | default: '/assets/images/anuncie-conosco.png' -%}
{%- assign relatos_items = theme_settings.sections.advertise.relatos.items -%}

<section class="w-full bg-white py-16 md:py-24">
  <!-- MOBILE -->
  <div class="vp-section md:hidden">
    <div class="max-w-screen-2xl mx-auto px-[3%]">
      <div class="relative overflow-hidden rounded-[10px]">
        <div class="relative min-h-[370px] overflow-hidden rounded-[10px]">
          <!-- Imagem de fundo -->
          <div class="absolute inset-0">
            <img
              src="{{ relatos_image }}"
              alt="Relatos de clientes"
              class="h-full w-full object-cover"
            >
          </div>

          <!-- Overlay -->
          <div class="absolute inset-0 bg-black/45"></div>

          <!-- Conteúdo -->
          <div class="relative z-10 min-h-[370px]" data-testimonial-slider-mobile>
            <div class="h-full">
              <div class="flex min-h-[370px]">
                <div class="w-full text-white">
                  <div class="relative overflow-hidden rounded-[10px]" data-slider-viewport>
                    <div
                      class="flex transition-transform duration-500 ease-in-out"
                      data-slider-track
                      style="transform: translateX(0%);"
                    >
                      {% for item in relatos_items %}
                        <div class="w-full shrink-0">
                          <div class="max-w-[900px] px-4 py-6 text-white">
                            <div class="text-[54px] font-semibold leading-none">
                              ”
                            </div>

                            <h2 class="-mt-1 max-w-[255px] text-[24px] font-normal leading-[1.05] tracking-[-0.03em] text-white">
                              {{ item.quote }}
                            </h2>

                            <div class="mt-7">
                              <p class="text-[18px] font-medium text-white">
                                {{ item.name }}
                              </p>
                              <p class="mt-1 text-[12px] font-semibold uppercase tracking-[0.12em] text-[#BE9A4D]">
                                {{ item.role }}
                              </p>
                            </div>
                          </div>
                        </div>
                      {% endfor %}
                    </div>
                  </div>

                  <!-- Bullets -->
                  <div class="absolute bottom-3 left-1/2 z-20 flex -translate-x-1/2 items-center gap-3" data-slider-dots>
                    {% for item in relatos_items %}
                      {%- assign idx = forloop.index0 -%}
                      <button
                        type="button"
                        class="h-[6px] w-[6px] rounded-full bg-white/40 transition{% if forloop.first %} !bg-white{% endif %}"
                        data-slide-to="{{ idx }}"
                        aria-label="Ir para slide {{ forloop.index }}"
                      ></button>
                    {% endfor %}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div><!-- wrapper -->
    </div>
  </div>

  <!-- DESKTOP -->
  <div class="hidden md:block">
    <div class="mx-auto px-[0.3%]">
      <div class="relative overflow-hidden rounded-[10px] min-h-[520px]">
        <!-- Imagem de fundo -->
        <div class="absolute inset-0">
          <img
            src="{{ relatos_image }}"
            alt="Relatos de clientes"
            class="h-full w-full object-cover"
          >
        </div>

        <!-- Overlay -->
        <div class="absolute inset-0 bg-black/45"></div>

        <!-- Conteúdo -->
        <div class="relative z-10 min-h-[520px]" data-testimonial-slider-desktop>
          <div class="h-full">
            <div class="flex min-h-[520px]">
              <div class="w-full text-white">
                <div class="relative overflow-hidden rounded-[10px]" data-slider-viewport>
                  <div
                    class="flex transition-transform duration-500 ease-in-out"
                    data-slider-track
                    style="transform: translateX(0%);"
                  >
                    {% for item in relatos_items %}
                      <div class="w-full shrink-0">
                        <div class="max-w-[900px] px-10 py-16 text-white">
                          <div class="text-[80px] font-semibold leading-none">
                            ”
                          </div>

                          <h2 class="mt-2 max-w-[900px] pl-6 text-[49px] font-normal leading-[1.1] tracking-[-2px] text-white">
                            {{ item.quote }}
                          </h2>

                          <div class="mt-10 pl-6">
                            <p class="text-2xl font-medium text-white">
                              {{ item.name }}
                            </p>
                            <p class="mt-1 text-base font-semibold uppercase tracking-[0.08em] text-[#BE9A4D]">
                              {{ item.role }}
                            </p>
                          </div>
                        </div>
                      </div>
                    {% endfor %}
                  </div>
                </div>

                <!-- Bullets -->
                <div class="absolute bottom-6 left-1/2 z-20 flex -translate-x-1/2 items-center gap-3" data-slider-dots>
                  {% for item in relatos_items %}
                    {%- assign idx = forloop.index0 -%}
                    <button
                      type="button"
                      class="h-[6px] w-[6px] rounded-full bg-white/40 transition{% if forloop.first %} !bg-white{% endif %}"
                      data-slide-to="{{ idx }}"
                      aria-label="Ir para slide {{ forloop.index }}"
                    ></button>
                  {% endfor %}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div><!-- wrapper -->
    </div>
  </div>

  <script>
    (() => {
      const sliders = document.querySelectorAll('[data-testimonial-slider-mobile], [data-testimonial-slider-desktop]');

      sliders.forEach((slider) => {
        const viewport = slider.querySelector('[data-slider-viewport]');
        const track = slider.querySelector('[data-slider-track]');
        const slides = Array.from(track.children);
        const dots = Array.from(slider.querySelectorAll('[data-slide-to]'));

        if (!track || !slides.length || !viewport) return;

        let currentIndex = 0;
        let autoplay = null;
        const autoplayDelay = 5000;

        let startX = 0;
        let currentX = 0;
        let isDragging = false;
        const dragThreshold = 50;

        function updateSlider() {
          track.style.transition = 'transform 500ms ease-in-out';
          track.style.transform = `translateX(-${currentIndex * 100}%)`;

          dots.forEach((dot, index) => {
            if (index === currentIndex) {
              dot.classList.remove('bg-white/40');
              dot.classList.add('!bg-white');
            } else {
              dot.classList.remove('!bg-white');
              dot.classList.add('bg-white/40');
            }
          });
        }

        function goToSlide(index) {
          currentIndex = index;
          if (currentIndex < 0) currentIndex = slides.length - 1;
          if (currentIndex >= slides.length) currentIndex = 0;
          updateSlider();
        }

        function nextSlide() {
          goToSlide(currentIndex + 1);
        }

        function prevSlide() {
          goToSlide(currentIndex - 1);
        }

        function startAutoplay() {
          stopAutoplay();
          autoplay = setInterval(() => {
            nextSlide();
          }, autoplayDelay);
        }

        function stopAutoplay() {
          if (autoplay) {
            clearInterval(autoplay);
            autoplay = null;
          }
        }

        dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            const index = Number(dot.dataset.slideTo);
            goToSlide(index);
            startAutoplay();
          });
        });

        function onDragStart(clientX) {
          isDragging = true;
          startX = clientX;
          currentX = clientX;
          stopAutoplay();
          track.style.transition = 'none';
        }

        function onDragMove(clientX) {
          if (!isDragging) return;
          currentX = clientX;

          const deltaX = currentX - startX;
          const percentage = (deltaX / viewport.offsetWidth) * 100;
          const baseTranslate = -(currentIndex * 100);

          track.style.transform = `translateX(calc(${baseTranslate}% + ${percentage}%))`;
        }

        function onDragEnd() {
          if (!isDragging) return;

          const deltaX = currentX - startX;
          isDragging = false;

          if (Math.abs(deltaX) > dragThreshold) {
            if (deltaX < 0) {
              nextSlide();
            } else {
              prevSlide();
            }
          } else {
            updateSlider();
          }

          startAutoplay();
        }

        viewport.addEventListener('mousedown', (event) => {
          onDragStart(event.clientX);
        });

        window.addEventListener('mousemove', (event) => {
          onDragMove(event.clientX);
        });

        window.addEventListener('mouseup', () => {
          onDragEnd();
        });

        viewport.addEventListener('touchstart', (event) => {
          onDragStart(event.touches[0].clientX);
        }, { passive: true });

        viewport.addEventListener('touchmove', (event) => {
          onDragMove(event.touches[0].clientX);
        }, { passive: true });

        viewport.addEventListener('touchend', () => {
          onDragEnd();
        });

        slider.addEventListener('mouseenter', stopAutoplay);
        slider.addEventListener('mouseleave', startAutoplay);

        updateSlider();
        startAutoplay();
      });
    })();
  </script>
</section>