<!-- Sobre nós — Missão, Visão e Valores (Elegance): título centralizado +
     três colunas iguais separadas por linhas verticais -->
{%- assign mv = sections['about-us/values'] -%}
{%- assign mv_title = mv.title | default: 'Comprometidos em realizar sonhos, inspirar confiança e construir relações.' -%}
{%- assign mv_items = mv.items.items -%}

{% if mv_items and mv_items.size > 0 %}
<section {{ section_attrs }} class="vp-section vp-about-values w-full bg-white px-[5%]{% if section_class %} {{ section_class }}{% endif %}">
  <div class="max-w-[1300px] mx-auto pb-[80px]">
    <h2 class="font-serif mx-auto md:max-w-[54%] text-center text-[28px] md:text-[34px] font-normal leading-[1.1] tracking-[1px] text-black">{{ mv_title }}</h2>

    <div class="grid grid-cols-1 md:grid-cols-3 pt-[60px] divide-y md:divide-y-0 md:divide-x divide-black">
      {% for item in mv_items %}
      <div class="p-[10px] md:p-[30px] py-8 md:py-[30px] text-center">
        <h3 class="font-serif text-[28px] font-normal leading-[1.1] tracking-[1px] text-black mb-6">{{ item.title }}</h3>
        <p class="text-[15px] leading-[22px] text-black">{{ item.description }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Sobre nós — missão, visão e valores",
  "location": "about-us",
  "settings": [
    { "type": "textarea", "id": "title", "label": "Título" },
    {
      "type": "repeater",
      "id": "items",
      "label": "Colunas",
      "max_items": 3,
      "settings": [
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "textarea", "id": "description", "label": "Descrição" }
      ]
    }
  ]
}
{% endschema %}
