{%- comment -%}
  "Diferenciais" do Sobre nós: cabeçalho e texto em cima e, embaixo, os itens
  em quatro cartões de borda bege lado a lado (como os serviços da história).
  No celular os itens ficam empilhados, sem cartão — igual ao original.
{%- endcomment -%}
{%- assign s = sections['about-us/values'] -%}
{%- assign items = s.values.items | default: empty -%}

<style>
  .pb-values__item { display: flex; flex-direction: column; gap: 14px; }
  .pb-values__item h3 {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 400;
    line-height: 24px;
    color: #181A20;
  }
  @media (min-width: 1025px) {
    .pb-values__item { padding: 30px; border: 1px solid #E7E0D2; border-radius: 4px; }
  }
</style>

<section {{ section_attrs }} class="pb-values pb-section bg-white{% if section_class %} {{ section_class }}{% endif %}">
  <div class="pb-container !mb-0 pt-[60px] pb-[90px]">
    {% include 'components/home-section-header',
       eyebrow: s.eyebrow,
       heading: s.title,
       heading_highlight: s.title_highlight,
       heading_after: s.title_after,
       soft: true %}
    {%- if s.description != blank %}
    <div class="pb-text max-w-[710px] mt-[5px]">{{ s.description }}</div>
    {%- endif %}
    <div class="flex items-center mt-[30px]">
      <span class="pb-divider !my-0"></span>
    </div>

    {%- if items != empty and items.size > 0 %}
    <div class="grid grid-cols-1 min-[1025px]:grid-cols-4 gap-x-5 gap-y-[60px] mt-[60px] lg:mt-[93px]">
      {%- for item in items -%}
      <div class="pb-values__item">
        <h3>{{ item.title }}</h3>
        <p class="pb-text">{{ item.description }}</p>
      </div>
      {%- endfor -%}
    </div>
    {%- endif %}
  </div>
</section>

{% schema %}
{
  "name": "Sobre nós — diferenciais",
  "location": "about-us",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Diferenciais" },
    { "type": "text", "id": "title", "label": "Título" },
    { "type": "text", "id": "title_highlight", "label": "Título — trecho em destaque" },
    { "type": "text", "id": "title_after", "label": "Título — fim" },
    { "type": "textarea", "id": "description", "label": "Texto" },
    {
      "type": "repeater",
      "id": "values",
      "label": "Diferenciais",
      "max_items": 6,
      "settings": [
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "textarea", "id": "description", "label": "Descrição" }
      ]
    }
  ]
}
{% endschema %}
