{%- comment -%}
  "Diferenciais" do Sobre nós: cabeçalho com linha à esquerda e, à direita, a
  lista de itens separados por um filete bege à esquerda de cada bloco.
{%- endcomment -%}
{%- assign s = sections['about-us/values'] -%}
{%- assign items = s.values.items | default: empty -%}

<style>
  .pb-values__item {
    padding: 20px 15px 20px 30px;
    border-left: 1px solid #E7E0D2;
  }
  .pb-values__item h3 {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 400;
    line-height: 1.2em;
    color: #181A20;
    margin-bottom: 15px;
  }
</style>

<section {{ section_attrs }} class="pb-values pb-section bg-white{% if section_class %} {{ section_class }}{% endif %}">
  <div class="pb-container pt-[70px] pb-[90px] grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16">
    <div>
      {% include 'components/home-section-header',
         eyebrow: s.eyebrow,
         heading: s.title,
         heading_highlight: s.title_highlight,
         heading_after: s.title_after %}
      {%- if s.description != blank %}
      <div class="pb-text max-w-[710px] mt-5">{{ s.description }}</div>
      {%- endif %}
      <div class="flex items-center mt-6">
        <span class="pb-divider"></span>
      </div>
    </div>

    {%- if items != empty and items.size > 0 %}
    <div class="flex flex-col gap-2">
      {%- for item in items -%}
      <div class="pb-values__item">
        <h3>{{ item.title }}</h3>
        <p class="pb-text">{{ item.description }}</p>
      </div>
      {%- endfor -%}
    </div>
    {%- endif %}
  </div>
</section>

{% schema %}
{
  "name": "Sobre nós — diferenciais",
  "location": "about-us",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Diferenciais" },
    { "type": "text", "id": "title", "label": "Título" },
    { "type": "text", "id": "title_highlight", "label": "Título — trecho em destaque" },
    { "type": "text", "id": "title_after", "label": "Título — fim" },
    { "type": "textarea", "id": "description", "label": "Texto" },
    {
      "type": "repeater",
      "id": "values",
      "label": "Diferenciais",
      "max_items": 6,
      "settings": [
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "textarea", "id": "description", "label": "Descrição" }
      ]
    }
  ]
}
{% endschema %}
