<!-- Sobre nós — abertura (Elegance): fundo preto, título centralizado com destaque manuscrito,
     texto e foto institucional que avança sobre a seção seguinte (branca) -->
{%- assign ah = sections['about-us/hero'] -%}
{%- assign ah_title = ah.title | default: 'Uma história de paixão pelo setor imobiliário,' -%}
{%- assign ah_title_script = ah.title_script | default: 'excelência e expertise.' -%}
{%- assign ah_script_color = ah.title_script_color | default: '#E4234F' -%}
{%- assign ah_image = ah.image | default: 'https://www.lopeselegance.com.br/wp-content/uploads/2025/08/banner-institucional-lopes-elegance-v3-1.png' -%}

<section {{ section_attrs }} class="vp-section vp-about-hero relative z-[2] w-full bg-black px-[5%]{% if section_class %} {{ section_class }}{% endif %}">
  <div class="max-w-[1300px] mx-auto flex flex-col items-center text-center">
    <h1 class="font-serif max-w-[693px] pt-[70px] text-[42px] md:text-[70px] font-normal leading-[1.1] text-white">{{ ah_title }}</h1>
    {%- if ah_title_script != blank -%}
    <span class="font-script block mt-[5px] pb-[50px] text-[40px] md:text-[55px] leading-[1.1] tracking-[1px] [text-shadow:0_0_10px_rgb(0_0_0/.3)]" style="color: {{ ah_script_color }};">{{ ah_title_script }}</span>
    {%- endif -%}
    {%- if ah.description != blank -%}
    <p class="md:max-w-[55%] pb-10 text-[15px] leading-[22px] text-[#FCFCFC]">{{ ah.description }}</p>
    {%- endif -%}
    {%- if ah_image != blank -%}
    <img src="{{ ah_image }}" alt="{{ workspace.name }}" class="relative w-full max-w-[600px] md:max-w-[1100px] h-auto -mb-[50px]" fetchpriority="high">
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Sobre nós — abertura",
  "location": "about-us",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Uma história de paixão pelo setor imobiliário," },
    { "type": "text", "id": "title_script", "label": "Destaque manuscrito", "default": "excelência e expertise." },
    { "type": "color", "id": "title_script_color", "label": "Cor do destaque manuscrito", "default": "#E4234F" },
    { "type": "textarea", "id": "description", "label": "Texto" },
    { "type": "image_picker", "id": "image", "label": "Foto institucional" }
  ]
}
{% endschema %}
