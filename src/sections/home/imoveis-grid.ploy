<!-- Section: Featured properties grid (3x2 cards) -->
{% assign properties_list = sections['featured-properties'].properties %}

{% if properties_list.size > 0 %}
<section class="vp-home-properties w-full bg-white pb-16 md:pb-20 xl:pb-24">
  <div class="max-w-screen-2xl mx-auto px-[3%]">
    <!-- Header -->
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between md:gap-10 mb-10 md:mb-14">
      <div>
        <span class="block text-[12px] md:text-[13px] font-medium tracking-[0.16em] text-[#C9A063] mb-4">
          /SELEÇÃO
        </span>
        <h2 class="font-serif text-[28px] md:text-[36px] xl:text-[42px] leading-[1.15] tracking-[-0.01em] text-[#111111] max-w-[560px]">
          Conheça nossa seleção com<br class="hidden md:block">
          os imóveis mais buscados.
        </h2>
      </div>

      <div class="md:shrink-0">
        <a
          href="{{ locale_prefix }}{{ routes.properties }}"
          class="inline-flex items-center justify-center rounded-[4px] bg-[#111111] px-6 py-4 text-[12px] font-semibold uppercase tracking-[0.1em] text-white transition hover:opacity-90"
        >
          Ver todos os imóveis
        </a>
      </div>
    </div>

    <!-- Properties grid -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-5 xl:grid-cols-3">
      {% for property in properties_list limit: 6 %}
        {% assign hero_img = '' %}
        {% if property.images and property.images.size > 0 %}
          {% assign hero_img = property.images[0].url | default: property.images[0] %}
        {% endif %}

        {% assign operation_label = 'Venda' %}
        {% if property.for_rent and property.for_sale == false %}
          {% assign operation_label = 'Locação' %}
        {% endif %}

        {% assign price_text = 'Vendo: valor sob consulta' %}
        {% if property.for_rent and property.for_sale == false %}
          {% if property.rental_price and property.rental_price != 'on_request' and property.rental_price != 'negotiable' %}
            {% assign price_text = 'Aluguel: ' | append: property.rental_price | money_format %}
          {% else %}
            {% assign price_text = 'Aluguel: valor sob consulta' %}
          {% endif %}
        {% else %}
          {% if property.sale_price and property.sale_price != 'on_request' and property.sale_price != 'negotiable' %}
            {% assign price_text = 'Vendo: ' | append: property.sale_price | money_format %}
          {% endif %}
        {% endif %}

        {% assign area_value = property.total_area | default: property.usable_area %}

        <article class="vp-home-property-card group flex flex-col">
          <!-- Image -->
          <a href="{{ routes.property }}/{{ property.sku }}/{{ property.slug }}" class="relative block overflow-hidden rounded-[4px] aspect-[4/5]">
            {% if hero_img != blank %}
              <img
                src="{{ hero_img }}"
                alt="{{ property.title | escape }}"
                class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                loading="lazy"
              >
            {% else %}
              <div class="absolute inset-0 bg-gray-200"></div>
            {% endif %}

            <!-- Operation badge -->
            <span class="absolute top-4 left-4 inline-flex items-center bg-[#C9A063] text-white text-[10px] font-semibold uppercase tracking-[0.12em] px-3 py-1.5 rounded-[2px]">
              {{ operation_label }}
            </span>
          </a>

          <!-- Content -->
          <div class="pt-5">
            <h3 class="font-serif text-[20px] md:text-[22px] leading-[1.2] tracking-[-0.01em] text-[#111111] mb-2">
              <a href="{{ routes.property }}/{{ property.sku }}/{{ property.slug }}" class="hover:opacity-80 transition-opacity">
                {{ property.formatted_title | default: property.title }}
              </a>
            </h3>

            <p class="text-[13px] text-[#6B7280] mb-4">{{ price_text }}</p>

            <!-- Features -->
            <div class="flex items-center gap-5 pb-5 mb-5 border-b border-[#E5E7EB] text-[13px] text-[#6B7280]">
              {% if area_value and area_value > 0 %}
                <div class="flex items-center gap-1.5">
                  <i class="ph ph-ruler text-[#C9A063] text-[16px]"></i>
                  <span>{{ area_value }} m²</span>
                </div>
              {% endif %}

              {% if property.beds and property.beds > 0 %}
                <div class="flex items-center gap-1.5">
                  <i class="ph ph-bed text-[#C9A063] text-[16px]"></i>
                  <span>{{ property.beds }}</span>
                </div>
              {% endif %}

              {% if property.parkings and property.parkings > 0 %}
                <div class="flex items-center gap-1.5">
                  <i class="ph ph-car text-[#C9A063] text-[16px]"></i>
                  <span>{{ property.parkings }}</span>
                </div>
              {% endif %}
            </div>

            <a
              href="{{ routes.property }}/{{ property.sku }}/{{ property.slug }}"
              class="inline-flex items-center justify-center rounded-[4px] border border-[#111111] bg-transparent px-6 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-[#111111] transition hover:bg-[#111111] hover:text-white"
            >
              Mais detalhes
            </a>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
