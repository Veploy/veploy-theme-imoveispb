<!-- Hero Section: dark luxury house with center serif headline + bottom search filter -->
{% assign hero_image = theme_settings.sections.home_hero.image | default: 'https://www.lopeselegance.com.br/wp-content/uploads/2025/08/Banner-home-Lopes-Elegance-comprimido.webp' %}
{% assign hero_title_line_1 = theme_settings.sections.home_hero.title_line_1 | default: 'Explore um universo' %}
{% assign hero_title_line_2 = theme_settings.sections.home_hero.title_line_2 | default: 'de sofisticação em' %}
{% assign hero_title_script = theme_settings.sections.home_hero.title_script | default: 'cada detalhe' %}
{% assign hero_top_bar = theme_settings.sections.home_hero.top_bar | default: 'Compre seu imóvel em até 18 anos sem juros. Fale conosco e saiba mais.' %}

<section class="vp-home-hero relative w-full">
  <!-- Top promo bar -->
  <div class="vp-home-hero__topbar w-full bg-black text-[#C9A063] text-[12px] md:text-[13px] py-2 px-[3%] flex items-center justify-center text-center">
    <span class="font-medium tracking-[0.02em]">{{ hero_top_bar }}</span>
  </div>

  <!-- Hero with background image -->
  <div class="relative w-full overflow-hidden bg-black">
    <!-- Background image -->
    <div class="absolute inset-0 z-0">
      <img
        src="{{ hero_image }}"
        alt="Lopes Elegance"
        class="h-full w-full object-cover"
        fetchpriority="high"
      >
      <!-- Subtle dark overlay so image stays visible while text remains readable -->
      <div class="absolute inset-0 bg-black/30"></div>
      <div class="absolute inset-x-0 bottom-0 h-[35%] bg-gradient-to-t from-black/70 to-transparent"></div>
    </div>

    <!-- Hero content -->
    <div class="relative z-10 flex min-h-[560px] flex-col justify-end px-[3%] py-12 md:min-h-[680px] md:py-16 xl:min-h-[760px]">
      <!-- Centered title -->
      <div class="flex flex-1 items-center justify-center">
        <div class="text-center">
          <h1 class="vp-home-hero__title text-white font-serif font-light leading-[1.0] tracking-[-0.01em] text-[36px] md:text-[64px] xl:text-[80px]">
            <span class="block">{{ hero_title_line_1 }}</span>
            <span class="block">{{ hero_title_line_2 }}</span>
          </h1>
          <span class="vp-home-hero__title-script block mt-1 text-[#CC0E3B] text-[42px] md:text-[68px] xl:text-[84px] leading-none italic"
                style="font-family: 'Born Ready Upright Regular', 'Allura', 'Great Vibes', cursive; letter-spacing: -0.02em;">
            {{ hero_title_script }}
          </span>
        </div>
      </div>

      <!-- Search filter bar at bottom -->
      <div class="mt-10 md:mt-16">
        <form
          method="GET"
          action="{{ locale_prefix }}{{ routes.properties }}"
          class="vp-home-hero__search w-full max-w-screen-2xl mx-auto"
          x-data="{ byCode: false }"
        >
          <div class="grid grid-cols-1 md:grid-cols-[180px_220px_minmax(0,1fr)_180px] gap-3 rounded-[6px] bg-white/95 backdrop-blur-sm p-3 md:p-4">
            <!-- Operação -->
            <div class="md:border-r md:border-[#E5E7EB] md:pr-3" x-show="!byCode">
              <label class="block text-[11px] font-semibold uppercase tracking-[0.06em] text-[#6B7280] mb-1">
                Operação
              </label>
              <select
                name="operation"
                class="w-full bg-transparent text-[14px] text-[#111827] outline-none border-0 p-0 cursor-pointer"
              >
                <option value="sale">Comprar</option>
                <option value="rent">Alugar</option>
              </select>
            </div>

            <!-- Tipo de imóvel -->
            <div class="md:border-r md:border-[#E5E7EB] md:pr-3" x-show="!byCode">
              <label class="block text-[11px] font-semibold uppercase tracking-[0.06em] text-[#6B7280] mb-1">
                Tipo de Imóvel
              </label>
              <select
                name="type"
                class="w-full bg-transparent text-[14px] text-[#111827] outline-none border-0 p-0 cursor-pointer"
              >
                <option value="">Mostrar todos</option>
                {% if property_types %}
                  {% for type in property_types %}
                    <option value="{{ type.slug }}">{{ type.name }}</option>
                  {% endfor %}
                {% endif %}
              </select>
            </div>

            <!-- Localização -->
            <div class="md:pr-3" x-show="!byCode">
              <label class="block text-[11px] font-semibold uppercase tracking-[0.06em] text-[#6B7280] mb-1">
                Localização ou empreendimentos
              </label>
              <input
                type="text"
                name="location"
                placeholder="Faça a sua busca..."
                class="w-full bg-transparent text-[14px] text-[#111827] placeholder:text-[#9CA3AF] outline-none border-0 p-0"
              >
            </div>

            <!-- Code search input -->
            <div class="md:col-span-3 md:pr-3" x-show="byCode" x-cloak>
              <label class="block text-[11px] font-semibold uppercase tracking-[0.06em] text-[#6B7280] mb-1">
                Código do Imóvel
              </label>
              <input
                type="text"
                name="code"
                placeholder="Digite o código do imóvel..."
                class="w-full bg-transparent text-[14px] text-[#111827] placeholder:text-[#9CA3AF] outline-none border-0 p-0"
              >
            </div>

            <!-- Submit button -->
            <button
              type="submit"
              class="vp-home-hero__cta inline-flex items-center justify-center rounded-[4px] bg-[#111111] px-6 py-4 text-[14px] font-semibold uppercase tracking-[0.08em] text-white transition hover:opacity-90"
            >
              Buscar
            </button>
          </div>

          <!-- Search by code toggle -->
          <label class="mt-4 flex items-center gap-2 text-[14px] text-white">
            <input
              type="checkbox"
              x-model="byCode"
              class="h-4 w-4 rounded-[3px] border border-white/60 bg-transparent accent-[#C9A063]"
            >
            <span>Buscar pelo código do imóvel</span>
          </label>
        </form>
      </div>
    </div>
  </div>
</section>
