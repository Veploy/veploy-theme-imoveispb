<!-- Section: Property categories grid (Casas em condomínio, Apartamentos, Permuta, Comerciais) -->
{% assign categories = theme_settings.sections.shortcuts-grid.shortcuts.items %}

<section class="vp-home-categories w-full bg-white py-16 md:py-20 xl:py-24">
  <div class="max-w-screen-2xl mx-auto px-[3%]">
    <!-- Header row -->
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between md:gap-10 mb-10 md:mb-14">
      <div>
        <span class="block text-[12px] md:text-[13px] font-medium tracking-[0.16em] text-[#C9A063] mb-4">
          /SELEÇÃO
        </span>
        <h2 class="font-serif text-[28px] md:text-[36px] xl:text-[42px] leading-[1.15] tracking-[-0.01em] text-[#111111] max-w-[560px]">
          Conheça nossa seleção com<br class="hidden md:block">
          os imóveis mais buscados.
        </h2>
      </div>

      <div class="md:shrink-0">
        <a
          href="{{ locale_prefix }}{{ routes.properties }}"
          class="inline-flex items-center justify-center rounded-[4px] bg-[#111111] px-6 py-4 text-[12px] font-semibold uppercase tracking-[0.1em] text-white transition hover:opacity-90"
        >
          Ver todos os imóveis
        </a>
      </div>
    </div>

    <!-- Categories grid -->
    <div class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-5">
      {% for category in categories %}
        <a
          href="{{ category.url | replace: '{{routes.properties}}', routes.properties | replace: '{{routes.operation_sale}}', routes.operation_sale | replace: '{{routes.operation_rent}}', routes.operation_rent | prepend: locale_prefix }}"
          class="vp-home-category group relative block overflow-hidden rounded-[4px] aspect-[3/4]"
        >
          <img
            src="{{ category.image }}"
            alt="{{ category.title }}"
            class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]"
            loading="lazy"
          >
          <!-- Bottom dark gradient -->
          <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black/70 to-transparent"></div>

          <!-- Title -->
          <div class="absolute inset-x-0 bottom-0 p-4 md:p-5">
            <span class="block text-center text-white text-[14px] md:text-[15px] font-medium tracking-wide">
              {{ category.title }}
            </span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
