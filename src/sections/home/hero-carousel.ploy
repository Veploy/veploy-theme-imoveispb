{%- comment -%}
  Banner principal.

  No original é um container de 100vh com vídeo de fundo (`background_video_link`),
  véu `#02010133` por cima, título centralizado em Reckless Neue 58px — com o
  trecho do meio em itálico — e, encostada embaixo, a barra de busca horizontal
  em campos transparentes com borda só embaixo.
{%- endcomment -%}
{%- assign hero = sections['home/hero-carousel'] -%}
{%- assign slide = hero.slides.items[0] -%}
{%- assign hero_image = slide.image_desktop -%}
{%- assign hero_image_mobile = slide.image_mobile | default: hero_image -%}
{%- assign hero_overlay = hero.overlay_color | default: '#02010133' -%}

<style>
  .pb-hero__title {
    font-family: var(--font-heading);
    font-size: 58px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -1.3px;
    color: #fff;
    text-shadow: 0 0 22px rgba(0, 0, 0, .65);
    max-width: 820px;
  }
  .pb-hero__title i, .pb-hero__title em { font-style: italic; }
  @media (max-width: 1024px) { .pb-hero__title { font-size: 44px; } }
  @media (max-width: 767px)  { .pb-hero__title { font-size: 32px; letter-spacing: -.5px; } }

  .pb-hero__label {
    display: block;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    color: #fff;
    margin-bottom: 6px;
  }
  /* Campos sem caixa: só a linha de baixo, como no original */
  .pb-hero__field {
    width: 100%;
    min-height: 42px;
    background: transparent;
    border: 0;
    border-bottom: 1px solid rgba(255, 255, 255, .7);
    border-radius: 0;
    color: #fff;
    font-size: 15px;
    padding: 8px 2px;
    outline: none;
    transition: border-color .2s;
  }
  .pb-hero__field::placeholder { color: rgba(255, 255, 255, .85); opacity: 1; }
  .pb-hero__field:focus { border-bottom-color: #fff; }
  /* O campo é branco sobre o vídeo, mas a lista aberta é fundo claro:
     a opção precisa da cor escura explícita (ver também a regra global
     de `select` em main.css). */
  .pb-hero__field { color-scheme: light; }
  .pb-hero__field option { color: #181A20; background-color: #fff; }

  .pb-hero__submit {
    width: 100%;
    min-height: 50px;
    max-height: 60px;
    height: 50px;
    background: {{ theme_settings.header.button_bg_color | default: '#E7E0D2' }};
    color: #181A20;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: .2px;
    text-transform: uppercase;
    border: 0;
    border-radius: 4px;
    transition: background-color .2s;
  }
  .pb-hero__submit:hover { background: {{ theme_settings.header.button_hover_bg_color | default: '#F0EBE2' }}; }

  .pb-hero__sku-label { color: #fff; font-size: 14px; font-weight: 400; }

  /* Painel atrás da busca: preto translúcido, deixa o vídeo aparecer por baixo */
  .pb-hero__panel {
    background-color: rgb(2 1 1 / .42);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    border: 1px solid rgb(255 255 255 / .12);
    border-radius: 8px;
    padding: 22px 24px 20px;
  }
  @media (max-width: 767px) {
    .pb-hero__panel { padding: 18px 16px 16px; }
  }

  @media (min-width: 1025px) {
    .pb-hero__form { display: grid; grid-template-columns: .8fr .8fr 1.4fr 150px; gap: 15px; align-items: end; }
  }
</style>

<section {{ section_attrs }} class="pb-hero relative w-full overflow-hidden bg-black{% if section_class %} {{ section_class }}{% endif %}">
  {%- comment -%} Fundo: vídeo quando houver, senão a imagem {%- endcomment -%}
  <div class="absolute inset-0 z-0">
    {%- if slide.video_desktop != blank -%}
      <video class="h-full w-full object-cover" autoplay muted loop playsinline preload="metadata"{% if hero_image != blank %} poster="{{ hero_image }}"{% endif %}>
        <source src="{{ slide.video_desktop }}" type="video/mp4">
      </video>
    {%- elsif hero_image != blank -%}
      <picture>
        <source media="(max-width: 767px)" srcset="{{ hero_image_mobile }}">
        <img src="{{ hero_image }}" alt="{{ workspace.name }}" class="h-full w-full object-cover" fetchpriority="high">
      </picture>
    {%- endif -%}
    <div class="absolute inset-0" style="background-color: {{ hero_overlay }};"></div>
  </div>

  <div class="relative z-10 flex min-h-[640px] h-[100svh] flex-col justify-end px-[5%] pb-[8%] pt-[160px]">
    {%- if hero.title != blank or hero.title_italic != blank %}
    <h1 class="pb-hero__title mx-auto text-center pb-[50px]">
      {{- hero.title }}{% if hero.title_italic != blank %} <i>{{ hero.title_italic }}</i>{% endif %}{% if hero.title_after != blank %} {{ hero.title_after }}{% endif -%}
    </h1>
    {%- endif %}

    {%- comment -%} Barra de busca: mesma ação e nomes de campo da listagem {%- endcomment -%}
    <form
      method="GET"
      action="{{ locale_prefix }}{{ routes.properties }}"
      class="pb-hero__panel w-full max-w-[950px] mx-auto"
      x-data="{ byCode: false }"
    >
      <div class="pb-hero__form flex flex-col gap-4">
        <div x-show="!byCode">
          <label class="pb-hero__label" for="pb-hero-operation">Operação</label>
          <select id="pb-hero-operation" name="operation" class="pb-hero__field cursor-pointer">
            <option value="sale">Comprar</option>
            <option value="rent">Alugar</option>
          </select>
        </div>

        <div x-show="!byCode">
          <label class="pb-hero__label" for="pb-hero-type">Tipo do imóvel</label>
          <select id="pb-hero-type" name="type" class="pb-hero__field cursor-pointer">
            <option value="">Mostrar todos</option>
            {%- for type in property_types %}
            <option value="{{ type.slug }}">{{ type.name }}</option>
            {%- endfor %}
          </select>
        </div>

        <div x-show="!byCode">
          <label class="pb-hero__label" for="pb-hero-location">Localização ou empreendimento</label>
          <input id="pb-hero-location" type="text" name="location" placeholder="Faça a sua busca..." class="pb-hero__field">
        </div>

        <div class="lg:col-span-3" x-show="byCode" x-cloak>
          <label class="pb-hero__label" for="pb-hero-sku">Código do imóvel</label>
          <input id="pb-hero-sku" type="text" name="sku" placeholder="Ex: 418382, 928492" class="pb-hero__field">
          <span class="block mt-1.5 text-[12px] leading-[1.3] text-white/70">Para buscar múltiplos imóveis, digite os códigos separados por vírgula.</span>
        </div>

        <div>
          <button type="submit" class="pb-hero__submit">Buscar</button>
        </div>
      </div>

      {%- comment -%} Caixa "Buscar pelo código": quadrado branco que vira escuro ao marcar {%- endcomment -%}
      <label class="group mt-3 flex items-center gap-2 cursor-pointer w-fit">
        <span class="relative inline-flex">
          <input type="checkbox" x-model="byCode" class="peer h-5 w-5 appearance-none rounded-[3px] border border-white/80 bg-white cursor-pointer checked:bg-[#181A20] checked:border-white">
          <svg class="pointer-events-none absolute inset-0 m-auto hidden h-3 w-3 text-white peer-checked:block" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5"/></svg>
        </span>
        <span class="pb-hero__sku-label transition-opacity group-hover:opacity-80">Buscar pelo código do imóvel</span>
      </label>
    </form>
  </div>
</section>

{% schema %}
{
  "name": "Banner principal",
  "location": "home",
  "settings": [
    { "type": "text", "id": "title", "label": "Título — antes do destaque", "default": "Conectamos você ao" },
    { "type": "text", "id": "title_italic", "label": "Título — trecho em itálico", "default": "imóvel ideal" },
    { "type": "text", "id": "title_after", "label": "Título — depois do destaque", "default": "em Campo Grande e região." },
    { "type": "color", "id": "overlay_color", "label": "Véu sobre o vídeo/foto", "default": "#02010133" },
    {
      "type": "repeater",
      "id": "slides",
      "label": "Banner",
      "max_items": 1,
      "settings": [
        { "type": "image_picker", "id": "image_desktop", "label": "Imagem desktop (capa do vídeo)" },
        { "type": "image_picker", "id": "image_mobile", "label": "Imagem mobile" },
        { "type": "url", "id": "video_desktop", "label": "Vídeo (MP4)" },
        { "type": "url", "id": "redirect_url", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}
