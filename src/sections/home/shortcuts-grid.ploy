{%- comment -%}
  "Mais buscados": três cartões de bairro/empreendimento.

  No original a faixa tem um degradê branco → #F8F8F8, a foto fica dentro de uma
  moldura bege de 6px com 70vh de altura e o nome do bairro aparece embaixo da
  foto em Reckless Neue 30px. No celular o cabeçalho é centralizado, o link
  "Ver mais imóveis" some e as fotos ficam com 300px de altura.
{%- endcomment -%}
{%- assign s = sections['home/shortcuts-grid'] -%}
{%- assign _cta_url = s.cta_url | replace: '{{routes.properties}}', routes.properties | replace: '{{routes.operation_sale}}', routes.operation_sale | replace: '{{routes.operation_rent}}', routes.operation_rent | replace: '{{routes.about-us}}', routes['about-us'] | replace: '{{routes.contact}}', routes.contact -%}
{%- unless _cta_url contains '://' or _cta_url == blank -%}{%- assign _cta_url = locale_prefix | append: _cta_url -%}{%- endunless -%}
{%- assign items = s.shortcuts.items | default: empty -%}

<style>
  .pb-shortcuts { background-image: linear-gradient(180deg, #FFFFFF 0%, #F8F8F8 100%); }
  .pb-shortcuts__frame {
    background-color: #E7E0D2;
    border: 6px solid #E0D6C4;
    border-radius: 4px;
    overflow: hidden;
  }
  .pb-shortcuts__img {
    width: 100%;
    height: 70vh;
    min-height: 420px;
    object-fit: cover;
    object-position: center;
    border-radius: 3px;
    transition: transform 1s;
  }
  .pb-shortcuts__card:hover .pb-shortcuts__img { transform: scale(1.04); }
  .pb-shortcuts__name {
    font-family: var(--font-heading);
    font-size: 30px;
    font-weight: 300;
    line-height: 1.2em;
    color: #666158;
    padding-top: 20px;
  }
  @media (max-width: 1024px) {
    .pb-shortcuts__img { height: 46vh; min-height: 320px; }
    .pb-shortcuts__name { font-size: 25px; }
  }
  @media (max-width: 767px) {
    .pb-shortcuts__img { height: 300px; min-height: 0; }
    .pb-shortcuts__name { font-size: 25px; line-height: 1.3em; }
  }
</style>

<section {{ section_attrs }} class="pb-shortcuts pb-section{% if section_class %} {{ section_class }}{% endif %}">
  <div class="pb-container !mb-0 pt-[60px] md:pt-[100px] pb-[80px]">
    {% include 'components/home-section-header',
       eyebrow: s.eyebrow,
       heading: s.title,
       heading_highlight: s.title_highlight,
       cta_text: s.cta_text,
       cta_url: _cta_url,
       align: 'center-mobile' %}

    {%- if items != empty and items.size > 0 %}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mt-[29px]">
      {%- for item in items -%}
      {%- assign _url = item.url | replace: '{{routes.properties}}', routes.properties | replace: '{{routes.operation_sale}}', routes.operation_sale | replace: '{{routes.operation_rent}}', routes.operation_rent -%}
      <a href="{% unless _url contains '://' %}{{ locale_prefix }}{% endunless %}{{ _url }}" class="pb-shortcuts__card block group">
        <div class="pb-shortcuts__frame">
          <img src="{{ item.image }}" alt="{{ item.title }}" class="pb-shortcuts__img" loading="lazy" width="1020" height="1530">
        </div>
        <h3 class="pb-shortcuts__name">{{ item.title }}</h3>
      </a>
      {%- endfor -%}
    </div>
    {%- endif %}
  </div>
</section>

{% schema %}
{
  "name": "Mais buscados",
  "location": "home",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "mais buscados" },
    { "type": "text", "id": "title", "label": "Título", "default": "Os empreendimentos e bairros mais buscados de" },
    { "type": "text", "id": "title_highlight", "label": "Título — trecho em destaque", "default": "Campo Grande e região." },
    { "type": "text", "id": "cta_text", "label": "Texto do link", "default": "Ver mais imóveis" },
    { "type": "url", "id": "cta_url", "label": "Link", "default": "/imoveis" },
    {
      "type": "repeater",
      "id": "shortcuts",
      "label": "Cartões",
      "max_items": 3,
      "settings": [
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "image_picker", "id": "image", "label": "Imagem" },
        { "type": "url", "id": "url", "label": "URL" }
      ]
    }
  ]
}
{% endschema %}
