<!-- Condição especial (Elegance): texto 40% em fundo creme + imagem 60% -->
{%- assign promo = sections['home/promotion'] -%}
{%- assign promo_eyebrow = promo.eyebrow | default: '/Condição Especial' -%}
{%- assign promo_title = promo.title | default: 'Compre seu imóvel em até 18 anos sem juros.' -%}
{%- assign promo_cta_text = promo.cta_text | default: 'Falar com um consultor' -%}
{%- assign promo_bg = promo.bg_color | default: '#FFF9F0' -%}
{%- assign promo_image = promo.image | default: 'https://www.lopeselegance.com.br/wp-content/uploads/2025/08/1.jpg' -%}
{%- assign _wa = theme_settings.contact.whatsapp | remove: '-' | remove: '(' | remove: ')' | remove: ' ' -%}
{%- assign whatsapp_url = promo.cta_url | default: theme_settings.contact.whatsapp_link | default: '' -%}
{%- if whatsapp_url == '' -%}{%- assign whatsapp_url = 'https://wa.me/55' | append: _wa -%}{%- endif -%}

<section {{ section_attrs }} class="vp-section vp-home-promotion w-full flex flex-col md:flex-row{% if section_class %} {{ section_class }}{% endif %}" style="background-color: {{ promo_bg }};">
  <div class="w-full md:w-[40%] px-[5%] md:px-[30px] py-[80px] md:py-[130px] flex flex-col justify-center">
    <span class="vp-eyebrow text-[#181A20] pb-[10px]">{{ promo_eyebrow }}</span>
    <h2 class="font-serif text-[32px] md:text-[42px] font-semibold leading-[1.1] tracking-[1px] text-[#181A20] mb-5">{{ promo_title }}</h2>
    {%- if promo.description != blank -%}
    <div class="text-[15px] leading-[22px] text-[#181A20] mb-10">{{ promo.description }}</div>
    {%- endif -%}
    <div>
      <a href="{{ whatsapp_url }}" target="_blank" rel="noopener" class="vp-btn bg-[#181A20] text-white border-[#181A20] hover:bg-white hover:text-black">
        <i class="ph ph-whatsapp-logo text-[16px]"></i>
        {{ promo_cta_text }}
      </a>
    </div>
  </div>
  <div class="w-full md:w-[60%] min-h-[360px] bg-cover bg-center" style="background-image: url('{{ promo_image }}');" role="img" aria-label="{{ promo_title }}"></div>
</section>

{% schema %}
{
  "name": "Condição especial",
  "location": "home",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "/Condição Especial" },
    { "type": "text", "id": "title", "label": "Título", "default": "Compre seu imóvel em até 18 anos sem juros." },
    { "type": "richtext", "id": "description", "label": "Descrição" },
    { "type": "text", "id": "cta_text", "label": "Texto do botão", "default": "Falar com um consultor" },
    { "type": "url", "id": "cta_url", "label": "Link do botão", "info": "Vazio = WhatsApp da imobiliária" },
    { "type": "color", "id": "bg_color", "label": "Cor de fundo", "default": "#FFF9F0" },
    { "type": "image_picker", "id": "image", "label": "Imagem" }
  ]
}
{% endschema %}
