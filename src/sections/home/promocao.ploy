<!-- Section: /PROMOÇÃO ESPECIAL — 18 anos sem juros + image right -->
{% assign promo = theme_settings.sections.promocao %}
{% assign promo_title = promo.title | default: 'Compre seu imóvel em até 18 anos sem juros.' %}
{% assign promo_description = promo.description | default: 'Na Lopes Elegance, entendemos que adquirir o imóvel dos seus sonhos é um passo importante na vida de qualquer pessoa. Por isso, oferecemos uma oportunidade única: você pode conquistar o seu lar com financiamento facilitado em até 18 anos sem juros! Essa é uma oportunidade exclusiva para quem busca realizar o sonho da casa própria sem se preocupar com altas taxas de juros e parcelas extensas. Com a Lopes Elegance, você terá o suporte de profissionais qualificados e um atendimento personalizado para encontrar o imóvel ideal para você e sua família.' %}
{% assign promo_image = promo.image | default: 'https://www.lopeselegance.com.br/wp-content/uploads/2025/08/banner-home-18-anos-sem-juros.jpg' %}
{%- assign _wa = theme_settings.contact.whatsapp | remove: '-' | remove: '(' | remove: ')' | remove: ' ' -%}
{%- assign whatsapp_url = theme_settings.contact.whatsapp_link | default: '' -%}
{%- if whatsapp_url == '' -%}
  {%- assign whatsapp_url = 'https://wa.me/55' | append: _wa -%}
{%- endif -%}

<section class="vp-home-promocao w-full bg-white py-16 md:py-20 xl:py-24">
  <div class="max-w-screen-2xl mx-auto px-[3%]">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-14 xl:gap-20 items-center">
      <!-- Left: text -->
      <div>
        <span class="block text-[12px] md:text-[13px] font-medium tracking-[0.16em] text-[#C9A063] mb-5">
          /PROMOÇÃO ESPECIAL
        </span>

        <h2 class="font-serif text-[26px] md:text-[36px] xl:text-[42px] leading-[1.15] tracking-[-0.01em] text-[#111111] mb-7 max-w-[520px]">
          {{ promo_title }}
        </h2>

        <p class="text-[14px] md:text-[15px] leading-[1.7] text-[#5C5C5C] mb-8 max-w-[520px]">
          {{ promo_description }}
        </p>

        <a
          href="{{ whatsapp_url }}"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-3 rounded-[4px] bg-[#111111] px-7 py-4 text-[12px] font-semibold uppercase tracking-[0.1em] text-white transition hover:opacity-90"
        >
          <i class="ph ph-whatsapp-logo text-[16px]"></i>
          Falar com um consultor
        </a>
      </div>

      <!-- Right: image -->
      <div class="relative overflow-hidden rounded-[4px] aspect-[4/5] lg:aspect-[5/6]">
        <img
          src="{{ promo_image }}"
          alt="{{ promo_title }}"
          class="absolute inset-0 h-full w-full object-cover"
          loading="lazy"
        >
      </div>
    </div>
  </div>
</section>
