<!-- Section: Fale Conosco — dark left + form right + contact info row -->
{%- assign _wa = theme_settings.contact.whatsapp | remove: '-' | remove: '(' | remove: ')' | remove: ' ' -%}
{%- assign whatsapp_url = theme_settings.contact.whatsapp_link | default: '' -%}
{%- if whatsapp_url == '' -%}
  {%- assign whatsapp_url = 'https://wa.me/55' | append: _wa -%}
{%- endif -%}

<section class="vp-home-falecon w-full">
  <!-- Top: dark band + form -->
  <div class="relative bg-[#111111]">
    <div class="max-w-screen-2xl mx-auto px-[3%] py-14 md:py-20 xl:py-24">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_1.05fr] lg:gap-14 xl:gap-20 items-start">
        <!-- Left: title + WhatsApp CTA -->
        <div class="lg:pt-2">
          <span class="block text-[12px] md:text-[13px] font-medium tracking-[0.16em] text-[#C9A063] mb-5">
            /FALE CONOSCO
          </span>

          <h2 class="font-serif text-[26px] md:text-[36px] xl:text-[42px] leading-[1.15] tracking-[-0.01em] text-white mb-6 max-w-[560px]">
            Assistência completa para venda, compra, locação e financiamento de imóveis.
          </h2>

          <p class="text-[14px] md:text-[15px] leading-[1.7] text-white/70 mb-8 max-w-[480px]">
            Envie-nos uma mensagem e um dos nossos consultores entrará em contato com você. Será um prazer lhe atender!
          </p>

          <a
            href="{{ whatsapp_url }}"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-3 rounded-[4px] border border-white px-7 py-4 text-[12px] font-semibold uppercase tracking-[0.1em] text-white transition hover:bg-white hover:text-[#111111]"
          >
            <i class="ph ph-whatsapp-logo text-[18px]"></i>
            Chamar no WhatsApp
          </a>
        </div>

        <!-- Right: white form card -->
        <div class="bg-white rounded-[4px] px-6 py-8 md:px-10 md:py-12 lg:px-12 shadow-[0_30px_80px_rgba(0,0,0,0.25)]">
          {% form 'contact' %}
            <div class="space-y-6">
              <div>
                <label class="block text-[13px] font-semibold text-[#111111] mb-2">Nome</label>
                <input
                  type="text"
                  name="contact[name]"
                  required
                  placeholder="Nome completo"
                  class="h-[48px] w-full rounded-[4px] border border-[#E5E7EB] bg-white px-4 text-[14px] text-[#111111] placeholder:text-[#9CA3AF] outline-none transition focus:border-[#C9A063]"
                >
              </div>

              <div>
                <label class="block text-[13px] font-semibold text-[#111111] mb-2">E-mail</label>
                <input
                  type="email"
                  name="contact[email]"
                  required
                  placeholder="Seu melhor e-mail"
                  class="h-[48px] w-full rounded-[4px] border border-[#E5E7EB] bg-white px-4 text-[14px] text-[#111111] placeholder:text-[#9CA3AF] outline-none transition focus:border-[#C9A063]"
                >
              </div>

              <div>
                <label class="block text-[13px] font-semibold text-[#111111] mb-2">Telefone com DDD</label>
                {% include 'components/global/form/phone-input',
                  name: 'contact[phone]',
                  placeholder: '(99) 99999-9999',
                  classes: 'h-[48px] w-full rounded-[4px] border border-[#E5E7EB] bg-white px-4 text-[14px] text-[#111111] placeholder:text-[#9CA3AF] outline-none transition focus:border-[#C9A063]'
                %}
              </div>

              <div>
                <label class="block text-[13px] font-semibold text-[#111111] mb-2">Selecione a forma de contato desejada</label>
                <select
                  name="contact[contact_method]"
                  class="h-[48px] w-full rounded-[4px] border border-[#E5E7EB] bg-white px-4 text-[14px] text-[#111111] outline-none transition focus:border-[#C9A063]"
                >
                  <option value="phone">Telefone</option>
                  <option value="whatsapp">WhatsApp</option>
                  <option value="email">E-mail</option>
                </select>
              </div>

              <div>
                <label class="block text-[13px] font-semibold text-[#111111] mb-2">Possui alguma informação adicional?</label>
                <textarea
                  name="contact[message]"
                  rows="4"
                  placeholder="Escreva aqui sua mensagem"
                  class="min-h-[120px] w-full rounded-[4px] border border-[#E5E7EB] bg-white px-4 py-3 text-[14px] text-[#111111] placeholder:text-[#9CA3AF] outline-none transition focus:border-[#C9A063] resize-none"
                ></textarea>
              </div>

              {% if workspace.settings.turnstile.enabled %}
                <div class="cf-turnstile" data-sitekey="{{ workspace.settings.turnstile.site_key }}"></div>
              {% endif %}

              <button
                type="submit"
                class="w-full inline-flex items-center justify-center rounded-[4px] bg-[#111111] px-6 py-4 text-[12px] font-semibold uppercase tracking-[0.12em] text-white transition hover:opacity-90"
              >
                Enviar
              </button>
            </div>
          {% endform %}
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom: contact info row -->
  <div class="bg-white py-12 md:py-16">
    <div class="max-w-screen-2xl mx-auto px-[3%]">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_1fr] lg:gap-14 items-start">
        <!-- Left: Fale conosco list -->
        <div>
          <h3 class="font-serif text-[24px] md:text-[28px] leading-[1.15] text-[#111111] mb-6">Fale conosco</h3>

          <ul class="space-y-3 text-[14px] text-[#5C5C5C]">
            {% if theme_settings.contact.phone != blank %}
            <li class="flex items-center gap-3">
              <i class="ph ph-phone text-[#C9A063] text-[16px]"></i>
              <a href="tel:{{ theme_settings.contact.phone | remove: '-' | remove: '(' | remove: ')' | remove: ' ' }}" class="hover:text-[#111111] transition-colors">
                {{ theme_settings.contact.phone }}
              </a>
            </li>
            {% endif %}

            {% if theme_settings.contact.whatsapp != blank %}
            <li class="flex items-center gap-3">
              <i class="ph ph-whatsapp-logo text-[#C9A063] text-[16px]"></i>
              <a href="{{ whatsapp_url }}" target="_blank" rel="noopener" class="hover:text-[#111111] transition-colors">
                {{ theme_settings.contact.whatsapp }}
              </a>
            </li>
            {% endif %}

            {% if theme_settings.contact.email != blank %}
            <li class="flex items-center gap-3">
              <i class="ph ph-envelope text-[#C9A063] text-[16px]"></i>
              <a href="mailto:{{ theme_settings.contact.email }}" class="hover:text-[#111111] transition-colors">
                {{ theme_settings.contact.email }}
              </a>
            </li>
            {% endif %}

            {% if theme_settings.contact.address != blank %}
            <li class="flex items-start gap-3">
              <i class="ph ph-map-pin text-[#C9A063] text-[16px] mt-0.5"></i>
              <span>{{ theme_settings.contact.address }}</span>
            </li>
            {% endif %}

            {% if theme_settings.contact.hours != blank %}
            <li class="flex items-start gap-3">
              <i class="ph ph-clock text-[#C9A063] text-[16px] mt-0.5"></i>
              <span>{{ theme_settings.contact.hours }}</span>
            </li>
            {% endif %}
          </ul>

          <!-- Social icons -->
          <div class="mt-6 flex items-center gap-2">
            {% if theme_settings.contact.facebook != blank %}
            <a href="{{ theme_settings.contact.facebook }}" target="_blank" rel="noopener" class="w-9 h-9 rounded-[4px] border border-[#E5E7EB] flex items-center justify-center text-[#111111] hover:bg-[#111111] hover:text-white transition-colors" aria-label="Facebook">
              <i class="ph ph-facebook-logo text-[16px]"></i>
            </a>
            {% endif %}
            {% if theme_settings.contact.instagram != blank %}
            <a href="{{ theme_settings.contact.instagram }}" target="_blank" rel="noopener" class="w-9 h-9 rounded-[4px] border border-[#E5E7EB] flex items-center justify-center text-[#111111] hover:bg-[#111111] hover:text-white transition-colors" aria-label="Instagram">
              <i class="ph ph-instagram-logo text-[16px]"></i>
            </a>
            {% endif %}
            {% if theme_settings.contact.linkedin != blank %}
            <a href="{{ theme_settings.contact.linkedin }}" target="_blank" rel="noopener" class="w-9 h-9 rounded-[4px] border border-[#E5E7EB] flex items-center justify-center text-[#111111] hover:bg-[#111111] hover:text-white transition-colors" aria-label="LinkedIn">
              <i class="ph ph-linkedin-logo text-[16px]"></i>
            </a>
            {% endif %}
            {% if theme_settings.contact.youtube != blank %}
            <a href="{{ theme_settings.contact.youtube }}" target="_blank" rel="noopener" class="w-9 h-9 rounded-[4px] border border-[#E5E7EB] flex items-center justify-center text-[#111111] hover:bg-[#111111] hover:text-white transition-colors" aria-label="YouTube">
              <i class="ph ph-youtube-logo text-[16px]"></i>
            </a>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
