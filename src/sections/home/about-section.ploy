{%- comment -%}
  "Sobre nós" da home: título à esquerda, texto numa coluna de 500px à direita
  e, logo abaixo, uma foto de 85vh na largura do container — como no original.

  Medidas do original: 100px no topo (60px no celular); sobretítulo e texto
  alinhados pelo topo; foto 70px abaixo do texto (40px no celular, com 400px de
  altura). A seção termina no pé da foto.
{%- endcomment -%}
{%- assign s = sections['home/about-section'] -%}
<style>
  .pb-about__image {
    position: relative;
    height: 85vh;
    border-radius: 4px;
    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
    overflow: hidden;
  }
  .pb-about__image::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(180deg, #02010100 0%, #000000 100%);
  }
  .pb-about__text { font-family: var(--font-body); font-size: 15px; line-height: 22px; color: #717171; }
  .pb-about__text p + p { margin-top: 1em; }
  @media (min-width: 1367px) { .pb-about__image { background-attachment: fixed; } }
  @media (max-width: 1024px)  { .pb-about__image { height: 55vh; } }
  @media (max-width: 767px)   { .pb-about__image { height: 400px; } }
</style>

<section {{ section_attrs }} class="pb-about pb-section bg-white{% if section_class %} {{ section_class }}{% endif %}">
  <div class="mx-auto max-w-[1300px] pt-[60px] md:pt-[100px]">
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-[minmax(0,1fr)_500px] lg:gap-[150px] lg:items-start">
      {% include 'components/home-section-header',
         eyebrow: s.eyebrow,
         heading: s.title,
         heading_highlight: s.title_highlight %}
      {%- if s.description != blank %}
      <div class="pb-about__text w-full max-w-[500px] ml-auto">{{ s.description }}</div>
      {%- endif %}
    </div>
    {%- if s.image != blank %}
    <div class="pb-about__image mt-[40px] lg:mt-[70px]" style="background-image: url('{{ s.image }}');" role="img" aria-label="{{ workspace.name }}"></div>
    {%- endif %}
  </div>
</section>

{% schema %}
{
  "name": "Sobre nós (home)",
  "location": "home",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "sobre nós" },
    { "type": "text", "id": "title", "label": "Título", "default": "Mais que uma imobiliária," },
    { "type": "text", "id": "title_highlight", "label": "Título — trecho em destaque" },
    { "type": "richtext", "id": "description", "label": "Texto" },
    { "type": "image_picker", "id": "image", "label": "Foto da faixa" }
  ]
}
{% endschema %}
