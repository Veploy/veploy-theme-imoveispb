{%- comment -%}
  "Sobre nós" da home: título à esquerda, texto numa coluna estreita à direita
  e, logo abaixo, uma foto de 85vh que ocupa toda a largura do container, com
  degradê para preto no pé — como no original.
{%- endcomment -%}
{%- assign s = sections['home/about-section'] -%}

<style>
  .pb-about__image {
    position: relative;
    min-height: 85vh;
    border-radius: 4px;
    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
    overflow: hidden;
  }
  .pb-about__image::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(180deg, #02010100 0%, #000000 100%);
  }
  @media (min-width: 1367px) { .pb-about__image { background-attachment: fixed; } }
  @media (max-width: 1024px)  { .pb-about__image { min-height: 55vh; } }
</style>

<section {{ section_attrs }} class="pb-about pb-section bg-white{% if section_class %} {{ section_class }}{% endif %}">
  <div class="pb-container pt-[100px] pb-[50px]">
    <div class="flex flex-col lg:flex-row lg:items-end gap-8 lg:gap-10">
      <div class="lg:flex-1">
        {% include 'components/home-section-header',
           eyebrow: s.eyebrow,
           heading: s.title,
           heading_highlight: s.title_highlight %}
      </div>

      {%- if s.description != blank %}
      <div class="lg:max-w-[500px] lg:self-end">
        <div class="pb-text">{{ s.description }}</div>
      </div>
      {%- endif %}
    </div>
  </div>

  {%- if s.image != blank %}
  <div class="pb-container pb-[20px]">
    <div class="pb-about__image" style="background-image: url('{{ s.image }}');" role="img" aria-label="{{ workspace.name }}"></div>
  </div>
  {%- endif %}
</section>

{% schema %}
{
  "name": "Sobre nós (home)",
  "location": "home",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "sobre nós" },
    { "type": "text", "id": "title", "label": "Título", "default": "Mais que uma imobiliária," },
    { "type": "text", "id": "title_highlight", "label": "Título — trecho em destaque" },
    { "type": "richtext", "id": "description", "label": "Texto" },
    { "type": "image_picker", "id": "image", "label": "Foto da faixa" }
  ]
}
{% endschema %}
