<!-- Sobre (Elegance): faixa preta "/ Quem somos" + bloco "/Alto padrão" com imagem -->
{%- assign about = sections['home/about-section'] -%}
{%- assign about_eyebrow = about.eyebrow | default: '/ Quem somos' -%}
{%- assign about_title = about.title | default: 'Descubra a chave do seu novo lar com a imobiliária que transforma sonhos em endereços!' -%}
{%- assign about_sub_eyebrow = about.subtitle_eyebrow | default: '/Alto padrão' -%}
{%- assign about_subtitle = about.subtitle | default: 'Assistência completa para venda, compra, locação e financiamento de imóveis.' -%}
{%- assign about_cta_text = about.cta_text | default: 'Conheça nossa história' -%}
{%- assign about_cta_url = about.cta_url | default: routes.about -%}
{%- assign about_image = about.image | default: 'https://www.lopeselegance.com.br/wp-content/uploads/2025/08/Banner-home-sobre-nos.png' -%}

<section {{ section_attrs }} class="vp-section vp-home-about w-full{% if section_class %} {{ section_class }}{% endif %}">
  <!-- / Quem somos -->
  <div class="relative flex flex-col items-center">
    <div class="relative z-[3] -mb-[50px] rounded-full bg-white px-[10px] pt-[10px] leading-none">
      <svg xmlns="http://www.w3.org/2000/svg" height="48" viewBox="0 -960 960 960" width="48" aria-hidden="true"><path d="M480-229.231 267.692-441.538l22-22.001L480-272.462l190.308-191.077 22 22.001L480-229.231Zm0-244.538L267.692-686.077l22-22L480-517l190.308-191.077 22 22L480-473.769Z"/></svg>
    </div>
    <div class="w-full bg-black p-[50px] text-center">
      <span class="vp-eyebrow text-[#FBFBFB] pb-[10px]">{{ about_eyebrow }}</span>
      <h2 class="font-serif mx-auto md:max-w-[74%] pb-5 text-[26px] md:text-[34px] font-bold leading-[1.1] tracking-[1px] text-white">{{ about_title }}</h2>
      <span class="font-serif block text-[34px] font-bold leading-[1.1] text-white/[.16]" aria-hidden="true">|</span>
    </div>
  </div>

  <!-- /Alto padrão -->
  <div class="bg-white px-[5%]">
    <div class="max-w-[1300px] mx-auto flex flex-col lg:flex-row pt-[50px] pb-[80px] gap-10 lg:gap-0">
      <div class="w-full lg:w-1/2 lg:pr-[60px] flex flex-col justify-center">
        <span class="vp-eyebrow text-[#646464] pb-[10px]">{{ about_sub_eyebrow }}</span>
        <h2 class="font-serif text-[26px] md:text-[34px] font-medium leading-[1.1] tracking-[1px] text-black">{{ about_subtitle }}</h2>
        <hr class="my-[30px] border-0 border-t border-black">
        {%- if about.description != blank -%}
        <div class="text-[15px] leading-[22px] text-black space-y-5 mb-10">{{ about.description }}</div>
        {%- endif -%}
        <div>
          <a href="{{ about_cta_url }}" class="vp-btn bg-black text-white border-black hover:bg-[#181A20]">
            <i class="ph ph-eye text-[16px]"></i>
            {{ about_cta_text }}
          </a>
        </div>
      </div>
      <div class="w-full lg:w-1/2 flex items-center justify-center">
        <img src="{{ about_image }}" alt="{{ workspace.name }}" class="w-full h-auto object-cover" loading="lazy">
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sobre nós",
  "location": "home",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo (faixa preta)", "default": "/ Quem somos" },
    { "type": "textarea", "id": "title", "label": "Título (faixa preta)" },
    { "type": "text", "id": "subtitle_eyebrow", "label": "Sobretítulo do bloco", "default": "/Alto padrão" },
    { "type": "textarea", "id": "subtitle", "label": "Título do bloco" },
    { "type": "richtext", "id": "description", "label": "Descrição" },
    { "type": "text", "id": "cta_text", "label": "Texto do botão", "default": "Conheça nossa história" },
    { "type": "url", "id": "cta_url", "label": "Link do botão" },
    { "type": "image_picker", "id": "image", "label": "Imagem" }
  ]
}
{% endschema %}
