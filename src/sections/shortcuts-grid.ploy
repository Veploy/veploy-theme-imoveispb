<!-- Shortcuts Grid Section -->
<section class="vp-section vp-shortcuts py-20 pb-5 md:pb-10 bg-white relative z-0">
  <div class="vp-section__container max-w-screen-2xl mx-auto px-[3%]">
    <!-- Section Header -->
    <div class="vp-section__header text-left mb-12">
      <h2 class="text-2xl md:text-2xl font-semibold text-gray-900 mb-2">
        {{ t.shortcuts.title }}
      </h2>
      <p class="text-gray-500 text-base">
        {{ t.shortcuts.description }}
        {{ workspace.city | default: t.shortcuts.your_region }}
      </p>
    </div>

    <!-- Shortcuts Grid -->
    <div class="vp-shortcuts-grid flex gap-4 overflow-x-scroll pb-4 snap-x [-webkit-overflow-scrolling:touch] [&::-webkit-scrollbar]:hidden [scrollbar-width:none] sm:grid sm:grid-cols-2 sm:gap-6 lg:grid-cols-4 sm:overflow-visible sm:pb-0 sm:snap-none">
      {% assign shortcuts = sections['shortcuts-grid'].items %}
      {% for shortcut in shortcuts %}
        <a href="{{ shortcut.url }}" class="group relative block rounded-2xl overflow-hidden aspect-[4/2] md:aspect-[9/10] flex-shrink-0 w-[75vw] sm:w-auto snap-center">
          <!-- Background Image -->
          <img
            src="{{ shortcut.image }}"
            alt="{{ shortcut.title }}"
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
            width="400"
            height="300"
          >

          <!-- Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-transparent to-black/20"></div>

          <!-- Title -->
          <div class="absolute top-5 left-5 right-5">
            <h3 class="text-white text-lg font-semibold drop-shadow-lg">
              {{ shortcut.title }}
            </h3>
          </div>
        </a>
      {% endfor %}

      <!-- Default shortcuts if none configured -->
      {% if shortcuts == nil or shortcuts.size == 0 %}
        <a
          href="{{ locale_prefix }}{{ routes.properties }}?destaque=true"
          class="group relative block rounded-2xl overflow-hidden aspect-[4/2] md:aspect-[16/10] flex-shrink-0 w-[75vw] sm:w-auto snap-center bg-gradient-to-br from-gray-400 to-gray-600"
        >
          <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-transparent to-black/20"></div>
          <div class="absolute top-5 left-5 right-5">
            <h3 class="text-white text-lg font-semibold drop-shadow-lg">{{ t.shortcuts.featured }}</h3>
          </div>
        </a>
        <a
          href="{{ locale_prefix }}{{ routes.properties }}?tipo=apartamento"
          class="group relative block rounded-2xl overflow-hidden aspect-[4/2] md:aspect-[16/10] flex-shrink-0 w-[75vw] sm:w-auto snap-center bg-gradient-to-br from-gray-400 to-gray-600"
        >
          <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-transparent to-black/20"></div>
          <div class="absolute top-5 left-5 right-5">
            <h3 class="text-white text-lg font-semibold drop-shadow-lg">{{ t.shortcuts.apartments }}</h3>
          </div>
        </a>
        <a
          href="{{ locale_prefix }}{{ routes.properties }}?tipo=casa"
          class="group relative block rounded-2xl overflow-hidden aspect-[4/2] md:aspect-[16/10] flex-shrink-0 w-[75vw] sm:w-auto snap-center bg-gradient-to-br from-gray-400 to-gray-600"
        >
          <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-transparent to-black/20"></div>
          <div class="absolute top-5 left-5 right-5">
            <h3 class="text-white text-lg font-semibold drop-shadow-lg">{{ t.shortcuts.houses }}</h3>
          </div>
        </a>
        <a
          href="{{ locale_prefix }}{{ routes.properties }}?tipo=terreno"
          class="group relative block rounded-2xl overflow-hidden aspect-[4/2] md:aspect-[16/10] flex-shrink-0 w-[75vw] sm:w-auto snap-center bg-gradient-to-br from-gray-400 to-gray-600"
        >
          <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-transparent to-black/20"></div>
          <div class="absolute top-5 left-5 right-5">
            <h3 class="text-white text-lg font-semibold drop-shadow-lg">{{ t.shortcuts.lands }}</h3>
          </div>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shortcuts Grid",
  "page": "home",
  "settings": [
    {
      "type": "repeater",
      "id": "shortcuts",
      "label": "Shortcuts",
      "max_items": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "url", "label": "URL" }
      ]
    }
  ]
}
{% endschema %}
