{% layout 'base' %}
{% block content %}
<section class="py-12 md:py-16">
  <div class="max-w-screen-xl mx-auto px-4 lg:px-8">
    <!-- Page Header -->
    <div class="mb-8">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900">{{ page.title }}</h1>
    </div>

    <!-- Page Content -->
    <div class="prose prose-lg max-w-none">
      {{ page.content }}
    </div>
  </div>
{% endblock %}
