{% layout 'base' %}
{% block content %}
{%- comment -%}
  Política de privacidade — coluna de 760px como no original: título 32/700,
  texto 16px com entrelinha 1.7 e os H2 sublinhados por uma linha cinza.
{%- endcomment -%}
<style>
  .pb-privacy { font-family: var(--font-body); color: #333; }
  .pb-privacy h1 { font-family: var(--font-body); font-size: 32px; font-weight: 700; line-height: 1.3; color: #333; margin-bottom: 20px; }
  .pb-privacy__content p,
  .pb-privacy__content li { font-size: 16px; line-height: 1.7; }
  .pb-privacy__content p { margin-bottom: 20px; }
  .pb-privacy__content h2 {
    font-family: var(--font-body);
    font-size: 24px;
    font-weight: 700;
    line-height: 1;
    color: #333;
    margin: 27px 0 30px;
    padding-bottom: 4px;
    border-bottom: 2px solid #DDDDDD;
  }
  .pb-privacy__content h3 { font-family: var(--font-body); font-size: 20px; font-weight: 700; line-height: 1.1; color: #333; margin: 30px 0 12px; }
  .pb-privacy__content ul { list-style: disc; padding-left: 20px; margin-bottom: 20px; }
  .pb-privacy__content a { text-decoration: underline; }
  /* Abaixo de 800px o texto ocupa a largura toda com 20px de respiro; no
     celular o original mantém os tamanhos do desktop */
  @media (max-width: 799px) { .pb-privacy { padding-inline: 20px; } }
</style>
<section class="vp-page vp-privacy pb-privacy pb-section bg-white">
  <article class="mx-auto max-w-[760px] pt-[60px] pb-[60px]">
    <h1>{{ t.privacy_policy.title }}</h1>
    <div class="pb-privacy__content">
      {{ t.privacy_policy.content }}
    </div>
  </article>
</section>
{% endblock %}
