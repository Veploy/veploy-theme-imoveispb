{% layout 'base' %}
{% block content %}
{%- comment -%}
  Favoritos — como no original: "Imóveis favoritos" centralizado em 36/600 e,
  sem nenhum salvo, só a frase "Você ainda não adicionou…". Com favoritos, os
  cards (os mesmos da listagem) entram em três colunas.
{%- endcomment -%}
<section class="pb-section bg-white" x-data="favoritesPage()" x-init="init()">
  <div class="mx-auto max-w-[1100px] pt-[60px] md:pt-[70px] pb-[60px] md:pb-[53px]">
    <h1 class="text-center text-[36px] font-semibold leading-[1] text-[#181A20]" style="font-family: var(--font-body);">Imóveis favoritos</h1>

    <!-- Barra de controle: só com pelo menos um favorito -->
    <div class="mt-[50px] mb-[30px] flex flex-col sm:flex-row items-center justify-between gap-4" x-show="$store.favorites.list.length > 0" x-cloak>
      <p class="text-[14px] font-bold tracking-[.28px] text-[#333]">
        <span x-text="$store.favorites.list.length"></span> {{ t.favorites_page.items_saved }}
      </p>
      <button type="button" @click="clearAll()" class="inline-flex items-center gap-2 text-[14px] text-[#666158] transition-colors hover:text-[#181A20]">
        <i class="ph ph-trash text-[16px]"></i>
        {{ t.favorites_page.clear_all }}
      </button>
    </div>

    <!-- Carregando -->
    <div x-show="loading" class="mt-[50px] grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[30px]">
      <template x-for="i in 3" :key="i">
        <div class="overflow-hidden rounded-[4px] border border-[#ECECEC] bg-white">
          <div class="aspect-[412/290] animate-pulse bg-[#F0EEE9]"></div>
          <div class="space-y-3 p-5">
            <div class="h-3 w-1/4 animate-pulse rounded bg-[#F0EEE9]"></div>
            <div class="h-4 animate-pulse rounded bg-[#F0EEE9]"></div>
            <div class="h-4 w-1/3 animate-pulse rounded bg-[#F0EEE9]"></div>
          </div>
        </div>
      </template>
    </div>

    <!-- Os cards renderizados no servidor entram aqui (favoritesPage().init) -->
    <div x-show="!loading && $store.favorites.list.length > 0" x-cloak data-favorites-mount></div>

    <!-- Nenhum favorito -->
    <p x-show="!loading && $store.favorites.list.length === 0" x-cloak class="mt-[60px] text-center text-[14px] leading-[22px] text-[#1F2124]">
      Você ainda não adicionou nenhum imóvel à sua lista de favoritos.
    </p>
  </div>
</section>
{% endblock %}

{% comment %} Scripts carregados pela rota page:favorites em config/scripts.json {% endcomment %}
