{% layout 'base' %}
{% block content %}
<section class="flex items-center justify-center py-24 px-[5%]">
  <div class="text-center max-w-lg">
    <p class="text-8xl font-bold text-primary/20">404</p>
    <h1 class="mt-4 text-2xl font-semibold text-gray-800">{{ title }}</h1>
    <p class="mt-2 text-gray-500">{{ message }}</p>
    <a
      href="{{ routes.home | default: '/' }}"
      class="inline-block mt-8 px-6 py-3 bg-primary text-white rounded-lg hover:opacity-90 transition"
    >
      {{ back_label }}
    </a>
  </div>
</section>
{% endblock %}
