{% layout 'base' %}
{% block content %}
{%- comment -%} ======= JSON-LD: CollectionPage + BreadcrumbList + ItemList ======= {%- endcomment -%}
{%- assign _url_parts = canonical_url | split: '/' -%}
{%- assign _site_url = _url_parts[0] | append: '//' | append: _url_parts[2] -%}
{%- if properties and properties.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "{{ canonical_url }}/#page",
      "url": "{{ canonical_url }}",
      "name": {{ title | default: 'Imóveis' | json }},
      "isPartOf": { "@id": "{{ _site_url }}/#website" },
      "about": { "@id": "{{ _site_url }}/#organization" },
      "mainEntity": { "@id": "{{ canonical_url }}/#itemlist" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ t.common.home | default: 'Início' | json }}, "item": "{{ _site_url }}{{ locale_prefix }}/" },
        { "@type": "ListItem", "position": 2, "name": {{ title | default: 'Imóveis' | json }}, "item": "{{ canonical_url }}" }
      ]
    },
    {
      "@type": "ItemList",
      "@id": "{{ canonical_url }}/#itemlist",
      "numberOfItems": {{ properties.size }},
      "itemListElement": [
        {%- for property in properties -%}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "item": {
            "@type": "RealEstateListing",
            "url": "{{ _site_url }}{{ locale_prefix }}{{ routes.property }}/{{ property.sku }}/{{ property.slug }}",
            "name": {{ property.title | json }}
            {%- if property.images and property.images.size > 0 -%},
            "image": "{{ property.images[0].url | default: property.images[0] }}"
            {%- endif -%}
            {%- if property.for_sale and property.sale_price and property.sale_price > 0 %},
            "offers": {
              "@type": "Offer",
              "price": {{ property.sale_price }},
              "priceCurrency": "{{ property.currency | default: 'BRL' }}",
              "businessFunction": "http://purl.org/goodrelations/v1#Sell"
            }
            {%- elsif property.for_rent and property.rental_price and property.rental_price > 0 %},
            "offers": {
              "@type": "Offer",
              "price": {{ property.rental_price }},
              "priceCurrency": "{{ property.currency | default: 'BRL' }}",
              "businessFunction": "http://purl.org/goodrelations/v1#LeaseOut"
            }
            {%- endif %}
          }
        }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  ]
}
</script>
{%- endif -%}
{%- comment -%}
  Listagem da Passos & Buytendorp, igual ao /imoveis/venda/ do original:
  filtros numa coluna de 320px à esquerda; à direita o título da busca, as abas
  Venda/Locação com o "Ordenar por" na mesma linha, a contagem e os cards em
  duas colunas. No mobile os filtros abrem numa gaveta pelo botão "Filtrar".
{%- endcomment -%}
{%- assign _arch = sections['archive:property'] -%}
{%- assign _op = filters.operation | default: 'sale' -%}
{%- if _op == 'rent' -%}
  {%- assign _list_title = _arch.title_rent | default: 'Imóveis para alugar em Campo Grande - MS e região' -%}
{%- else -%}
  {%- assign _list_title = _arch.title_sale | default: 'Imóveis à venda em Campo Grande - MS e região' -%}
{%- endif -%}
{%- assign default_sort = theme_settings.listings.default_sort | default: 'recent' -%}
{%- assign current_sort = filters.sortby | default: default_sort -%}

<section
  class="vp-page vp-properties-list pb-section bg-white"
  x-data="{
    filtersOpen: false,
    withParam(key, value) {
      const url = new URL(window.location.href);
      if (value === '' || value === null) url.searchParams.delete(key); else url.searchParams.set(key, value);
      if (key !== 'page') url.searchParams.delete('page');
      return url.toString();
    }
  }"
  x-effect="document.body.style.overflow = filtersOpen ? 'hidden' : ''"
>
  <div class="pb-container pt-[40px] pb-[40px] flex flex-col lg:flex-row gap-[30px]">

    <aside class="hidden lg:block lg:w-[320px] flex-shrink-0 self-start">
      {% include 'components/property-filters' %}
    </aside>

    {%- comment -%}
      Filtros no celular: como no original, um botão escuro "Filtrar imóveis"
      fixo no pé da tela abre o painel branco em tela cheia, com "X Fechar" no
      topo e os mesmos filtros da coluna do desktop.
    {%- endcomment -%}
    <div
      x-show="filtersOpen"
      x-transition:enter="transition ease-out duration-300" x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0"
      x-transition:leave="transition ease-in duration-200" x-transition:leave-start="translate-x-0" x-transition:leave-end="translate-x-full"
      class="pb-filter-panel lg:hidden"
      @keydown.escape.window="filtersOpen = false"
      role="dialog"
      aria-label="{{ t.search.filters | default: 'Filtros' }}"
      x-cloak
    >
      <div class="flex justify-end">
        <button type="button" @click="filtersOpen = false" class="pb-filter-panel__close">
          <span aria-hidden="true">X</span> Fechar
        </button>
      </div>
      {% include 'components/property-filters' %}
    </div>

    <button type="button" class="pb-filter-fab lg:hidden" @click="filtersOpen = true" x-show="!filtersOpen">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true"><path d="M487.976 0H24.028C2.71 0-8.047 25.866 7.058 40.971L192 225.941V432c0 7.831 3.821 15.17 10.237 19.662l80 55.98C298.02 518.69 320 507.493 320 487.98V225.941l184.947-184.97C520.021 25.896 509.338 0 487.976 0z"/></svg>
      <span>Filtrar imóveis</span>
    </button>

    <div class="vp-page__content flex-1 min-w-0">
      <h1 class="pb-listing__title">{{ _list_title }}</h1>

      <div class="pb-listing__bar">
        <nav class="pb-listing__tabs" aria-label="Operação">
          <a href="{{ locale_prefix }}{{ routes.properties }}{{ routes.operation_sale }}" class="pb-listing__tab{% if _op == 'sale' %} is-active{% endif %}"{% if _op == 'sale' %} aria-current="page"{% endif %}>Venda</a>
          <a href="{{ locale_prefix }}{{ routes.properties }}{{ routes.operation_rent }}" class="pb-listing__tab{% if _op == 'rent' %} is-active{% endif %}"{% if _op == 'rent' %} aria-current="page"{% endif %}>Locação</a>
        </nav>

        <label class="pb-listing__sort">
          <span>{{ t.listings.sort_by | default: 'Ordenar por:' }}</span>
          <select name="sortby" @change="window.location.href = withParam('sortby', $event.target.value)">
            <option value="recent"{% if current_sort == 'recent' %} selected{% endif %}>{{ t.listings.sort_by_default }} (recentes)</option>
            <option value="price_asc"{% if current_sort == 'price_asc' %} selected{% endif %}>{{ t.listings.sort_price_asc }}</option>
            <option value="price_desc"{% if current_sort == 'price_desc' %} selected{% endif %}>{{ t.listings.sort_price_desc }}</option>
            <option value="area_asc"{% if current_sort == 'area_asc' %} selected{% endif %}>{{ t.listings.sort_area_asc }}</option>
            <option value="area_desc"{% if current_sort == 'area_desc' %} selected{% endif %}>{{ t.listings.sort_area_desc }}</option>
          </select>
        </label>
      </div>

      {% if theme_settings.listings.show_properties_count != false %}
      <p class="pb-listing__count">
        {{ pagination.total_properties }} {% if pagination.total_properties == 1 %}imóvel encontrado{% else %}imóveis encontrados{% endif %}
      </p>
      {% endif %}

      {% if properties.size > 0 %}
        <div class="pb-listing__grid pb-card-grid">
          {% for property in properties %}
            {% include 'components/property-card' %}
          {% endfor %}
        </div>

        {%- comment -%}
          "Carregar mais", como no original: busca a próxima página e acrescenta
          os cards na grade. Sem JavaScript, o link leva para a próxima página.
        {%- endcomment -%}
        {% if pagination.current_page < pagination.total_pages %}
          {%- assign _next = pagination.current_page | plus: 1 -%}
          <div
            class="pb-load-more"
            x-data="{
              next: {{ _next }},
              last: {{ pagination.total_pages }},
              loading: false,
              async load() {
                if (this.loading) return;
                this.loading = true;
                try {
                  const res = await fetch(withParam('page', this.next), { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                  const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
                  const grid = document.querySelector('.pb-listing__grid');
                  doc.querySelectorAll('.pb-listing__grid > *').forEach(card => grid.appendChild(document.importNode(card, true)));
                  if (typeof vpInitSwipers === 'function') vpInitSwipers(grid);
                  this.next++;
                } catch (e) {
                  window.location.href = withParam('page', this.next);
                } finally {
                  this.loading = false;
                }
              }
            }"
            x-show="next <= last"
          >
            <a href="?page={{ _next }}" class="pb-load-more__btn" :class="loading && 'is-loading'" @click.prevent="load()">
              <span x-show="!loading">Carregar mais</span>
              <span x-show="loading" x-cloak>Carregando…</span>
            </a>
          </div>
        {% endif %}

      {% else %}
        <div class="border border-[#ECECEC] rounded-[4px] px-6 py-14 text-center">
          <i class="ph ph-buildings text-[48px] text-[#A9A49A]"></i>
          <h2 class="font-serif mt-4 text-[22px] text-[#181A20]">{{ t.listings.no_property_found }}</h2>
          <p class="mt-2 text-[14px] text-[#666158]">{{ t.listings.try_adjust_filters }}</p>
          {%- if _op == 'rent' -%}{%- assign _clear_seg = routes.operation_rent -%}{%- else -%}{%- assign _clear_seg = routes.operation_sale -%}{%- endif -%}
          <a href="{{ locale_prefix }}{{ routes.properties }}{{ _clear_seg }}" class="pb-filters__submit inline-flex items-center justify-center !w-auto px-8 mt-6">{{ t.search.clear_filters }}</a>
        </div>
      {% endif %}
    </div>
  </div>
</section>
{% endblock %}

{% block body_assets %}
{%- comment -%} TODO: map search assets — descomentar quando lançar busca por mapa
{% if properties.size > 0 %}
<script id="vpMapProperties" type="application/json">
[
  {%- assign _map_first = true -%}
  {%- for property in properties -%}
    {%- if property.latitude and property.longitude -%}
      {%- assign _map_price = property.sale_price | default: property.rental_price | default: 0 -%}
      {%- assign _map_img = property.images | first -%}
      {%- unless _map_first -%},{%- endunless -%}
      {%- assign _map_first = false -%}
      {
        "sku": {{ property.sku | json }},
        "lat": {{ property.latitude }},
        "lng": {{ property.longitude }},
        "display": {{ property.map_display | default: 'exact' | json }},
        "title": {{ property.formatted_title | default: property.title | json }},
        "price": {{ _map_price | money_format | json }},
        "image": {% if _map_img %}{{ _map_img.url | img_resize: 240, 140, true | json }}{% else %}null{% endif %},
        "url": "{{ routes.property }}/{{ property.sku }}/{{ property.slug }}",
        "neighborhood": {{ property.neighborhood | json }},
        "city": {{ property.city | json }}
      }
    {%- endif -%}
  {%- endfor -%}
]
</script>
<style>
  .vp-map-popup .leaflet-popup-content-wrapper { padding: 0; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 16px rgba(0,0,0,0.12); }
  .vp-map-popup .leaflet-popup-content { margin: 0; }
  .vp-map-popup .leaflet-popup-tip { box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
  .vp-map-price-marker { background: transparent !important; border: none !important; }
  .vp-map-cluster { background: transparent !important; border: none !important; }
  .vp-map-card-active article { outline: 2px solid rgb(var(--color-primary, 46 67 71)); outline-offset: -2px; border-radius: 16px; }
  @media (max-width: 1023px) {
    .vp-map-view { flex-direction: column; }
    .vp-map-view__list { max-height: none; height: auto; overflow: visible; }
  }
</style>
{% endif %}
{%- endcomment -%}

{%- comment -%} GA4: view_item_list — dispara quando a listagem de imóveis é carregada {%- endcomment -%}
{% if properties.size > 0 %}
<script>
(function() {
  if (!window.VpAnalytics) return;
  var items = [
    {% for property in properties %}
    {%- assign _op = '' -%}
    {%- if property.for_sale and property.for_rent -%}{%- assign _op = 'sale,rent' -%}
    {%- elsif property.for_sale -%}{%- assign _op = 'sale' -%}
    {%- elsif property.for_rent -%}{%- assign _op = 'rent' -%}
    {%- elsif property.for_short_term -%}{%- assign _op = 'short_term' -%}
    {%- endif -%}
    {%- assign _price = property.sale_price | default: property.rental_price | default: 0 -%}
    window.VpAnalytics.mapPropertyToItem({
      sku:          '{{ property.sku | escape }}',
      id:           '{{ property.id | escape }}',
      title:        '{{ property.title | escape }}',
      type:         '{{ property.main_type | escape }}',
      operation:    '{{ _op }}',
      neighborhood: '{{ property.neighborhood | escape }}',
      city:         '{{ property.city | escape }}',
      price:        {{ _price }},
    }, {{ forloop.index0 }}){% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];
  window.VpAnalytics.viewItemList(items, '{{ title | escape }}');
})();
</script>
{% endif %}
{% endblock %}

{% schema %}
{
  "location": "archive:property",
  "name": "Listagem de Imóveis",
  "settings": [
    {
      "type": "text",
      "id": "title_sale",
      "label": "Título da listagem de venda",
      "default": "Imóveis à venda em Campo Grande - MS e região"
    },
    {
      "type": "text",
      "id": "title_rent",
      "label": "Título da listagem de locação",
      "default": "Imóveis para alugar em Campo Grande - MS e região"
    },
    {
      "type": "select",
      "id": "default_sort",
      "label": "Ordenação padrão",
      "default": "recent",
      "options": [
        { "value": "recent", "label": "Mais recentes" },
        { "value": "price_asc", "label": "Menor preço" },
        { "value": "price_desc", "label": "Maior preço" },
        { "value": "area_desc", "label": "Maior área" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_properties_count",
      "label": "Mostrar contagem de imóveis",
      "default": true
    },
    {
      "type": "select",
      "id": "default_view",
      "label": "Visualização padrão",
      "default": "grid",
      "options": [
        { "value": "grid", "label": "Grade" },
        { "value": "list", "label": "Lista" },
        { "value": "map", "label": "Mapa" }
      ]
    }
  ]
}
{% endschema %}
