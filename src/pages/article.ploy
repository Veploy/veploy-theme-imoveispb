{% layout 'base' %}
{% block content %}
<!-- Article Header -->
<article class="bg-white">
  <!-- Breadcrumbs -->
  <section class="py-6 border-b border-gray-100">
    <div class="max-w-screen-xl mx-auto px-4 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-gray-600">
        <a href="{{ locale_prefix }}/" class="hover:text-primary transition-colors">{{ t.common.home }}</a>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
        </svg>
        <a href="{{ locale_prefix }}{{ routes.blog }}" class="hover:text-primary transition-colors">{{ t.blog_page.title }}</a>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
        </svg>
        <span class="text-gray-900">{{ article.title | truncate: 50 }}</span>
      </nav>
    </div>
  </section>

  <!-- Article Title Section -->
  <section class="py-12">
    <div class="max-w-screen-xl mx-auto px-4 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <!-- Category -->
        {% if article.category %}
          {% if article.category_slug %}
          <a href="{{ locale_prefix }}{{ routes.blog }}/{{ segments.category_prefix }}/{{ article.category_slug | url_encode }}" class="inline-block bg-primary/10 text-primary hover:bg-primary/20 text-sm font-semibold px-4 py-1.5 rounded-full mb-6 transition-colors">
            {{ article.category }}
          </a>
          {% else %}
          <span class="inline-block bg-primary/10 text-primary text-sm font-semibold px-4 py-1.5 rounded-full mb-6">
            {{ article.category }}
          </span>
          {% endif %}
        {% endif %}

        <!-- Title -->
        <h1 class="text-3xl md:text-5xl font-bold text-gray-900 mb-6" style="line-height: 1.3;">
          {{ article.title }}
        </h1>

        <!-- Meta -->
        <div class="flex flex-wrap items-center gap-6 text-gray-600 pb-8 border-b border-gray-100">
          <!-- Date -->
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-primary">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
            </svg>
            <time datetime="{{ article.published_at }}">
              {{ article.published_at | date_localized: "%d de %B de %Y" }}
            </time>
          </div>

          <!-- Reading Time -->
          {% if article.reading_time %}
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-primary">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>{{ article.reading_time }} {{ t.blog_article.min_read }}</span>
          </div>
          {% endif %}

          <!-- Author -->
          {% if article.author %}
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-primary">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
            </svg>
            <span>{{ article.author }}</span>
          </div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Image -->
  {% if article.featured_image %}
  <section class="pb-12">
    <div class="max-w-screen-xl mx-auto px-4 lg:px-8">
      <div class="max-w-5xl mx-auto flex justify-center">
        <img
          src="{{ article.featured_image }}"
          alt="{{ article.title }}"
          class="rounded-2xl shadow-lg max-h-[600px] w-auto h-auto"
          loading="eager"
        >
      </div>
    </div>
  </section>
  {% endif %}

  <!-- Article Content -->
  <section class="pb-16 md:pb-20">
    <div class="max-w-screen-xl mx-auto px-4 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <!-- Content with beautiful typography -->
        <div class="prose prose-lg max-w-none">
          {{ article.content }}
        </div>

        <!-- Tags -->
        {% if article.tags.size > 0 %}
        <div class="mt-12 pt-8 border-t border-gray-100">
          <h3 class="text-sm font-semibold text-gray-900 mb-4">{{ t.blog_article.tags }}</h3>
          <div class="flex flex-wrap gap-2">
            {% for tag in article.tags %}
            <a href="/blog?tag={{ tag | url_encode }}" 
               class="inline-block bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm px-4 py-2 rounded-full transition-colors">
              #{{ tag }}
            </a>
            {% endfor %}
          </div>
        </div>
        {% endif %}

        <!-- Share Section -->
        <div class="mt-12 pt-8 border-t border-gray-100">
          <h3 class="text-sm font-semibold text-gray-900 mb-4">{{ t.blog_article.share }}</h3>
          <div class="flex items-center gap-3">
            <!-- WhatsApp -->
            <a href="https://wa.me/?text={{ article.title | url_encode }}%20{{ article.url | url_encode }}" 
               target="_blank"
               rel="noopener"
               class="w-10 h-10 rounded-full bg-[#25D366] hover:bg-[#128C7E] text-white flex items-center justify-center transition-colors"
               aria-label="Compartilhar no WhatsApp">
              <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </a>

            <!-- Facebook -->
            <a href="https://www.facebook.com/sharer/sharer.php?u={{ article.url | url_encode }}" 
               target="_blank"
               rel="noopener"
               class="w-10 h-10 rounded-full bg-[#1877F2] hover:bg-[#145dbf] text-white flex items-center justify-center transition-colors"
               aria-label="Compartilhar no Facebook">
              <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>

            <!-- Twitter/X -->
            <a href="https://twitter.com/intent/tweet?text={{ article.title | url_encode }}&url={{ article.url | url_encode }}" 
               target="_blank"
               rel="noopener"
               class="w-10 h-10 rounded-full bg-black hover:bg-gray-800 text-white flex items-center justify-center transition-colors"
               aria-label="Compartilhar no Twitter">
              <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-4 h-4">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>

            <!-- LinkedIn -->
            <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ article.url | url_encode }}" 
               target="_blank"
               rel="noopener"
               class="w-10 h-10 rounded-full bg-[#0A66C2] hover:bg-[#004182] text-white flex items-center justify-center transition-colors"
               aria-label="Compartilhar no LinkedIn">
              <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>

            <!-- Copy Link -->
            <div x-data="{ copied: false }" class="relative">
              <button
                type="button"
                @click="navigator.clipboard.writeText(window.location.href); copied = true; setTimeout(() => copied = false, 2000)"
                class="w-10 h-10 rounded-full bg-gray-200 hover:bg-gray-300 text-gray-700 flex items-center justify-center transition-colors group"
                aria-label="Copiar link">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
                </svg>
              </button>
              <span
                x-show="copied"
                x-transition
                class="absolute -top-10 left-1/2 -translate-x-1/2 bg-gray-900 text-white text-xs px-3 py-1.5 rounded whitespace-nowrap pointer-events-none">
                {{ t.common.copied | default: 'Copiado!' }}
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</article>

<!-- Related Articles -->
{% if related_articles.size > 0 %}
<section class="py-16 md:py-20 bg-gray-50">
  <div class="max-w-screen-xl mx-auto px-4 lg:px-8">
    <div class="max-w-6xl mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          {{ t.blog_article.related_articles }}
        </h2>
        <p class="text-gray-600">
          {{ t.blog_article.related_articles_description }}
        </p>
      </div>

      <!-- Articles Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {% for related in related_articles limit: 3 %}
        <article class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-all group">
          <!-- Image -->
          <a href="{{ locale_prefix }}{{ routes.blog }}/{{ related.slug }}" class="block relative overflow-hidden">
            <div class="aspect-[16/9]">
              <img
                src="{{ related.featured_image | default: 'https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=800&q=80' }}"
                alt="{{ related.title }}"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              >
            </div>
            {% if related.category %}
            <span class="absolute top-4 left-4 bg-primary/90 text-white text-xs font-semibold px-3 py-1.5 rounded">
              {{ related.category }}
            </span>
            {% endif %}
          </a>

          <!-- Content -->
          <div class="p-6">
            <time class="text-sm text-gray-400 mb-2 block" datetime="{{ related.published_at }}">
              {{ related.published_at | date: "%d/%m/%Y" }}
            </time>

            <h3 class="text-lg font-bold text-gray-900 mb-2 line-clamp-2">
              <a href="{{ locale_prefix }}{{ routes.blog }}/{{ related.slug }}" class="hover:text-primary transition-colors">
                {{ related.title }}
              </a>
            </h3>

            <p class="text-gray-600 text-sm leading-relaxed line-clamp-2 mb-4">
              {{ related.excerpt }}
            </p>

            <a href="{{ locale_prefix }}{{ routes.blog }}/{{ related.slug }}" class="inline-flex items-center text-sm font-medium text-primary hover:text-primary/80 transition-colors group/link">
              {{ t.blog_page.read_more }}
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 ml-1 group-hover/link:translate-x-1 transition-transform">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </article>
        {% endfor %}
      </div>

      <!-- View All Button -->
      <div class="text-center mt-12">
        <a href="{{ locale_prefix }}{{ routes.blog }}" class="inline-flex items-center gap-2 bg-primary hover:bg-primary/90 text-white px-8 py-3 rounded-lg font-semibold transition-colors">
          {{ t.blog_article.view_all_articles }}
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
{% endif %}
{% endblock %}

{% block head_assets %}
{%- comment -%} ======= JSON-LD: BlogPosting + BreadcrumbList ======= {%- endcomment -%}
{%- assign _url_parts = canonical_url | split: '/' -%}
{%- assign _site_url = _url_parts[0] | append: '//' | append: _url_parts[2] -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": "{{ canonical_url }}/#article",
      "headline": "{{ article.title | escape }}",
      "url": "{{ canonical_url }}",
      "datePublished": "{{ article.published_at }}"
      {%- if article.modified_at != blank %},
      "dateModified": "{{ article.modified_at }}"
      {%- endif -%}
      {%- if article.excerpt != blank %},
      "description": "{{ article.excerpt | strip_html | strip_newlines | strip | truncate: 300 | escape }}"
      {%- endif -%}
      {%- if article.featured_image != blank %},
      "image": "{{ article.featured_image }}"
      {%- endif -%}
      {%- if article.author != blank %},
      "author": {
        "@type": "Person",
        "name": "{{ article.author | escape }}"
      }
      {%- else %},
      "author": { "@id": "{{ _site_url }}/#organization" }
      {%- endif %},
      "publisher": { "@id": "{{ _site_url }}/#organization" },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "{{ canonical_url }}"
      }
      {%- if article.category != blank %},
      "articleSection": "{{ article.category | escape }}"
      {%- endif -%}
      {%- if article.tags and article.tags.size > 0 %},
      "keywords": "{% for tag in article.tags %}{{ tag | escape }}{% unless forloop.last %}, {% endunless %}{% endfor %}"
      {%- endif %}
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "{{ t.common.home | default: 'Início' }}",
          "item": "{{ _site_url }}{{ locale_prefix }}/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "{{ t.blog_page.title | default: 'Blog' }}",
          "item": "{{ _site_url }}{{ locale_prefix }}{{ routes.blog }}"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "{{ article.title | escape | truncate: 60 }}"
        }
      ]
    }
  ]
}
</script>
{% endblock %}
