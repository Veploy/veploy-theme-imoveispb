{% layout 'base' %}
{% block content %}
{%- comment -%} ======= JSON-LD: AboutPage ======= {%- endcomment -%}
{%- assign _url_parts = canonical_url | split: '/' -%}
{%- assign _site_url = _url_parts[0] | append: '//' | append: _url_parts[2] -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "@id": "{{ canonical_url }}/#page",
  "url": "{{ canonical_url }}",
  "name": {{ title | default: 'Sobre nós' | json }},
  "isPartOf": { "@id": "{{ _site_url }}/#website" },
  "mainEntity": { "@id": "{{ _site_url }}/#organization" }
}
</script>
{% section 'about-us/hero' %}
{% section 'about-us/story' %}
{% section 'about-us/team' %}
{% section 'about-us/values' %}
{% endblock %}

{% schema %}
{
  "name": "Sobre nós",
  "location": "about-us",
  "settings": []
}
{% endschema %}
