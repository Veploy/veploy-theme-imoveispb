{% layout 'base' %}
{% block content %}
{% assign careers = sections['careers'] %}

<!-- Trabalhe Conosco Section -->
<section class="bg-white py-16 md:py-20">
  <div class="max-w-screen-xl mx-auto px-4 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-stretch">

      <!-- Left Column - Form -->
      <div class="flex flex-col gap-6">
        <p class="text-primary tracking-wide">{{ t.work_with_us_page.breadcrumb }}</p>

        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 leading-tight md:leading-[3.5rem]">
          {{ t.work_with_us_page.title }}
        </h1>

        <p class="text-gray-700 mb-3">
          {{ t.work_with_us_page.description }}
        </p>

        <!-- WhatsApp Link -->
        {% if theme_settings.contact.whatsapp != blank %}
        <a
          href="https://wa.me/{{ theme_settings.contact.whatsapp | remove: '-' | remove: '(' | remove: ')' | remove: ' ' }}?text=Olá! Tenho interesse em trabalhar na Lopes Master"
          target="_blank"
          class="inline-flex items-center gap-2 text-primary hover:text-primary/80 mb-8 font-medium"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          {{ t.work_with_us_page.whatsapp_cta }}
        </a>
        {% endif %}

        <!-- Contact Form -->
        {% form 'contact', name: 'Trabalhe conosco' %}
          <div class="space-y-6">
            <!-- Success Message -->
            {% if form.posted_successfully %}
            <div class="p-4 bg-green-50 border border-green-200 rounded-lg">
              <p class="text-green-800 font-medium">{{ form.success }}</p>
            </div>
            {% endif %}

            <!-- Error Message -->
            {% if form.errors %}
            <div class="p-4 bg-red-50 border border-red-200 rounded-lg">
              <p class="text-red-800 font-medium">{{ form.errors | first }}</p>
            </div>
            {% endif %}

            <!-- Name (full width) -->
            <div>
              <label for="name" class="block text-base font-medium text-gray-700 mb-2">{{ t.work_with_us_page.form_name }}</label>
              <input type="text" id="name" name="contact[name]" required
                     class="w-full border border-gray-200 rounded-lg px-4 py-3 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors">
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <!-- Phone -->
              <div>
                <label for="phone" class="block text-base font-medium text-gray-700 mb-2">{{ t.work_with_us_page.form_phone }}</label>
                {% include 'components/global/form/phone-input', name: 'contact[phone]' %}
              </div>

              <!-- Email -->
              <div>
                <label for="email" class="block text-base font-medium text-gray-700 mb-2">{{ t.work_with_us_page.form_email }}</label>
                <input type="email" id="email" name="contact[email]" required
                       class="w-full border border-gray-200 rounded-lg px-4 py-3 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors">
              </div>
            </div>

            <!-- Message -->
            <div>
              <label for="message" class="block text-base font-medium text-gray-700 mb-2">{{ t.work_with_us_page.form_message }}</label>
              <textarea id="message" name="contact[message]" rows="5"
                        class="w-full border border-gray-200 rounded-lg px-4 py-3 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors resize-none"></textarea>
            </div>

            <!-- Submit Button -->
            <div>
              <button type="submit"
                      class="w-full md:w-auto bg-secondary hover:bg-primary/90 text-white px-10 py-4 rounded-lg font-semibold transition-colors">
                {{ t.work_with_us_page.form_submit }}
              </button>
            </div>
          </div>
        {% endform %}
      </div>

      <!-- Right Column - Image and Text -->
      <div class="relative h-full hidden lg:block">
        <div class="relative rounded-2xl overflow-hidden h-full">
          {% if careers.image %}
          <img
            src="{{ careers.image }}"
            alt="{{ t.work_with_us_page.image_alt }}"
            class="w-full h-full object-cover"
          >
          {% endif %}

          <!-- Overlay Text -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent flex flex-col justify-end p-8 text-white">
            <p class="text-base leading-relaxed mb-4">
              {{ t.work_with_us_page.overlay_text }}
            </p>
            <p class="font-bold text-lg">{{ t.work_with_us_page.overlay_company }}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Benefits Section -->
<section class="bg-gray-50 py-16 md:py-20">
  <div class="max-w-screen-xl mx-auto px-4 lg:px-8">
    <!-- Section Header -->
    <div class="mb-12">
      <p class="text-primary tracking-wide mb-4">{{ t.work_with_us_page.benefits_breadcrumb }}</p>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        {{ t.work_with_us_page.benefits_title }}
      </h2>
      <p class="text-gray-700 max-w-3xl">
        {{ t.work_with_us_page.benefits_description }}
      </p>
    </div>

    <!-- Benefits Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {% for benefit in careers.benefits.items %}
        <div class="bg-white p-6 rounded-xl">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="text-primary" viewBox="0 0 24 24">
              <path d="{{ benefit.icon }}"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">{{ benefit.title }}</h3>
          <p class="text-gray-700">{{ benefit.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endblock %}

{% schema %}
{
  "name": "Careers Page",
  "page": "careers",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image",
      "info": "Image displayed on the right side of the form"
    },
    {
      "type": "repeater",
      "id": "benefits",
      "label": "Benefits",
      "items_count": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "SVG Path",
          "info": "SVG path data for the icon"
        }
      ],
      "default": [
        {
          "title": "Ambiente colaborativo e inspirador",
          "description": "Trabalhe ao lado de profissionais engajados, em um ambiente que valoriza o trabalho em equipe, o respeito e o crescimento conjunto.",
          "icon": "M20 6h-2.18c.11-.31.18-.65.18-1a2.996 2.996 0 0 0-5.5-1.65l-.5.67-.5-.68C10.96 2.54 10.05 2 9 2 7.34 2 6 3.34 6 5c0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2m-5-2c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1M9 4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1m11 15H4v-2h16zm0-5H4V8h5.08L7 10.83 8.62 12 11 8.76l1-1.36 1 1.36L15.38 12 17 10.83 14.92 8H20z"
        },
        {
          "title": "Marketing forte e presença digital",
          "description": "Tenha à disposição uma estrutura de marketing que inclui anúncios patrocinados, redes sociais e portais de imóveis para alavancar seus resultados.",
          "icon": "M18 11c0-.959-.68-1.761-1.581-1.954C16.779 8.445 17 7.75 17 7c0-2.206-1.794-4-4-4-1.517 0-2.821.857-3.5 2.104C8.821 3.857 7.517 3 6 3 3.794 3 2 4.794 2 7c0 .902.312 1.727.817 2.396A1.993 1.993 0 0 0 2 11v8c0 1.103.897 2 2 2h12c1.103 0 2-.897 2-2v-2.638l4 2v-7l-4 2zm-5-6c1.103 0 2 .897 2 2s-.897 2-2 2-2-.897-2-2 .897-2 2-2M6 5c1.103 0 2 .897 2 2s-.897 2-2 2-2-.897-2-2 .897-2 2-2"
        },
        {
          "title": "Ferramentas inteligentes e suporte diário",
          "description": "Conte com tecnologia de ponta e uma equipe pronta para apoiar sua rotina com agilidade, organização e foco em resultados.",
          "icon": "m21.71 20.29-1.42 1.42a1 1 0 0 1-1.41 0L7 9.85A3.81 3.81 0 0 1 6 10a4 4 0 0 1-3.78-5.3l2.54 2.54.53-.53 1.42-1.42.53-.53L4.7 2.22A4 4 0 0 1 10 6a3.81 3.81 0 0 1-.15 1l11.86 11.88a1 1 0 0 1 0 1.41M2.29 18.88a1 1 0 0 0 0 1.41l1.42 1.42a1 1 0 0 0 1.41 0l5.47-5.46-2.83-2.83M20 2l-4 2v2l-2.17 2.17 2 2L18 8h2l2-4z"
        },
        {
          "title": "Acesso a imóveis exclusivos e oportunidades reais",
          "description": "Trabalhe com um portfólio diversificado, incluindo lançamentos e imóveis únicos, ampliando suas chances de sucesso nas negociações.",
          "icon": "M21 2H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h7v2H8v2h8v-2h-2v-2h7c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2m0 14H3V4h18zm-10-2H9V6h2zm-4 0H5V9h2zm8 0h-2V9h2zm4 0h-2V6h2z"
        }
      ]
    }
  ]
}
{% endschema %}
