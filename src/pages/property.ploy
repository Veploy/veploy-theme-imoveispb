{% layout 'base' %}
{% block content %}
{%- comment -%}
  Detalhe do imóvel da Passos & Buytendorp — igual ao site original:
  galeria horizontal (3 fotos por vez) → ações (Fotos / Mapa / Favoritos) →
  código, título, endereço, preço, características e descrição → "Características
  do imóvel" → Localização → Imóveis similares à esquerda; card "Gostou deste
  imóvel?" sticky à direita. No mobile o card vem entre o mapa e os similares.
{%- endcomment -%}
{%- assign _has_images = false -%}
{%- if property.images and property.images.size > 0 -%}{%- assign _has_images = true -%}{%- endif -%}
{%- assign _has_plans = false -%}
{%- if property.floor_plans and property.floor_plans.size > 0 -%}{%- assign _has_plans = true -%}{%- endif -%}
{%- assign map_display = property.map_display | default: 'exact' -%}
{%- assign _has_map = false -%}
{%- if map_display != 'hidden' and property.latitude and property.longitude -%}{%- assign _has_map = true -%}{%- endif -%}
{%- assign _title = property.formatted_title | default: property.title -%}

<article class="vp-page vp-property-single bg-white">

  <!-- Galeria principal: 3 fotos por vez no desktop, 1 no mobile -->
  {% if _has_images %}
  <div class="vp-prop-gallery relative">
    <div class="swiper vp-prop-gallery__swiper h-[360px] min-[481px]:h-[450px]">
      <div class="swiper-wrapper">
        {% for image in property.images %}
        <div class="swiper-slide vp-img-wrap cursor-pointer overflow-hidden bg-[#F3F3F3]" onclick="openGalleryModal({{ forloop.index0 }})">
          <img
            src="{{ image.url | default: image | img_resize: 960, 0, false, 'webp' }}"
            alt="{{ _title | escape }} — foto {{ forloop.index }}"
            class="h-full w-full object-cover"
            {% if forloop.index <= 3 %}loading="eager"{% else %}loading="lazy"{% endif %}
            onload="this.closest('.vp-img-wrap').classList.add('vp-loaded')"
          >
        </div>
        {% endfor %}
      </div>
    </div>
    {% if property.images.size > 1 %}
    <button type="button" class="vp-prop-gallery__prev absolute left-5 top-1/2 z-10 flex h-[50px] w-[50px] -translate-y-1/2 items-center justify-center rounded-full bg-white text-[#333] shadow-[1px_1px_10px_1px_rgb(0_0_0/0.03)] transition-opacity hover:opacity-80 disabled:opacity-50" aria-label="Foto anterior"><i class="ph ph-caret-left text-[18px]"></i></button>
    <button type="button" class="vp-prop-gallery__next absolute right-5 top-1/2 z-10 flex h-[50px] w-[50px] -translate-y-1/2 items-center justify-center rounded-full bg-white text-[#333] shadow-[1px_1px_10px_1px_rgb(0_0_0/0.03)] transition-opacity hover:opacity-80 disabled:opacity-50" aria-label="Próxima foto"><i class="ph ph-caret-right text-[18px]"></i></button>
    {% endif %}
  </div>
  {% else %}
  <div class="flex h-[360px] md:h-[450px] w-full items-center justify-center bg-[#F3F3F3]">
    <i class="ph ph-image text-7xl text-[#C9C4BA]"></i>
  </div>
  {% endif %}

  <div class="pb-section">
    <div class="mx-auto grid max-w-[1300px] grid-cols-1 gap-x-10 lg:grid-cols-[minmax(0,1fr)_349px] lg:grid-rows-[auto_auto_1fr]">

      <!-- Ações + informações principais + descrição -->
      <div class="lg:col-start-1 lg:row-start-1 border-b border-[#DDDDDD] pb-[40px]">
        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-[#E7E0D2] py-[10px]">
          <div class="hidden md:flex flex-wrap gap-[10px]">
            {% if _has_images %}
            <button type="button" onclick="openGalleryModal(0)" class="vp-prop-action"><i class="ph ph-images"></i>Fotos</button>
            {% endif %}
            {% if _has_map %}
            <button type="button" onclick="scrollToMap()" class="vp-prop-action"><i class="ph ph-map-trifold"></i>Mapa</button>
            {% endif %}
            {% if _has_plans %}
            <a href="#plantas" class="vp-prop-action"><i class="ph ph-frame-corners"></i>Plantas</a>
            {% endif %}
          </div>
          <button
            type="button"
            x-data="{ sku: '{{ property.sku }}' }"
            data-property-sku="{{ property.sku }}"
            @click="toggleFavorite($el)"
            class="inline-flex items-center gap-[6px] text-[15px] leading-[22px] text-[#666158] transition-opacity hover:opacity-70"
          >
            <i class="text-[16px]" :class="$store.favorites.is(sku) ? 'ph-fill ph-heart' : 'ph ph-heart'"></i>
            <span x-text="$store.favorites.is(sku) ? 'Adicionado aos favoritos' : 'Adicionar aos favoritos'">Adicionar aos favoritos</span>
          </button>
        </div>

        <div class="pt-[22px]">
          <span class="block font-serif text-[16px] leading-[24px] text-[#666158]">{{ property.sku }}</span>
          <h1 class="font-serif mt-[13px] text-[20px] md:text-[27px] font-normal leading-[1.2] text-[#181A20]">{{ _title }}</h1>

          {% assign address_display = settings.property_detail.address_display | default: theme_settings.property_detail.address_display | default: 'hide_number' %}
          <p class="mt-[10px] pb-[20px] text-[14px] md:text-[16px] leading-[1.2] text-[#666158]">
            {% case address_display %}
              {% when 'full' %}
                {% if property.address %}{{ property.address }}{% if property.number %}, {{ property.number }}{% endif %}, {% endif %}{{ property.neighborhood }}{% if property.city %}, {{ property.city }}{% endif %}{% if property.state %} – {{ property.state }}{% endif %}, Brasil
              {% when 'hide_address' %}
                {{ property.neighborhood }}{% if property.city %}, {{ property.city }}{% endif %}{% if property.state %} – {{ property.state }}{% endif %}, Brasil
              {% when 'hide_neighborhood' %}
                {{ property.city }}{% if property.state %} – {{ property.state }}{% endif %}, Brasil
              {% else %}
                {% if property.address %}{{ property.address }}, {% endif %}{{ property.neighborhood }}{% if property.city %}, {{ property.city }}{% endif %}{% if property.state %} – {{ property.state }}{% endif %}, Brasil
            {% endcase %}
          </p>

          <!-- Preço -->
          <div class="space-y-1 font-serif text-[22px] font-semibold leading-[1.3] text-[#181A20]">
            {% if property.for_sale or property.for_rent != true %}
            <p>
              {% if property.sale_price and property.sale_price != 'on_request' and property.sale_price != 'negotiable' and property.sale_price > 0 %}
                {{ property.sale_price | money_format }}{% if property.sale_price_max and property.sale_price_max > property.sale_price %} a {{ property.sale_price_max | money_format }}{% endif %}
              {% elsif property.sale_price == 'negotiable' %}A combinar{% else %}Consulte-nos{% endif %}
            </p>
            {% endif %}
            {% if property.for_rent %}
            <p>
              {% if property.for_sale %}<span class="text-[16px] font-normal text-[#666158]">Locação:</span> {% endif %}
              {% if property.rental_price and property.rental_price != 'on_request' and property.rental_price != 'negotiable' and property.rental_price > 0 %}
                {{ property.rental_price | money_format }}{% if property.rental_price_max and property.rental_price_max > property.rental_price %} a {{ property.rental_price_max | money_format }}{% endif %}<span class="text-[16px] font-normal">/mês</span>
              {% elsif property.rental_price == 'negotiable' %}A combinar{% else %}Consulte-nos{% endif %}
            </p>
            {% endif %}
          </div>

          {% if property.condo_fee or property.iptu_price %}
          <p class="mt-[6px] flex flex-wrap gap-x-6 gap-y-1 font-serif text-[15px] leading-[1.3] text-[#696969]">
            {% if property.condo_fee %}<span><b>Condomínio:</b> {{ property.condo_fee | money_format }}</span>{% endif %}
            {% if property.iptu_price %}<span><b>IPTU:</b> {{ property.iptu_price | money_format }}</span>{% endif %}
          </p>
          {% endif %}

          <!-- Características: "2 quartos | 2 banheiros | ..." -->
          <ul class="vp-prop-features mt-[30px] flex flex-wrap gap-y-4 font-serif text-[16px] leading-[22px] text-[#373630]">
            {% if property.beds and property.beds > 0 %}
            <li>{{ property.beds }}{% if property.beds_max and property.beds_max > property.beds %} a {{ property.beds_max }}{% endif %} {% if property.beds == 1 and property.beds_max == blank %}quarto{% else %}quartos{% endif %}</li>
            {% endif %}
            {% if property.bathrooms and property.bathrooms > 0 %}
            <li>{{ property.bathrooms }}{% if property.bathrooms_max and property.bathrooms_max > property.bathrooms %} a {{ property.bathrooms_max }}{% endif %} {% if property.bathrooms == 1 and property.bathrooms_max == blank %}banheiro{% else %}banheiros{% endif %}</li>
            {% endif %}
            {% if property.suites and property.suites > 0 %}
            <li>{{ property.suites }}{% if property.suites_max and property.suites_max > property.suites %} a {{ property.suites_max }}{% endif %} {% if property.suites == 1 and property.suites_max == blank %}suíte{% else %}suítes{% endif %}</li>
            {% endif %}
            {% if property.parkings and property.parkings > 0 %}
            <li>{{ property.parkings }}{% if property.parkings_max and property.parkings_max > property.parkings %} a {{ property.parkings_max }}{% endif %} {% if property.parkings == 1 and property.parkings_max == blank %}vaga{% else %}vagas{% endif %}</li>
            {% endif %}
            {% if property.usable_area and property.usable_area > 0 %}
            <li>{{ property.usable_area }}{% if property.usable_area_max and property.usable_area_max > property.usable_area %} a {{ property.usable_area_max }}{% endif %} m²</li>
            {% endif %}
            {% if property.total_area and property.total_area > 0 %}
            <li>{{ property.total_area }}{% if property.total_area_max and property.total_area_max > property.total_area %} a {{ property.total_area_max }}{% endif %} m²/total</li>
            {% endif %}
          </ul>

          {% if property.description != blank %}
          <div class="vp-prop-description mt-[50px] text-[15px] leading-[25px] text-[#373630]">{{ property.description | strip }}</div>
          {% endif %}

          <!-- Compartilhe (só no mobile; no desktop fica no pé do card lateral) -->
          {%- if theme_settings.sections['single:property'].show_share_buttons != false %}
          <div class="md:hidden mt-[50px] flex items-center gap-[13px]" x-data="{ copied: false }">
            <span class="font-serif text-[14px] font-semibold text-[#181A20]">Compartilhe:</span>
            {% render 'components/property-share', title: _title %}
          </div>
          {%- endif %}
        </div>
      </div>

      <!-- Características do imóvel + plantas + localização -->
      <div class="lg:col-start-1 lg:row-start-2 lg:row-end-3">

        {% if property.amenities and property.amenities.size > 0 %}
        <section class="pt-[40px] md:pt-[60px]">
          <h2 class="vp-prop-title">Características do imóvel</h2>
          <ul class="vp-prop-amenities grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-x-5">
            {% for amenity in property.amenities %}
            <li>{{ amenity.name | default: amenity }}</li>
            {% endfor %}
          </ul>
        </section>
        {% endif %}

        <!-- Plantas -->
        {% if _has_plans %}
        <section id="plantas" class="scroll-mt-5 pt-[60px]">
          <h2 class="vp-prop-title">Plantas</h2>
          <div class="relative px-[30px]">
            <div class="swiper vp-plantas__swiper">
              <div class="swiper-wrapper">
                {% for planta in property.floor_plans %}
                {%- assign _plan_img = planta.url | default: planta -%}
                {%- comment -%} Sem nome cadastrado o título vem como nome do arquivo → "Planta N" {%- endcomment -%}
                {%- assign _plan_title = planta.title | default: '' | strip -%}
                {%- assign _plan_title_dc = _plan_title | downcase -%}
                {%- if _plan_title == blank or _plan_title_dc contains '.jpg' or _plan_title_dc contains '.jpeg' or _plan_title_dc contains '.png' or _plan_title_dc contains '.webp' -%}
                  {%- assign _plan_title = 'Planta ' | append: forloop.index -%}
                {%- endif -%}
                <div class="swiper-slide">
                  <button type="button" class="group block w-full text-center" onclick="openPlantasModal({{ forloop.index0 }})">
                    <span class="flex aspect-[4/3] w-full items-center justify-center overflow-hidden bg-white">
                      {% if _plan_img != blank %}
                      <img src="{{ _plan_img | img_resize: 600, 0 }}" alt="{{ _plan_title | escape }}" class="h-full w-full object-contain transition-transform duration-300 group-hover:scale-[1.03]" loading="lazy">
                      {% else %}
                      <span class="flex flex-col items-center gap-3 text-[#9A9A9A]"><i class="ph ph-selection text-[64px]"></i><span class="text-[15px]">Modelo Indisponível</span></span>
                      {% endif %}
                    </span>
                    <span class="mt-4 block text-[14px] font-bold text-[#181A20]">{{ _plan_title }}</span>
                  </button>
                </div>
                {% endfor %}
              </div>
            </div>
            {% if property.floor_plans.size > 1 %}
            <button type="button" class="vp-plantas__prev absolute left-0 top-[38%] z-10 -translate-y-1/2 text-[24px] text-black disabled:opacity-30" aria-label="Planta anterior"><i class="ph ph-caret-left"></i></button>
            <button type="button" class="vp-plantas__next absolute right-0 top-[38%] z-10 -translate-y-1/2 text-[24px] text-black disabled:opacity-30" aria-label="Próxima planta"><i class="ph ph-caret-right"></i></button>
            {% endif %}
          </div>
        </section>
        {% endif %}

        <!-- Localização -->
        {% if _has_map and theme_settings.sections['single:property'].show_map != false %}
        <section id="mapSection" class="scroll-mt-5 border-b border-[#DDDDDD] pt-[40px] md:pt-[60px] pb-[15px]">
          <h2 class="vp-prop-title">{% if map_display == 'exact' %}Localização{% else %}Localização aproximada{% endif %}</h2>
          <div
            id="mapWrapper"
            class="relative h-[488px] md:h-[438px] overflow-hidden bg-[#F2F2F2]"
            data-lat="{{ property.latitude }}"
            data-lng="{{ property.longitude }}"
            data-display="{{ map_display }}"
          >
            <div id="mapPlaceholder" class="flex h-full w-full items-start justify-center">
              <img src="{{ theme.assets_url }}/assets/images/mapa.png" alt="" class="absolute inset-0 h-full w-full object-cover" aria-hidden="true">
              <div class="relative mx-4 mt-5 max-w-[300px] rounded-[8px] bg-white px-6 py-5 text-center shadow-[0_2px_12px_0_rgb(0_0_0/0.06)]">
                <p class="text-[14px] leading-[22px] text-[#333]">Clique no botão abaixo para navegar pelo mapa de localização</p>
                <button type="button" onclick="window.initPropertyMap()" class="mt-4 inline-flex items-center rounded-[4px] bg-[#181A20] px-5 py-2 text-[14px] font-medium text-white transition-colors hover:bg-[#373630]">Navegar pelo mapa</button>
              </div>
            </div>
          </div>
        </section>
        {% endif %}
      </div>

      <!-- Card "Gostou deste imóvel?": sticky na lateral (desktop); no mobile vem depois do mapa -->
      <aside class="relative z-10 mt-[40px] lg:col-start-2 lg:row-span-3 lg:row-start-1 lg:-mt-[40px]">
        <div class="lg:sticky lg:top-[60px]">
          <div class="vp-prop-lead overflow-hidden rounded-[4px] bg-[#F8F8F8] shadow-[0_3px_10px_1px_rgb(0_0_0/0.1)] lg:bg-white lg:shadow-none lg:border lg:border-[#666158]">
            <div class="bg-[#F8F8F8] p-5">
              <h2 class="font-serif text-[25px] leading-[30px] font-medium lg:text-[20px] lg:leading-[24px] lg:font-bold text-[#373630]">Gostou deste imóvel?</h2>
              <p class="mt-[5px] text-[15px] leading-[17px] text-[#666158]">Fale com um de nossos corretores.</p>

              {% form 'property_interest' %}
                {% if form.posted_successfully %}
                  <p class="mt-4 rounded-[4px] border border-green-200 bg-green-50 p-3 text-[14px] text-green-800">{{ form.success }}</p>
                {% endif %}
                {% if form.errors %}
                  <p class="mt-4 rounded-[4px] border border-red-200 bg-red-50 p-3 text-[14px] text-red-800">{{ form.errors | first }}</p>
                {% endif %}
                <input type="hidden" name="property_interest[property_id]" value="{{ property.id }}">
                <input type="hidden" name="property_interest[property_sku]" value="{{ property.sku }}">
                <input type="hidden" name="property_interest[property_type]" value="{{ property.type }}">
                <input type="hidden" name="property_interest[contact_type]" value="email">
                <div class="mt-5 space-y-[10px]">
                  <input type="text" name="property_interest[name]" required placeholder="Nome" aria-label="Nome" class="vp-prop-lead__input">
                  <input type="email" name="property_interest[email]" required placeholder="E-mail" aria-label="E-mail" class="vp-prop-lead__input">
                  {% include 'components/global/form/phone-input', name: 'property_interest[phone]', placeholder: 'Telefone', input_class: 'vp-prop-lead__input' %}
                  <select name="property_interest[contact_method]" required aria-label="Forma de contato" class="vp-prop-lead__input cursor-pointer">
                    <option value="">Selecione uma forma de contato</option>
                    <option value="Whatsapp">Whatsapp</option>
                    <option value="E-mail">E-mail</option>
                    <option value="Telefone">Telefone</option>
                  </select>

                  {% if workspace.settings.turnstile.enabled %}
                    <div class="cf-turnstile" data-sitekey="{{ workspace.settings.turnstile.site_key }}"></div>
                  {% endif %}

                  <button type="submit" class="h-[40px] w-full rounded-[4px] bg-[#181A20] px-6 text-[14px] text-white shadow-[1px_1px_10px_1px_rgb(0_0_0/0.03)] transition-colors hover:bg-[#373630]">Entrar em contato</button>
                </div>
              {% endform %}
            </div>

            {%- if theme_settings.sections['single:property'].show_share_buttons != false %}
            <div class="hidden lg:flex items-center justify-center gap-[13px] bg-white py-[14px]" x-data="{ copied: false }">
              {% render 'components/property-share', title: _title %}
            </div>
            {%- endif %}
          </div>
        </div>
      </aside>

      <!-- Imóveis similares -->
      <div class="lg:col-start-1 lg:row-start-3">
        {% if related.size > 0 %}
        <section class="pt-[45px] pb-[80px]">
          <h2 class="vp-prop-title">Imóveis similares</h2>
          <div class="pb-card-grid grid grid-cols-1 gap-[30px] md:grid-cols-2">
            {% for property in related limit: 4 %}
              {% include 'components/property-card' %}
            {% endfor %}
          </div>
        </section>
        {% else %}
        <div class="pb-[80px]"></div>
        {% endif %}
      </div>
    </div>
  </div>
</article>

<!-- Plantas Modal -->
{% if property.floor_plans and property.floor_plans.size > 0 %}
<div id="plantasModal" class="fixed inset-0 z-50 hidden" aria-hidden="true">
  <div class="absolute inset-0 bg-black/95" onclick="closePlantasModal()"></div>
  <div class="absolute top-0 left-0 right-0 z-10 flex items-center justify-between px-4 py-3 bg-gradient-to-b from-black/50 to-transparent">
    <div class="flex items-center gap-3 min-w-0">
      <span class="text-white text-sm font-medium shrink-0"><span id="plantasCounter">1</span> / {{ property.floor_plans.size }}</span>
      <span id="plantasTitle" class="text-white/70 text-sm truncate"></span>
    </div>
    <button onclick="closePlantasModal()" class="w-10 h-10 flex items-center justify-center text-white hover:bg-white/10 rounded-full transition-colors shrink-0">
      <i class="ph ph-x text-2xl"></i>
    </button>
  </div>
  <div class="swiper plantasSwiper h-full" style="padding-top:56px;padding-bottom:16px;">
    <div class="swiper-wrapper">
      {% for planta in property.floor_plans %}
      <div class="swiper-slide flex items-center justify-center p-4 md:p-12">
        <img
          src="{{ planta.url | default: planta | img_resize: 0, 1200 }}"
          alt="Planta {{ forloop.index }}"
          class="max-w-full max-h-full object-contain"
          loading="lazy"
        >
      </div>
      {% endfor %}
    </div>
    <div class="swiper-button-prev !text-white !w-12 !h-12 !bg-black/30 !rounded-full after:!text-xl" id="plantasPrev"></div>
    <div class="swiper-button-next !text-white !w-12 !h-12 !bg-black/30 !rounded-full after:!text-xl" id="plantasNext"></div>
  </div>
</div>
{% endif %}

<!-- Gallery Modal (Swiper-based, free alternative to LightGallery) -->
<div id="galleryModal" class="fixed inset-0 z-50 hidden" aria-hidden="true">
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-black/95" onclick="closeGalleryModal()"></div>

  <!-- Header -->
  <div class="absolute top-0 left-0 right-0 z-10 flex items-center justify-between px-4 py-3 bg-gradient-to-b from-black/50 to-transparent">
    <span class="text-white text-sm font-medium">
      <span id="galleryCounter">1</span> / {{ property.images.size }}
    </span>
    <button onclick="closeGalleryModal()" class="w-10 h-10 flex items-center justify-center text-white hover:bg-white/10 rounded-full transition-colors">
      <i class="ph ph-x text-2xl"></i>
    </button>
  </div>

  <!-- Main Swiper -->
  <div class="swiper gallerySwiper h-full">
    <div class="swiper-wrapper">
      {% for image in property.images %}
      <div class="swiper-slide flex items-center justify-center p-4 md:p-12 relative">
        <!-- Loading spinner -->
        <div class="gallery-img-loader absolute inset-0 flex items-center justify-center">
          <div class="w-10 h-10 border-4 border-white/20 border-t-white rounded-full animate-spin"></div>
        </div>
        <img
          src="{{ image.url | default: image | img_resize: 0, 1200 }}"
          alt="{{ property.title }}"
          class="max-w-full max-h-full object-contain opacity-0 transition-opacity duration-300 mx-auto my-auto"
          loading="lazy"
          onload="this.classList.remove('opacity-0'); this.classList.add('opacity-100'); var loader = this.previousElementSibling; if (loader) loader.style.display = 'none';"
        >
      </div>
      {% endfor %}
    </div>
    <!-- Navigation -->
    <div class="swiper-button-prev !text-white !w-12 !h-12 !bg-black/30 !rounded-full after:!text-xl"></div>
    <div class="swiper-button-next !text-white !w-12 !h-12 !bg-black/30 !rounded-full after:!text-xl"></div>
  </div>

  <!-- Thumbnails -->
  <div class="absolute bottom-0 left-0 right-0 z-10 bg-gradient-to-t from-black/70 to-transparent py-4">
    <div class="swiper galleryThumbs w-full px-4">
      <div class="swiper-wrapper">
        {% for image in property.images %}
        <div class="swiper-slide !w-16 !h-12 cursor-pointer">
          <img
            src="{{ image.url | default: image | img_resize: 150, 150, true }}"
            alt="{{ property.title }}"
            class="w-full h-full object-cover rounded-lg"
            loading="lazy"
          >
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
{% endblock %}
{% block head_assets %}

{%- comment -%} ======= JSON-LD: RealEstateListing + BreadcrumbList ======= {%- endcomment -%}
{%- assign _url_parts = canonical_url | split: '/' -%}
{%- assign _site_url = _url_parts[0] | append: '//' | append: _url_parts[2] -%}
{%- comment -%} Map pt-BR main_type to the closest schema.org subtype {%- endcomment -%}
{%- assign _mt = property.main_type | default: '' | downcase -%}
{%- assign _residence_type = 'Residence' -%}
{%- if _mt contains 'apartamento' or _mt contains 'cobertura' or _mt contains 'flat' or _mt contains 'studio' or _mt contains 'kitnet' or _mt contains 'loft' -%}
  {%- assign _residence_type = 'Apartment' -%}
{%- elsif _mt contains 'casa' or _mt contains 'sobrado' -%}
  {%- assign _residence_type = 'House' -%}
{%- elsif _mt contains 'lançamento' or _mt contains 'lancamento' or _mt contains 'empreendimento' or _mt contains 'condominio' or _mt contains 'condomínio' -%}
  {%- assign _residence_type = 'ApartmentComplex' -%}
{%- endif -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "RealEstateListing",
      "@id": "{{ canonical_url }}/#listing",
      "name": {{ property.title | json }},
      "url": "{{ canonical_url }}",
      "datePosted": "{{ property.created_at }}"
      {%- if property.updated_at %},
      "dateModified": "{{ property.updated_at }}"
      {%- endif -%}
      {%- if property.description != blank %},
      "description": {{ property.description | strip_html | strip_newlines | strip | truncate: 500 | json }}
      {%- endif -%}
      {%- if property.images and property.images.size > 0 %},
      "image": [
        {%- for img in property.images -%}
        "{{ img.url | default: img }}"{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
      {%- endif %},
      "about": {
        "@type": "{{ _residence_type }}",
        "name": {{ property.title | json }}
        {%- if property.total_area and property.total_area > 0 %},
        "floorSize": {
          "@type": "QuantitativeValue",
          "value": {{ property.total_area }},
          "unitCode": "MTK"
        }
        {%- endif -%}
        {%- if property.beds and property.beds > 0 %},
        "numberOfBedrooms": {{ property.beds }}
        {%- endif -%}
        {%- if property.bathrooms and property.bathrooms > 0 %},
        "numberOfBathroomsTotal": {{ property.bathrooms }}
        {%- endif -%}
        {%- if property.year_built %},
        "yearBuilt": {{ property.year_built }}
        {%- endif -%}
        {%- if property.parkings and property.parkings > 0 %},
        "numberOfParkingSpaces": {{ property.parkings }}
        {%- endif -%}
        {%- if property.address != blank or property.neighborhood != blank or property.city != blank %},
        "address": {
          "@type": "PostalAddress"
          {%- if property.address != blank %},
          "streetAddress": {{ property.address | json }}
          {%- endif -%}
          {%- if property.neighborhood != blank %},
          "addressLocality": {{ property.neighborhood | json }}
          {%- endif -%}
          {%- if property.city != blank %},
          "addressRegion": {% if property.state %}{{ property.city | append: ' - ' | append: property.state | json }}{% else %}{{ property.city | json }}{% endif %}
          {%- endif %},
          "addressCountry": "BR"
          {%- if property.zipcode != blank %},
          "postalCode": "{{ property.zipcode }}"
          {%- endif %}
        }
        {%- endif -%}
        {%- if property.latitude and property.longitude %},
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": {{ property.latitude }},
          "longitude": {{ property.longitude }}
        }
        {%- endif -%}
        {%- if property.amenities and property.amenities.size > 0 %},
        "amenityFeature": [
          {%- for amenity in property.amenities -%}
          {
            "@type": "LocationFeatureSpecification",
            "name": {{ amenity | json }},
            "value": true
          }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
        {%- endif %}
      }
      {%- assign _has_offer = false -%}
      {%- if property.for_sale and property.sale_price and property.sale_price > 0 -%}{%- assign _has_offer = true -%}{%- endif -%}
      {%- if property.for_rent and property.rental_price and property.rental_price > 0 -%}{%- assign _has_offer = true -%}{%- endif -%}
      {%- if _has_offer %},
      "offers": [
        {%- assign _offer_sep = '' -%}
        {%- if property.for_sale and property.sale_price and property.sale_price > 0 -%}
        {{ _offer_sep }}{
          "@type": "Offer",
          "price": {{ property.sale_price }},
          "priceCurrency": "{{ property.currency | default: 'BRL' }}",
          "availability": "https://schema.org/InStock",
          "businessFunction": "http://purl.org/goodrelations/v1#Sell",
          "url": "{{ canonical_url }}"
        }
        {%- assign _offer_sep = ',' -%}
        {%- endif -%}
        {%- if property.for_rent and property.rental_price and property.rental_price > 0 -%}
        {{ _offer_sep }}{
          "@type": "Offer",
          "price": {{ property.rental_price }},
          "priceCurrency": "{{ property.currency | default: 'BRL' }}",
          "businessFunction": "http://purl.org/goodrelations/v1#LeaseOut",
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "price": {{ property.rental_price }},
            "priceCurrency": "{{ property.currency | default: 'BRL' }}",
            "unitText": "MONTH"
          },
          "url": "{{ canonical_url }}"
        }
        {%- endif -%}
      ]
      {%- endif %},
      "provider": { "@id": "{{ _site_url }}/#organization" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ t.common.home | default: 'Início' | json }},
          "item": "{{ _site_url }}{{ locale_prefix }}/"
        }
        {%- assign _bc_pos = 2 -%}
        {%- if property.for_sale %},
        {
          "@type": "ListItem",
          "position": {{ _bc_pos }},
          "name": {{ t.common.sale | default: 'Venda' | json }},
          "item": "{{ _site_url }}{{ locale_prefix }}{{ routes.properties }}{{ routes.operation_sale }}"
        }
        {%- assign _bc_pos = _bc_pos | plus: 1 -%}
        {%- elsif property.for_rent %},
        {
          "@type": "ListItem",
          "position": {{ _bc_pos }},
          "name": {{ t.common.rent | default: 'Aluguel' | json }},
          "item": "{{ _site_url }}{{ locale_prefix }}{{ routes.properties }}{{ routes.operation_rent }}"
        }
        {%- assign _bc_pos = _bc_pos | plus: 1 -%}
        {%- endif -%},
        {
          "@type": "ListItem",
          "position": {{ _bc_pos }},
          "name": {{ property.title | json }},
          "item": "{{ canonical_url }}"
        }
      ]
    }
  ]
}
</script>

<style>
  #galleryModal {
    user-select: none;
    -webkit-user-select: none;
  }
  #galleryModal .gallerySwiper {
    padding-top: 56px;
    padding-bottom: 88px;
  }
  #galleryModal .gallerySwiper .swiper-slide {
    top: 56px !important;
    width: 100% !important;
    height: calc(100vh - 144px) !important;
  }
  #galleryModal .gallerySwiper .swiper-slide img {
    position: absolute !important;
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
    max-height: calc(100vh - 160px);
    max-width: calc(100% - 64px);
    width: auto;
    height: auto;
    object-fit: contain;
    pointer-events: none;
  }
  #galleryModal .galleryThumbs .swiper-slide {
    opacity: 0.4;
    transition: opacity 0.2s;
    overflow: visible;
  }
  #galleryModal .galleryThumbs .swiper-slide img {
    border: 2px solid transparent;
    transition: border-color 0.2s;
  }
  #galleryModal .galleryThumbs .swiper-slide-thumb-active {
    opacity: 1 !important;
  }
  #galleryModal .galleryThumbs .swiper-slide-thumb-active img {
    border-color: white;
  }
</style>
{% endblock %}

{% block body_assets %}

<!-- Galeria principal (3 fotos por vez) e carrossel de plantas -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  if (typeof Swiper === 'undefined') return;
  if (document.querySelector('.vp-prop-gallery__swiper')) {
    // Até 3 fotos por vez; com menos fotos elas dividem a largura (sem espaço vazio)
    var n = {{ property.images.size | default: 0 }};
    new Swiper('.vp-prop-gallery__swiper', {
      slidesPerView: 1,
      spaceBetween: 5,
      loop: n > 3,
      navigation: { prevEl: '.vp-prop-gallery__prev', nextEl: '.vp-prop-gallery__next' },
      breakpoints: { 640: { slidesPerView: Math.min(2, n) }, 1024: { slidesPerView: Math.min(3, n) } }
    });
  }
  if (document.querySelector('.vp-plantas__swiper')) {
    new Swiper('.vp-plantas__swiper', {
      slidesPerView: 1,
      spaceBetween: 30,
      navigation: { prevEl: '.vp-plantas__prev', nextEl: '.vp-plantas__next' },
      breakpoints: { 640: { slidesPerView: 2 }, 1024: { slidesPerView: 3 } }
    });
  }
});
</script>

{% if property.floor_plans and property.floor_plans.size > 0 %}
<script>
(function() {
  var modal = document.getElementById('plantasModal');
  var counter = document.getElementById('plantasCounter');
  var titleEl = document.getElementById('plantasTitle');
  if (!modal) return;
  var swiper = null;

  var titles = [{% for planta in property.floor_plans %}'{{ planta.title | escape }}'{% unless forloop.last %},{% endunless %}{% endfor %}];

  function updateHeader(idx) {
    if (counter) counter.textContent = idx + 1;
    if (titleEl) titleEl.textContent = titles[idx] || '';
  }

  window.openPlantasModal = function(index) {
    modal.classList.remove('hidden');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    var idx = index || 0;
    if (!swiper) {
      requestAnimationFrame(function() {
        swiper = new Swiper('.plantasSwiper', {
          navigation: { nextEl: '#plantasNext', prevEl: '#plantasPrev' },
          keyboard: { enabled: true },
          on: { slideChange: function() { updateHeader(this.activeIndex); } }
        });
        swiper.slideTo(idx, 0);
        updateHeader(idx);
      });
    } else {
      swiper.slideTo(idx, 0);
      updateHeader(idx);
    }
  };

  window.closePlantasModal = function() {
    modal.classList.add('hidden');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  };

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) closePlantasModal();
  });
})();
</script>
{% endif %}

{%- comment -%} GA4: view_item — dispara quando a página de detalhe do imóvel é carregada {%- endcomment -%}
<script>
(function() {
  if (!window.VpAnalytics) return;
  {%- assign _op = '' -%}
  {%- if property.for_sale and property.for_rent -%}{%- assign _op = 'sale,rent' -%}
  {%- elsif property.for_sale -%}{%- assign _op = 'sale' -%}
  {%- elsif property.for_rent -%}{%- assign _op = 'rent' -%}
  {%- elsif property.for_short_term -%}{%- assign _op = 'short_term' -%}
  {%- endif -%}
  {%- assign _price = property.sale_price | default: property.rental_price | default: 0 -%}
  var item = window.VpAnalytics.mapPropertyToItem({
    sku:          '{{ property.sku | escape }}',
    id:           '{{ property.id | escape }}',
    title:        '{{ property.title | escape }}',
    type:         '{{ property.main_type | escape }}',
    operation:    '{{ _op }}',
    neighborhood: '{{ property.neighborhood | escape }}',
    city:         '{{ property.city | escape }}',
    price:        {{ _price }},
  });
  window.VpAnalytics.viewItem(item);
})();
</script>

<!-- WhatsApp: open after form:success -->
<script>
(function() {
  var waPhone = '55{{ theme_settings.contact.whatsapp | remove: '-' | remove: '(' | remove: ')' | remove: ' ' }}';
  var propTitle = '{{ property.title | escape }}';
  var propSku = '{{ property.sku }}';
  if (!waPhone) return;

  function buildWaUrl(name) {
    var text = 'Olá! Meu nome é ' + (name || '') + '. Tenho interesse no imóvel ' + propTitle + ' (' + propSku + ')';
    return 'https://wa.me/' + waPhone + '?text=' + encodeURIComponent(text);
  }

  document.querySelectorAll('form[data-ajax]').forEach(function(form) {
    var contactType = form.querySelector('[name="property_interest[contact_type]"], [name="property_interest[type]"]');
    if (!contactType || contactType.value !== 'whatsapp') return;

    // Capture name before submit (form resets on success)
    var pendingName = '';
    form.addEventListener('submit', function() {
      var nameInput = form.querySelector('[name="property_interest[name]"]');
      pendingName = nameInput ? nameInput.value : '';
    }, true);

    form.addEventListener('form:success', function() {
      window.open(buildWaUrl(pendingName), '_blank');
    });
  });
})();
</script>

{% endblock %}

{% schema %}
{
  "location": "single:property",
  "name": "Página do Imóvel",
  "settings": [
    {
      "type": "select",
      "id": "address_display",
      "label": "Exibição do endereço",
      "default": "hide_number",
      "options": [
        { "value": "full", "label": "Endereço completo (rua + número)" },
        { "value": "hide_number", "label": "Ocultar número" },
        { "value": "hide_address", "label": "Ocultar endereço (mostrar apenas bairro)" },
        { "value": "hide_neighborhood", "label": "Ocultar bairro (mostrar apenas cidade)" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_map",
      "label": "Mostrar mapa",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_share_buttons",
      "label": "Mostrar botões de compartilhamento",
      "default": true
    }
  ]
}
{% endschema %}
