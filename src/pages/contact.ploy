{% layout 'base' %}
{% block content %}

<section class="w-full relative overflow-hidden py-10 md:py-16">
  <!-- Full-width background image -->
  <div class="absolute inset-0">
    <img
      src="{{ theme_settings.sections.contact.image | default: '/assets/images/entre-em-contato.jpg' }}"
      alt="Entre em contato"
      class="h-full w-full object-cover object-center"
    >
  </div>

  <!-- Overlay -->
  <div class="absolute inset-0 bg-black/30"></div>

  <!-- Content -->
  <div class="relative z-10 vp-section">
    <div class="max-w-[1380px] mx-auto px-4 md:px-8">
      <div class="rounded-[12px] bg-white shadow-[0_8px_30px_rgba(0,0,0,0.12)] overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-[1.05fr_0.95fr]">

          <!-- BLOCO CONTATOS -->
          <div class="p-7 md:p-10 lg:border-r border-[#F1F1F1]">
            <h1 class="text-[28px] font-semibold leading-[1.05] tracking-[-0.03em] text-[#111827] md:text-[42px]">
              Fale conosco
            </h1>

            <p class="mt-8 max-w-[290px] text-[15px] leading-[1.7] text-[#6B7280] md:mt-6 md:max-w-[520px] md:text-[18px] md:leading-8">
              Verifique a seguir os nossos canais de atendimento e escolha aquele que melhor te atender, estamos aqui à sua disposição.
            </p>

            {% if theme_settings.contact.whatsapp != blank %}
              <div class="mt-8 rounded-[6px] bg-[#EDF7F1] px-5 py-6 md:mt-8 md:flex md:items-center md:justify-between md:gap-4">
                <div class="text-center md:text-left">
                  <span class="text-[16px] font-semibold text-[#111827]">
                    Prefere falar por whatsapp?
                  </span>
                </div>

                <div class="mt-4 flex justify-center md:mt-0 md:justify-end">
                  <a
                    href="https://wa.me/{{ theme_settings.contact.country_code }}{{ theme_settings.contact.whatsapp | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '+' }}"
                    target="_blank"
                    rel="noopener"
                    class="inline-flex min-h-[40px] items-center justify-center gap-2 rounded-[4px] bg-[#005C4B] px-10 py-2.5 text-[14px] font-semibold text-white transition hover:opacity-90"
                  >
                    <i class="ph ph-whatsapp-logo text-[16px]"></i>
                    <span>Chamar</span>
                  </a>
                </div>
              </div>
            {% endif %}

            <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-8">
              <!-- Visite nosso espaço -->
              <div>
                <h2 class="text-[22px] font-semibold text-[#111827] md:text-[28px]">
                  Visite nosso espaço
                </h2>

                <div class="mt-8 space-y-7 text-[#6B7280]">
                  {% if theme_settings.contact.address != blank %}
                    <div class="flex items-start gap-4">
                      <i class="ph ph-map-pin mt-1 text-[20px] text-primary"></i>
                      <span class="text-[16px] leading-[1.5] md:text-[17px]">
                        {{ theme_settings.contact.address }}
                      </span>
                    </div>
                  {% endif %}

                  {% if theme_settings.contact.hours != blank %}
                    <div class="flex items-start gap-4">
                      <i class="ph ph-clock mt-1 text-[20px] text-primary"></i>
                      <span class="text-[16px] leading-[1.5] md:text-[17px]">
                        {{ theme_settings.contact.hours }}
                      </span>
                    </div>
                  {% endif %}
                </div>
              </div>

              <!-- Fale conosco -->
              <div class="md:border-l border-[#E5E7EB] md:pl-8">
                <h2 class="text-[22px] font-semibold text-[#111827] md:text-[28px]">
                  Fale conosco
                </h2>

                <div class="mt-8 space-y-5 text-[#6B7280]">
                  {% if theme_settings.contact.whatsapp != blank %}
                    <a
                      href="https://wa.me/{{ theme_settings.contact.country_code }}{{ theme_settings.contact.whatsapp | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '+' }}"
                      target="_blank"
                      rel="noopener"
                      class="flex items-center gap-3 transition hover:text-primary"
                    >
                      <i class="ph ph-whatsapp-logo text-[18px] text-primary"></i>
                      <span class="text-[16px] md:text-[17px]">{{ theme_settings.contact.whatsapp }}</span>
                    </a>
                  {% endif %}

                  {% if theme_settings.contact.email != blank %}
                    <a
                      href="mailto:{{ theme_settings.contact.email }}"
                      class="flex items-center gap-3 transition hover:text-primary"
                    >
                      <i class="ph ph-envelope text-[18px] text-primary"></i>
                      <span class="text-[16px] md:text-[17px]">{{ theme_settings.contact.email }}</span>
                    </a>
                  {% endif %}
                </div>

                {% if theme_settings.contact.facebook != blank
                  or theme_settings.contact.instagram != blank
                  or theme_settings.contact.youtube != blank
                %}
                  <div class="mt-6 flex items-center gap-3">
                    {% if theme_settings.contact.facebook != blank %}
                      <a
                        href="{{ theme_settings.contact.facebook }}"
                        target="_blank"
                        rel="noopener"
                        class="flex h-9 w-9 items-center justify-center rounded-[4px] bg-[#FFF1F4] text-primary transition hover:bg-primary hover:text-white"
                      >
                        <i class="ph ph-facebook-logo text-[18px]"></i>
                      </a>
                    {% endif %}

                    {% if theme_settings.contact.instagram != blank %}
                      <a
                        href="{{ theme_settings.contact.instagram }}"
                        target="_blank"
                        rel="noopener"
                        class="flex h-9 w-9 items-center justify-center rounded-[4px] bg-[#FFF1F4] text-primary transition hover:bg-primary hover:text-white"
                      >
                        <i class="ph ph-instagram-logo text-[18px]"></i>
                      </a>
                    {% endif %}

                    {% if theme_settings.contact.youtube != blank %}
                      <a
                        href="{{ theme_settings.contact.youtube }}"
                        target="_blank"
                        rel="noopener"
                        class="flex h-9 w-9 items-center justify-center rounded-[4px] bg-[#FFF1F4] text-primary transition hover:bg-primary hover:text-white"
                      >
                        <i class="ph ph-youtube-logo text-[18px]"></i>
                      </a>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </div>
          </div>

          <!-- BLOCO FORM -->
          <div class="p-7 md:p-10 border-t lg:border-t-0 border-[#F1F1F1]">
            <h2 class="max-w-[260px] text-[30px] font-semibold leading-[1.15] tracking-[-0.03em] text-[#111827] md:max-w-none md:text-[42px]">
              Nos envie uma mensagem
            </h2>

            <p class="mt-6 max-w-[280px] text-[15px] leading-[1.7] text-[#6B7280] md:mt-3 md:max-w-[420px] md:text-[17px]">
              Verifique a seguir os nossos canais de atendimento.
            </p>

            {% form 'contact', name: 'Contato' %}
              <div class="mt-8 space-y-7">
                {% if form.posted_successfully %}
                  <div class="rounded-lg border border-green-200 bg-green-50 p-4">
                    <p class="font-medium text-green-800">{{ form.success }}</p>
                  </div>
                {% endif %}

                {% if form.errors %}
                  <div class="rounded-lg border border-red-200 bg-red-50 p-4">
                    <p class="font-medium text-red-800">{{ form.errors | first }}</p>
                  </div>
                {% endif %}

                <div>
                  <input
                    type="text"
                    name="contact[name]"
                    required
                    placeholder="Nome Completo"
                    class="h-[50px] w-full rounded-none border border-[#F1F1F1] bg-[#FAFAFA] px-4 text-[16px] text-gray-800 placeholder:text-[#64748B] outline-none focus:border-primary focus:ring-2 focus:ring-primary/20"
                  >
                </div>

                <div class="grid grid-cols-2 gap-4">
                  <input
                    type="email"
                    name="contact[email]"
                    required
                    placeholder="E-mail"
                    class="h-[50px] w-full rounded-none border border-[#F1F1F1] bg-[#FAFAFA] px-4 text-[16px] text-gray-800 placeholder:text-[#64748B] outline-none focus:border-primary focus:ring-2 focus:ring-primary/20"
                  >
                  {% include 'components/global/form/phone-input',
                    name: 'contact[phone]',
                    placeholder: 'Telefone com DDD',
                    input_class: 'h-[50px] w-full rounded-none border border-[#F1F1F1] bg-[#FAFAFA] px-4 text-[16px] text-gray-800 placeholder:text-[#64748B] outline-none focus:border-primary focus:ring-2 focus:ring-primary/20'
                  %}
                </div>

                <div>
                  <textarea
                    name="contact[message]"
                    rows="4"
                    required
                    placeholder="Escreva aqui sua mensagem."
                    class="w-full resize-none rounded-none border border-[#F1F1F1] bg-[#FAFAFA] px-4 py-4 text-[16px] text-gray-800 placeholder:text-[#64748B] outline-none focus:border-primary focus:ring-2 focus:ring-primary/20"
                  ></textarea>
                </div>

                <div class="pt-2">
                  <button
                    type="submit"
                    class="h-12 w-full rounded-[4px] bg-[#111827] font-semibold text-white transition hover:opacity-90"
                  >
                    Envie sua mensagem
                  </button>
                </div>
              </div>
            {% endform %}
          </div>

        </div>
      </div>
    </div>
  </div>

  {% if workspace.settings.turnstile.enabled %}
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  {% endif %}
</section>

{%- comment -%} ======= JSON-LD: ContactPage ======= {%- endcomment -%}
{%- assign _url_parts = canonical_url | split: '/' -%}
{%- assign _site_url = _url_parts[0] | append: '//' | append: _url_parts[2] -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": "{{ canonical_url }}/#page",
  "url": "{{ canonical_url }}",
  "name": {{ title | default: 'Contato' | json }},
  "isPartOf": { "@id": "{{ _site_url }}/#website" },
  "mainEntity": { "@id": "{{ _site_url }}/#organization" }
}
</script>
{% endblock %}
